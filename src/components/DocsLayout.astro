---
/**
 * DocsLayout.astro — 所有 /docs/ 页面的唯一外壳。
 *
 * 侧栏与顺序全部来自内容集合（src/content/docs），这里不再手写导航：
 *   section 决定分组，order 决定组内顺序，title 决定显示名。
 * 新增文档＝新增一个 .md/.mdx 文件，无需改本组件。
 */
import { getCollection } from "astro:content";
import Navbar from "./Navbar.astro";
import SiteShared from "./SiteShared.astro";

interface Props {
  lang: "zh" | "en";
  active?: string;
  title: string;
}
const { lang, active = "docs", title } = Astro.props;
const zh = lang === "zh";
const base = `/${lang}`;

const SECTION_ORDER = ["start", "guide", "apps", "developer", "reference"] as const;
const SECTION_TITLES = {
  start: { zh: "开始", en: "Getting Started" },
  guide: { zh: "用户指南", en: "User Guide" },
  apps: { zh: "应用与硬件", en: "Apps & Hardware" },
  developer: { zh: "开发者", en: "Developer" },
  reference: { zh: "参考", en: "Reference" },
} as const;

/** 不在内容集合里、但要出现在侧栏的条目。 */
const EXTERNAL_ITEMS: Record<string, { slug: string; href: string; label: string }[]> = {
  reference: [{ slug: "license", href: `${base}/legal/license/`, label: zh ? "开源协议" : "License" }],
};

const entries = await getCollection("docs");
const mine = entries.filter((entry) => entry.id === lang || entry.id.startsWith(`${lang}/`));
const slugOf = (id: string) =>
  id === lang
    ? ""
    : id
        .slice(lang.length + 1)
        .replace(/\.(md|mdx)$/i, "")
        .replace(/(^|\/)index$/, "");

const nav = SECTION_ORDER.map((section) => {
  const items = mine
    .filter((entry) => entry.data.section === section)
    .sort((a, b) => a.data.order - b.data.order)
    .map((entry) => {
      const slug = slugOf(entry.id);
      return { slug, href: `${base}/docs/${slug ? `${slug}/` : ""}`, label: entry.data.title };
    })
    .concat(EXTERNAL_ITEMS[section] ?? []);
  return { section, title: SECTION_TITLES[section][zh ? "zh" : "en"], items };
}).filter((group) => group.items.length > 0);

const activeSlug = Astro.url.pathname
  .replace(new RegExp(`^/${lang}/docs/?`), "")
  .replace(/\/$/, "");

const footer = zh
  ? "Linxira OS 直接基于 Arch Linux 构建，是与 Arch Linux 无隶属关系且未经其官方认可的独立项目。"
  : "Linxira OS is built directly on Arch Linux; an independent project with no affiliation to or endorsement by Arch Linux.";
const footLinks = zh
  ? [["/zh/releases/", "发布日志"], ["/zh/security/", "安全中心"], ["/zh/gallery/", "亮点画廊"]]
  : [["/en/releases/", "Release Log"], ["/en/security/", "Security"], ["/en/gallery/", "Gallery"]];
---
<!DOCTYPE html>
<html lang={zh ? "zh-CN" : "en-US"}>
<head>
  <SiteShared title={title} />
  <style is:global>
    .layout { display: flex; padding-top: 60px; min-height: 100vh; }
    .sidebar {
      width: 260px; background: #0c1322; border-right: 1px solid var(--line);
      padding: 2rem 0; position: fixed; top: 60px; bottom: 0; overflow-y: auto;
      /* 细滚动条，颜色跟随品牌青色；Firefox 用标准属性，Chromium/WebKit 走伪元素 */
      scrollbar-width: thin; scrollbar-color: rgba(32,184,176,0.35) transparent;
      overscroll-behavior: contain;
    }
    .sidebar::-webkit-scrollbar { width: 10px; }
    .sidebar::-webkit-scrollbar-track { background: transparent; }
    .sidebar::-webkit-scrollbar-thumb {
      background: rgba(32,184,176,0.25); border-radius: 8px;
      border: 3px solid transparent; background-clip: content-box;
    }
    .sidebar:hover::-webkit-scrollbar-thumb {
      background: rgba(32,184,176,0.5); background-clip: content-box;
    }
    .sidebar::-webkit-scrollbar-thumb:hover { background: rgba(32,184,176,0.7); background-clip: content-box; }
    .sidebar-title { color: var(--faint); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; padding: 0 1.5rem; margin-bottom: 0.5rem; }
    .sidebar a { display: block; padding: 0.5rem 1.5rem; color: var(--muted); text-decoration: none; font-size: 0.9rem; transition: all 0.2s; border-left: 3px solid transparent; }
    .sidebar a:hover { color: var(--teal); background: rgba(32,184,176,0.05); }
    .sidebar a.active { color: var(--teal); border-left-color: var(--teal); background: rgba(32,184,176,0.08); }
    .sidebar .section { margin-bottom: 1.5rem; }
    .main { flex: 1; margin-left: 260px; padding: 3rem 4rem; max-width: 900px; }
    .doc-card { display: block; background: linear-gradient(135deg, rgba(30,41,59,0.6), rgba(14,20,23,0.8)); border: 1px solid rgba(51,65,85,0.5); border-radius: 12px; padding: 1.5rem; margin: 1rem 0; text-decoration: none; transition: border-color 0.3s; }
    .doc-card:hover { border-color: rgba(32,184,176,0.4); }
    .doc-card h3 { color: var(--teal); margin-bottom: 0.3rem; font-size: 1.1rem; }
    .doc-card p { font-size: 0.9rem; margin: 0; color: var(--muted); }
    .keyword { display: inline-block; font-size: 0.7rem; background: rgba(32,184,176,0.15); color: var(--teal); padding: 0.15rem 0.5rem; border-radius: 4px; margin: 0.2rem; }
    /* ---- 文档正文的共享排版（原先每个页面各写一份 <style>，现统一在这里） ---- */
    .main h2 { margin-top: 2.5rem; color: #e5e7eb; border-top: 1px solid #263238; padding-top: 1.2rem; }
    .main h3 { font-size: 1.05rem; color: #cbd5e1; margin: 1.4rem 0 0.5rem; }
    .main li { color: #aab7bd; }
    .main ul, .main ol { color: #94a3b8; margin: 0.5rem 0 1rem 1.5rem; }
    .main pre { background: #111827; border: 1px solid rgba(51,65,85,0.4); border-left: 3px solid #20B8B0; border-radius: 6px; padding: 1rem 1.2rem; overflow-x: auto; margin: 1rem 0 1.5rem; }
    .main pre code { background: none; padding: 0; color: #e5e7eb; font-size: 0.85rem; line-height: 1.6; }
    .main table { width: 100%; border-collapse: collapse; margin: 1rem 0 1.5rem; font-size: 0.85rem; }
    .main th, .main td { border: 1px solid rgba(51,65,85,0.4); padding: 0.5rem 0.75rem; text-align: left; vertical-align: top; }
    .main th { background: rgba(30,41,59,0.6); color: #e2e8f0; font-weight: 600; }
    .main td { color: #cbd5e1; }
    .main td code { white-space: nowrap; font-size: 0.82rem; }
    .main th code { font-size: 0.82rem; }
    .notice { border-left: 3px solid #F36F5D; background: #172125; padding: 1rem 1.2rem; }
    .note { background: rgba(32,184,176,0.08); border-left: 3px solid #20B8B0; border-radius: 6px; padding: 0.75rem 1rem; margin: 1rem 0 1.5rem; color: #cbd5e1; }
    .note p { color: #cbd5e1; margin: 0; }
    .warn { background: rgba(245,158,11,0.08); border-left: 3px solid #f59e0b; border-radius: 6px; padding: 0.75rem 1rem; margin: 1rem 0 1.5rem; color: #cbd5e1; }
    .app-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; margin: 1.5rem 0 2.5rem; }
    .app-card { background: linear-gradient(135deg, rgba(30,41,59,0.6), rgba(14,20,23,0.8)); border: 1px solid rgba(51,65,85,0.5); border-radius: 12px; padding: 1.3rem 1.4rem; transition: border-color 0.3s, transform 0.2s; }
    .app-card:hover { border-color: rgba(32,184,176,0.4); transform: translateY(-2px); }
    .app-card h3 { color: #20B8B0; font-size: 1.05rem; margin-bottom: 0.3rem; }
    .app-card .pkg { color: #64748b; font-size: 0.75rem; font-family: monospace; margin-bottom: 0.5rem; }
    .app-card p { font-size: 0.88rem; color: #94a3b8; margin-bottom: 0.6rem; }
    .app-card .tag { display: inline-block; font-size: 0.7rem; background: rgba(32,184,176,0.15); color: #20B8B0; padding: 0.1rem 0.5rem; border-radius: 4px; margin: 0.15rem 0.2rem 0 0; }
    .app-card .tag.rec { background: rgba(243,111,93,0.2); color: #F36F5D; }
    .app-card .tag.prop { background: rgba(243,111,93,0.12); color: #fca5a5; }
    .app-card .cli { display: block; font-size: 0.75rem; color: #67e8f9; background: #111827; border-left: 2px solid #20B8B0; padding: 0.3rem 0.6rem; margin-top: 0.5rem; border-radius: 3px; }
    .answer { color: #94a3b8; margin-bottom: 1.5rem; padding-left: 1.4rem; border-left: 2px solid rgba(32,184,176,0.3); }
    .term-item { margin: 0.9rem 0; color: #94a3b8; line-height: 1.7; }
    .term-item strong { color: #20B8B0; font-weight: 600; }
    .term-note { color: #94a3b8; font-size: 0.9rem; }
    .keylist { width: 100%; border-collapse: collapse; margin: 1rem 0 1.5rem; }
    .keylist th, .keylist td { text-align: left; padding: 0.55rem 0.9rem; border-bottom: 1px solid rgba(51,65,85,0.5); vertical-align: top; }
    .keylist th { color: #20B8B0; font-weight: 600; font-size: 0.85rem; white-space: nowrap; }
    .keylist td { color: #cbd5e1; line-height: 1.6; }
    .keylist code { color: #e5e7eb; }
    .step { display: flex; gap: 1rem; margin: 1.5rem 0; }
    .step-num { flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #20B8B0, #F36F5D); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; }
    .step-body { flex: 1; }
    .step-body p:last-child { margin-bottom: 0; }
    footer { text-align: center; padding: 3rem 2rem; color: #475569; font-size: 0.85rem; border-top: 1px solid var(--line); margin-left: 260px; }
    @media (max-width: 768px) { .sidebar { display: none; } .main { margin-left: 0; padding: 2rem; } footer { margin-left: 0; } }
  </style>
</head>
<body>
  <Navbar lang={lang} active={active} />
  <div class="layout">
    <aside class="sidebar">
      {nav.map((group) => (
        <div class="section">
          <div class="sidebar-title">{group.title}</div>
          {group.items.map((item) => (
            <a href={item.href} class:list={[{ active: item.slug === activeSlug }]}>{item.label}</a>
          ))}
        </div>
      ))}
    </aside>
    <main class="main">
      <slot />
    </main>
  </div>
  <footer>
    <div style="margin-bottom:0.8rem; display:flex; gap:1.2rem; justify-content:center; flex-wrap:wrap;">
      {footLinks.map(([href, label]) => (
        <a href={href} style="color:#20B8B0; text-decoration:none; font-size:0.85rem;">{label}</a>
      ))}
    </div>
    <p>{footer}</p>
  </footer>
</body>
</html>
