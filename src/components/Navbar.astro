---
/**
 * ============================================================
 *  Navbar.astro — 全站统一导航栏（banner）
 * ------------------------------------------------------------
 *  维护说明（给后续维护者 / agent）：
 *  1. 这是官网唯一的导航来源。新增页面、【不要】再在单页里复制粘贴
 *     <nav> 代码，改为引入本组件并传 lang / active。
 *  2. 新增/修改顶部导航项：改下面的 navItems，不要改模板。
 *  3. 新增/修改自建产品下拉项（Zeta / Bio SDK）：
 *     改 products 数组。href 指向该产品的落地页（保持现有跳转目标，
 *     不要改动产品子页面的标准跳转逻辑）。
 *  4. 支持的下拉菜单：把产品的 href 指向 /zeta/ 、/bio-sdk/ 这类
 *     由 index 页做语言重定向的标准入口，保证中英文都能正确落地。
 *  5. 顶部导航活动态由调用方传入 active（见各页面用法）。
 * ============================================================
 */

interface Props {
	/** 语言：zh 或 en */
	lang: "zh" | "en";
	/**
	 * 当前高亮的导航项 key。
	 * 可选值：home | docs | ecosystem | products | brand | roadmap | blog
	 * 传 "home" 表示首页（无高亮项）。
	 */
	active?: string;
	/**
	 * 是否显示深浅主题切换按钮（宣传页传 true；文档页保持深色不显示）。
	 * 按钮与语言切换并排，图标式（太阳/月亮）。
	 */
	themeToggle?: boolean;
	/**
	 * logo 是否链回主站（产品子站传 false 关掉"返回主站"入口）。
	 */
	logoLink?: boolean;
}

const { lang, active, themeToggle = false, logoLink = true } = Astro.props;
const zh = lang === "zh";

const base = `/${lang}`;

/* ---------- 语言切换：保留当前页面路径，仅替换语言段 ----------
 *   兼容两种路径形态：
 *     主站：/zh/...      →  EN 按钮 → /en/...
 *     产品：/zeta/zh/... →  EN 按钮 → /zeta/en/...
 *           /bio-sdk/zh/... → EN 按钮 → /bio-sdk/en/...
 *   这样中英文切换不会丢页面，修正原导航「跳回首页」的跳转问题。
 */
const otherLang = zh ? "en" : "zh";
// `zeta/v1` is the archived site and keeps its own language switch.
const langPathMatch = Astro.url.pathname.match(/^\/{0,}((?:zeta(?:\/v1)?|bio-sdk)\/)?(?:zh|en)(\/|$)/);
const langHref = langPathMatch
  ? `/${langPathMatch[1] ?? ""}${otherLang}${langPathMatch[2]}` + Astro.url.pathname.slice(langPathMatch[0].length)
  : Astro.url.pathname;

/* ---------- 文案（中英） ---------- */
const copy = {
	docs: zh ? "文档" : "Docs",
	wiki: zh ? "手册" : "Wiki",
	ecosystem: zh ? "软件生态" : "Ecosystem",
	products: zh ? "产品" : "Products",
	brand: zh ? "品牌资产" : "Brand",
	roadmap: zh ? "路线图" : "Roadmap",
	blog: zh ? "博客" : "Blog",
	download: zh ? "下载" : "Download",
	github: "GitHub",
	langLink: zh ? "EN" : "中文",
	langHref,
};

/* ---------- 顶部导航项（数据驱动） ---------- */
const navItems = [
	{ key: "docs", label: copy.docs, href: `${base}/docs/` },
	{ key: "wiki", label: copy.wiki, href: "/wiki/" },
	{ key: "ecosystem", label: copy.ecosystem, href: `${base}/docs/ecosystem/` },
	{
		key: "products",
		label: copy.products,
		dropdown: true,
	},
	{ key: "download", label: copy.download, href: `${base}/download/` },
	{ key: "roadmap", label: copy.roadmap, href: `${base}/roadmap/` },
	{ key: "blog", label: copy.blog, href: `${base}/blog/` },
];

/* ---------- 自建产品下拉（数据驱动，维护这里即可） ---------- */
const products = [
	{
		id: "zeta",
		logo: "/assets/zeta-logo.svg",
		name: zh ? "Zeta — Agent 开发环境" : "Zeta — Agent Development Environment",
		desc: zh
			? "一个工作台，三个入口：Work Studio（浏览器与桌面版）、编码 Agent zetacode、终端 IDE zetaide。Linux 主力，Windows 支持。"
			: "One workbench, three entries: Work Studio (browser and desktop), the zetacode agent CLI, and the zetaide terminal IDE. Linux-first, Windows supported.",
		href: zh ? "/zeta/zh/" : "/zeta/en/",
	},
	{
		id: "sdk",
		logo: "/assets/bio-sdk-logo.svg",
		name: zh ? "Bio SDK — 本地生信平台" : "Bio SDK — Local Bioinformatics",
		desc: zh
			? "本地优先生物信息学分析平台：数据、工具链与流程全部在本地运行。"
			: "Local-first bioinformatics workbench: data, toolchains and pipelines run on-device.",
		href: zh ? "/bio-sdk/zh/" : "/bio-sdk/en/",
	},
];
---

<nav class="site-nav" data-astro-nav>
  {logoLink ? (
    <a class="site-nav__logo" href={`${base}/`}>
      <img class="logo-dark" src="/assets/linxira-l-on-dark.svg" alt="Linxira" width="32" height="32" />
      <img class="logo-light" src="/assets/linxira-l.svg" alt="Linxira" width="32" height="32" />
      <span>Linxira OS</span>
    </a>
  ) : (
    <span class="site-nav__logo site-nav__logo-static">
      <img class="logo-dark" src="/assets/linxira-l-on-dark.svg" alt="Linxira" width="32" height="32" />
      <img class="logo-light" src="/assets/linxira-l.svg" alt="Linxira" width="32" height="32" />
      <span>Linxira OS</span>
    </span>
  )}

  <div class="site-nav__links">
    {navItems.map((item) => (
      item.dropdown ? (
        <div class:list={["site-nav__item", { "is-active": active === item.key }]}>
          <span class="site-nav__trigger" tabindex="0" aria-haspopup="true" aria-expanded="false">
            {item.label}
            <svg class="caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <div class="product-menu" role="menu" aria-label={copy.products}>
            {products.map((p) => (
              <a class="product-menu__item" href={p.href} role="menuitem">
                <span class="product-menu__mark">{p.logo ? <img src={p.logo} alt={p.name} /> : p.mark}</span>
                <span class="product-menu__body">
                  <span class="product-menu__name">{p.name}</span>
                  <span class="product-menu__desc">{p.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          class:list={["site-nav__item", "site-nav__link", { "is-active": active === item.key }]}
          href={item.href}
        >
          {item.label}
        </a>
      )
    ))}

    <a class="site-nav__link site-nav__gh" href="https://github.com/Linxira-OS" target="_blank" rel="noopener">{copy.github}</a>
    <div class="site-nav__side">
      {themeToggle && (
        <button class="site-nav__pillbtn site-nav__theme" id="themeToggle" type="button" aria-label="切换深浅主题" title="切换深浅主题" onclick="toggleSiteTheme()">
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
      )}
      <a class="site-nav__pillbtn site-nav__lang" href={copy.langHref}>{copy.langLink}</a>
    </div>
  </div>
</nav>

<script is:inline>
  // 全局主题切换：html[data-theme] 是唯一开关；body 的 light/dark 类同步给
  // 少数仍按 body class 写样式的子站（bio-sdk）。
  window.toggleSiteTheme = function () {
    var html = document.documentElement;
    var next = html.dataset.theme === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    try { localStorage.setItem('linxira-theme', next); } catch (e) {}
    if (document.body && (document.body.classList.contains('light') || document.body.classList.contains('dark'))) {
      document.body.classList.remove('light', 'dark');
      document.body.classList.add(next);
    }
  };
</script>

<style>
  /* ============================================================
   *  导航样式（组件自包含，不依赖页面内联样式）
   *  颜色沿用全站品牌色：teal var(--t-brand) / coral var(--t-signal)
   * ============================================================ */
  .site-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem clamp(1rem, 4vw, 2rem);
    background: color-mix(in oklab, var(--t-bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--t-border-subtle);
  }
  .site-nav__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-nav__logo-static { cursor: default; }
  .site-nav__logo img { width: 32px; height: 32px; }
  .site-nav__logo span { color: var(--t-text); font-weight: 600; }

  .site-nav__links {
    display: flex;
    gap: 1.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* 普通链接项 */
  .site-nav__link {
    color: var(--t-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .site-nav__link:hover { color: var(--t-brand); }
  .site-nav__item.is-active,
  .site-nav__link.is-active { color: var(--t-brand); }

  /* ---- 下拉触发项 ---- */
  .site-nav__item {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .site-nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--t-text-muted);
    font-size: 0.9rem;
    cursor: pointer;
    user-select: none;
    transition: color 0.2s;
  }
  .site-nav__trigger:hover,
  .site-nav__item.is-active .site-nav__trigger,
  .site-nav__item:focus-within .site-nav__trigger {
    color: var(--t-brand);
  }
  .site-nav__trigger .caret {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 0.2s;
  }
  .site-nav__item:hover .caret,
  .site-nav__item:focus-within .caret {
    transform: rotate(180deg);
  }

  /* ---- 产品下拉菜单（标准 hover + focus 展开） ---- */
  .product-menu {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 300px;
    padding: 0.5rem;
    background: var(--t-surface);
    border: 1px solid var(--t-border-strong);
    border-radius: 12px;
    box-shadow: 0 16px 40px -28px rgba(0, 0, 0, 0.55);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }
  .site-nav__item:hover .product-menu,
  .site-nav__item:focus-within .product-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .product-menu__item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.7rem 0.8rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .product-menu__item:hover { background: color-mix(in oklab, var(--t-brand) 10%, transparent); }
  .product-menu__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 6px;
    font-weight: 800;
    background: color-mix(in oklab, var(--t-brand) 15%, transparent);
    color: var(--t-brand);
  }
  .product-menu__mark img { width: 100%; height: 100%; object-fit: contain; border-radius: 4px; }
  .product-menu__body { display: flex; flex-direction: column; gap: 0.15rem; }
  .product-menu__name { color: var(--t-text); font-size: 0.92rem; font-weight: 600; }
  .product-menu__desc { color: var(--t-text-muted); font-size: 0.78rem; line-height: 1.4; }

  /* ---- 右侧（GitHub / 语言 + 主题 pill） ---- */
  .site-nav__gh { margin-left: 0.4rem; }
  .site-nav__side {
    display: flex; align-items: center; gap: 2px;
    border: 1px solid var(--t-border-strong); border-radius: 999px; padding: 2px;
  }
  .site-nav__pillbtn {
    background: none;
    border: 0;
    color: var(--t-text-muted);
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--t-font-mono);
    font-size: 0.72rem;
    letter-spacing: .04em;
    line-height: 1;
    transition: background 0.2s, color 0.2s;
  }
  .site-nav__pillbtn:hover { background: var(--t-surface-2); color: var(--t-text); }
  .site-nav__theme { display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .theme-icon { width: 14px; height: 14px; display: block; }
  /* 深色(主站 data-theme / bio-sdk body.dark): 显示月亮; 浅色: 显示太阳 */
  html[data-theme="dark"] .theme-icon-sun, body.dark .theme-icon-sun { display: none; }
  html[data-theme="light"] .theme-icon-moon, body.light .theme-icon-moon { display: none; }
  /* logo：直接用官方两版资产（深底版 / 浅底版），不重绘、不加底衬 */
  .site-nav__logo .logo-light { display: none; }
  html[data-theme="light"] .site-nav__logo .logo-dark { display: none; }
  html[data-theme="light"] .site-nav__logo .logo-light { display: block; }

  @media (max-width: 768px) {
    .site-nav { padding: 0.8rem 1rem; }
    .site-nav__links { gap: 1rem; }
    .product-menu { left: auto; right: 0; transform: none; min-width: 260px; }
    .site-nav__item:hover .product-menu,
    .site-nav__item:focus-within .product-menu { transform: none; }
  }

  /* 手机竖屏：logo 缩小，链接行不换行、改为横向轻扫，避免导航堆叠占半屏 */
  @media (max-width: 480px) {
    .site-nav { padding: 0.7rem 0.9rem; gap: 0.75rem; }
    .site-nav__logo img { width: 26px; height: 26px; }
    .site-nav__logo span { font-size: 0.95rem; }
    .site-nav__links {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      gap: 1rem;
    }
    .site-nav__links::-webkit-scrollbar { display: none; }
    .site-nav__link,
    .site-nav__trigger { font-size: 0.82rem; white-space: nowrap; }
    .site-nav__lang { padding: 0.3rem 0.65rem; font-size: 0.8rem; }
  }
</style>

<script is:inline>
  // 键盘可达性：Enter/Space 展开收起产品下拉，并同步 aria-expanded
  document.querySelectorAll(".site-nav__item[data-astro-nav]")?.length;
  document.querySelectorAll(".site-nav__trigger").forEach((trigger) => {
    const item = trigger.closest(".site-nav__item");
    const menu = trigger.nextElementSibling;
    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = item.classList.toggle("is-open");
      trigger.setAttribute("aria-expanded", String(open));
    });
    trigger.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        trigger.click();
      }
    });
    // 点击菜单项后收起
    menu?.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        item.classList.remove("is-open");
        trigger.setAttribute("aria-expanded", "false");
      })
    );
  });
  // 点击导航外部时收起
  document.addEventListener("click", (e) => {
    document.querySelectorAll(".site-nav__item.is-open").forEach((item) => {
      if (!item.contains(e.target)) {
        item.classList.remove("is-open");
        item.querySelector(".site-nav__trigger").setAttribute("aria-expanded", "false");
      }
    });
  });
</script>