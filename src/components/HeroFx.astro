---
/**
 * HeroFx.astro — 首页 hero 的动效与实时指标。
 *
 * 只做三件事，都受 prefers-reduced-motion 约束：
 *   1. h1 字符解码（进页面时逐字落定，不改变最终文本）
 *   2. 一行终端状态：三条命令循环打字，带光标
 *   3. 指标数字从 0 计数到真实值，数字全部来自 data 层，不写死
 *
 * 数字来源：releases（ISO 批次/体积）+ ecosystem（catalog 与 packages 计数）。
 */
import { releases } from '../data/releases';
import { ecosystem } from '../data/ecosystem';

interface Props {
  lang: 'zh' | 'en';
}
const { lang } = Astro.props;
const zh = lang === 'zh';

const metrics = [
  { value: releases.iso.label, key: zh ? '最新镜像批次' : 'Latest image' },
  { value: releases.iso.sizeHuman, key: zh ? 'ISO 体积' : 'ISO size' },
  { value: String(ecosystem.catalogTotal), key: zh ? '审核软件' : 'Reviewed apps', count: true },
  { value: String(ecosystem.packageTotal), key: zh ? '自研包' : 'First-party pkgs', count: true }
];

const commands = [
  '$ linxira-meta --status',
  `✓ kernel linux + linux-lts · repo [linxira] verified`,
  `✓ catalog ${ecosystem.catalogTotal} apps / ${ecosystem.catalogCategories} categories`,
  `$ pacman -Syu linxira-meta   # ${ecosystem.packageTotal} packages`
];
---

<div class="hero-fx" data-hero-fx data-lines={JSON.stringify(commands)}>
  <div class="hero-fx__term" aria-hidden="true">
    <span class="hero-fx__screen" data-hero-typed></span><span class="hero-fx__caret"></span>
  </div>
  <div class="hero-fx__metrics">
    {metrics.map((m) => (
      <div class="hero-fx__metric">
        <b data-count-target={m.count ? m.value : undefined}>{m.value}</b>
        <span>{m.key}</span>
      </div>
    ))}
  </div>
</div>

<style is:global>
  .hero-fx { position: relative; z-index: 2; margin: 2.2rem auto 0; max-width: 780px; }

  .hero-fx__term {
    display: flex; align-items: center; justify-content: center; gap: 2px;
    min-height: 1.9em;
    font-family: var(--t-font-mono); font-size: .82rem; letter-spacing: .01em;
    color: var(--t-text-secondary);
    padding: .5rem .9rem; border-radius: 999px;
    background: color-mix(in oklab, var(--t-surface) 72%, transparent);
    box-shadow: inset 0 0 0 1px var(--t-border-subtle);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .hero-fx__screen { color: var(--t-text-secondary); overflow: hidden; text-overflow: ellipsis; }
  .hero-fx__term:has(.hero-fx__screen:empty) { visibility: hidden; }
  .hero-fx__caret {
    display: inline-block; width: .5em; height: 1em; vertical-align: -.15em;
    background: var(--t-brand);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-fx__caret { animation: heroBlink 1.05s steps(1) infinite; }
  }
  @keyframes heroBlink { 0%, 49% { opacity: 1 } 50%, 100% { opacity: 0 } }

  .hero-fx__metrics {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1.9rem;
    border-top: 1px solid var(--t-border-subtle);
    border-bottom: 1px solid var(--t-border-subtle);
    text-align: left;
  }
  .hero-fx__metric { padding: .85rem .9rem .8rem 0; min-width: 0; }
  .hero-fx__metric + .hero-fx__metric { padding-left: 1.1rem; border-left: 1px solid var(--t-border-subtle); }
  .hero-fx__metric b {
    display: block; font-family: var(--t-font-mono); font-weight: 500;
    font-size: clamp(.95rem, 1.5vw, 1.15rem); line-height: 1.25; letter-spacing: -.02em;
    color: var(--t-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .hero-fx__metric span {
    display: block; margin-top: .3rem;
    font-family: var(--t-font-mono); font-size: .6rem; letter-spacing: .12em;
    text-transform: uppercase; color: var(--t-text-muted);
  }
  @media (max-width: 760px) {
    .hero-fx { margin-top: 1.8rem; }
    .hero-fx__metrics { grid-template-columns: 1fr 1fr; }
    .hero-fx__metric:nth-child(3) { border-left: 0; padding-left: 0; }
    .hero-fx__metric:nth-child(3), .hero-fx__metric:nth-child(4) { border-top: 1px solid var(--t-border-subtle); }
    .hero-fx__metric:nth-child(4) { padding-left: 1.1rem; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-hero-fx]');
    if (!root || root.dataset.fxReady) return;
    root.dataset.fxReady = '1';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var h1 = document.querySelector('.hero h1');
    var GLYPHS = '▓▒░<>/#%&*+=0123456789ABCDEF';
    if (h1 && !reduce) {
      var final = h1.textContent;
      var chars = Array.from(final);
      if (!h1.dataset.scrambled) {
        h1.dataset.scrambled = '1';
        h1.textContent = '';
        var spans = chars.map(function (ch) {
          var s = document.createElement('span');
          s.textContent = ch === ' ' ? ' ' : GLYPHS[(Math.random() * GLYPHS.length) | 0];
          h1.appendChild(s);
          return s;
        });
        var t0 = performance.now();
        (function frame(now) {
          var t = now - t0;
          var settled = true;
          for (var i = 0; i < spans.length; i++) {
            if (t > 180 + i * 45) { if (spans[i].textContent !== chars[i]) spans[i].textContent = chars[i]; }
            else { settled = false; spans[i].textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0]; }
          }
          if (!settled) requestAnimationFrame(frame);
          else h1.textContent = final;
        })(t0);
      }
    }

    var lines = [];
    try { lines = JSON.parse(root.dataset.lines || '[]'); } catch (e) {}
    var screen = root.querySelector('[data-hero-typed]');
    if (screen && lines.length) {
      if (reduce) {
        screen.textContent = lines[1] || lines[0];
      } else {
        var li = 0, ci = 0, erase = false;
        (function step() {
          var line = lines[li];
          if (!erase && ci <= line.length) { screen.textContent = line.slice(0, ci++); setTimeout(step, 26); }
          else if (!erase) { erase = true; setTimeout(step, 2200); }
          else if (ci > 0) { screen.textContent = line.slice(0, --ci); setTimeout(step, 10); }
          else { erase = false; li = (li + 1) % lines.length; setTimeout(step, 260); }
        })();
      }
    }

    var counters = root.querySelectorAll('[data-count-target]');
    if (counters.length && !reduce) {
      var run = function (el) {
        var target = Number(el.dataset.countTarget);
        if (!isFinite(target) || target <= 0) return;
        var start = performance.now(), dur = 900;
        (function tick(now) {
          var p = Math.min(1, (now - start) / dur);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        })(start);
      };
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); run(e.target); } });
        }, { threshold: .5 });
        counters.forEach(function (c) { io.observe(c); });
      } else {
        counters.forEach(run);
      }
    }
  })();
</script>
