---
/**
 * HeroFx.astro — 首页 hero 的终端窗口 / 指标条 / 字符动效。
 *
 * 三种用法：
 *   <HeroFx variant="hero" />    右侧终端窗口（逐字打印，带光标）
 *   <HeroFx variant="metrics" /> 四格指标（数字从 0 计数到真实值）
 *   <HeroFx />                   终端 + 指标竖排（移动端 / 单列封面）
 *
 * 动效都受 prefers-reduced-motion 约束：reduce 时直接呈现最终文本。
 * 数字来源：releases（ISO 批次/体积）+ ecosystem（catalog 与 packages 计数）。
 */
import { releases } from '../data/releases';
import { ecosystem } from '../data/ecosystem';

interface Props {
  lang: 'zh' | 'en';
  variant?: 'hero' | 'metrics' | 'both';
}
const { lang, variant = 'both' } = Astro.props;
const zh = lang === 'zh';

const metrics = [
  { value: releases.iso.label, key: zh ? '最新镜像批次' : 'Latest image' },
  { value: releases.iso.sizeHuman, key: zh ? 'ISO 体积' : 'ISO size' },
  { value: String(ecosystem.catalogTotal), key: zh ? '审核软件' : 'Reviewed apps', count: true },
  { value: String(ecosystem.packageTotal), key: zh ? '自研包' : 'First-party pkgs', count: true }
];

const lines = [
  '$ linxira-meta --status',
  '  kernel    linux + linux-lts  ok',
  '  desktop   KDE Plasma 6',
  '  repo      [linxira] signature verified',
  `$ catalog --count`,
  `  ${ecosystem.catalogTotal} entries · ${ecosystem.catalogCategories} categories`,
  '$ sudo pacman -Syu linxira-meta',
  `:: ${ecosystem.packageTotal} packages · signature verified`
];

const showHero = variant !== 'metrics';
const showMetrics = variant !== 'hero';
---

<div class:list={["hero-fx", `hero-fx--${variant}`]} data-hero-fx data-lines={JSON.stringify(lines)}>
  {showHero && (
    <div class="hero-term" aria-label={zh ? "安装演示终端" : "Install demo terminal"}>
      <div class="hero-term__bar">
        <i></i><i></i><i></i>
        <span class="hero-term__name">linxira@workstation — zsh</span>
      </div>
      <pre class="hero-term__body" data-hero-typed></pre>
    </div>
  )}
  {showMetrics && (
    <div class="hero-fx__metrics">
      {metrics.map((m) => (
        <div class="hero-fx__metric">
          <b data-count-target={m.count ? m.value : undefined}>{m.value}</b>
          <span>{m.key}</span>
        </div>
      ))}
    </div>
  )}
</div>

<style is:global>
  .hero-fx { position: relative; z-index: 2; }
  .hero-fx--both { margin: 2.2rem auto 0; max-width: 780px; }

  /* ---------- 终端窗口 ---------- */
  .hero-term {
    border-radius: var(--t-radius); background: var(--t-code-bg);
    box-shadow: 0 0 0 1px var(--t-border-subtle), 0 12px 24px -20px rgba(0,0,0,.35);
    overflow: hidden; text-align: left;
  }
  .hero-term__bar {
    display: flex; align-items: center; gap: 6px; height: 38px; padding: 0 14px;
    border-bottom: 1px solid var(--t-border-subtle); background: var(--t-surface);
  }
  .hero-term__bar i { width: 10px; height: 10px; border-radius: 50%; display: block; }
  .hero-term__bar i:nth-child(1) { background: var(--t-danger); }
  .hero-term__bar i:nth-child(2) { background: var(--t-warning); }
  .hero-term__bar i:nth-child(3) { background: var(--t-success); }
  .hero-term__name {
    flex: 1; text-align: center; margin-right: 38px;
    font-family: var(--t-font-mono); font-size: 11.5px; letter-spacing: .06em;
    color: var(--t-text-muted);
  }
  .hero-term__body {
    margin: 0; padding: 18px 20px 22px; min-height: 232px;
    font-family: var(--t-font-mono); font-size: 12.6px; line-height: 1.95;
    color: var(--t-text-secondary); white-space: pre-wrap; word-break: break-word;
  }
  .hero-term__caret {
    display: inline-block; width: 7px; height: 1em; vertical-align: -2px; background: var(--t-brand);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-term__caret { animation: heroBlink 1.05s steps(1) infinite; }
  }
  @keyframes heroBlink { 0%, 49% { opacity: 1 } 50%, 100% { opacity: 0 } }

  /* ---------- 指标条 ---------- */
  .hero-fx__metrics {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--t-border-subtle);
    border-bottom: 1px solid var(--t-border-subtle);
    text-align: left;
  }
  .hero-fx--metrics { margin-top: clamp(2rem, 4vw, 3rem); }
  .hero-fx__metric { padding: .9rem .9rem .85rem 0; min-width: 0; }
  .hero-fx__metric + .hero-fx__metric { padding-left: 1.2rem; border-left: 1px solid var(--t-border-subtle); }
  .hero-fx__metric b {
    display: block; font-family: var(--t-font-mono); font-weight: 500;
    font-size: clamp(1rem, 1.6vw, 1.3rem); line-height: 1.25; letter-spacing: -.02em;
    color: var(--t-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .hero-fx__metric span {
    display: block; margin-top: .32rem;
    font-family: var(--t-font-mono); font-size: .62rem; letter-spacing: .12em;
    text-transform: uppercase; color: var(--t-text-muted);
  }
  @media (max-width: 760px) {
    /* 手机上终端窗口不要留一大片空白等打字 */
    .hero-term__body { min-height: 150px; padding: 14px 16px 18px; font-size: 12px; }
    .hero-fx__metrics { grid-template-columns: 1fr 1fr; }
    .hero-fx__metric:nth-child(3) { border-left: 0; padding-left: 0; }
    .hero-fx__metric:nth-child(3), .hero-fx__metric:nth-child(4) { border-top: 1px solid var(--t-border-subtle); }
    .hero-fx__metric:nth-child(4) { padding-left: 1.2rem; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-hero-fx]');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!root || root.dataset.fxReady) return;
    root.dataset.fxReady = '1';

    /* ---------- 字符解码：只作用于 [data-hero-scramble]，不动渐变字 ---------- */
    var GLYPHS = '▓▒░<>/#%&*+=0123456789ABCDEF';
    var targets = document.querySelectorAll('[data-hero-scramble]');
    if (!reduce) {
      targets.forEach(function (el, idx) {
        if (el.dataset.scrambled) return;
        el.dataset.scrambled = '1';
        var final = el.textContent;
        var chars = Array.from(final);
        el.textContent = '';
        var spans = chars.map(function (ch) {
          var s = document.createElement('span');
          s.textContent = ch === ' ' ? ' ' : GLYPHS[(Math.random() * GLYPHS.length) | 0];
          el.appendChild(s);
          return s;
        });
        var t0 = performance.now();
        var settle = 200 + idx * 80;
        (function frame(now) {
          var t = now - t0;
          var done = true;
          for (var i = 0; i < spans.length; i++) {
            if (t > settle + i * 42) { if (spans[i].textContent !== chars[i]) spans[i].textContent = chars[i]; }
            else { done = false; spans[i].textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0]; }
          }
          if (!done) requestAnimationFrame(frame);
          else el.textContent = final;
        })(t0);
      });
    }

    /* ---------- 终端逐字打印 ---------- */
    var lines = [];
    try { lines = JSON.parse(root.dataset.lines || '[]'); } catch (e) {}
    var screen = root.querySelector('[data-hero-typed]');
    if (screen && lines.length) {
      if (reduce) {
        screen.textContent = lines.join('\n');
      } else {
        var caret = document.createElement('span');
        caret.className = 'hero-term__caret';
        screen.appendChild(caret);
        var li = 0, ci = 0, cur = null;
        function step() {
          if (li >= lines.length) { screen.appendChild(document.createTextNode('\n')); return; }
          var line = lines[li];
          if (!cur) {
            cur = document.createElement('span');
            screen.insertBefore(cur, caret);
            if (li > 0) screen.insertBefore(document.createTextNode('\n'), cur);
          }
          if (ci < line.length) {
            cur.textContent += line.charAt(ci++);
            setTimeout(step, 16);
          } else {
            ci = 0; cur = null; li++;
            setTimeout(step, 240);
          }
        }
        setTimeout(step, 420);
      }
    }

    /* ---------- 指标计数 ---------- */
    var counters = document.querySelectorAll('[data-count-target]');
    if (counters.length && !reduce) {
      var run = function (el) {
        var target = Number(el.dataset.countTarget);
        if (!isFinite(target) || target <= 0) return;
        var start = performance.now(), dur = 900;
        (function tick(now) {
          var p = Math.min(1, (now - start) / dur);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        })(start);
      };
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); run(e.target); } });
        }, { threshold: .5 });
        counters.forEach(function (c) { io.observe(c); });
      } else counters.forEach(run);
    }
  })();
</script>
