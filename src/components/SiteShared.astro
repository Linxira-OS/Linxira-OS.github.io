---
/**
 * SiteShared.astro — 官网子页面共享 head：主题 token、字体、玻璃卡、reveal 动效、正文排版、.lx-* 原子类
 * 供 DocsLayout / PageLayout 使用（子页面不再各自硬编码重复 CSS）
 * 注意：Astro 组件内 <style is:global> 避免 scoped；reveal 脚本 is:inline 全站生效
 */
interface Props {
  title: string;
  /** <meta name="description"> 与 og:description；不给就退回站点默认文案。 */
  description?: string;
  /** 语言，用于 og:locale 与默认文案。 */
  lang?: "zh" | "en";
  /** 规范链接（og:url / canonical）。 */
  canonical?: string;
}
import "../styles/linxira-theme.css";
import "../styles/linxira-fonts.css";
import "../styles/linxira-components.css";
const { title, lang = "zh", canonical } = Astro.props;
const zh = lang === "zh";
const siteDefault = zh
  ? "Linxira OS：面向科学计算的 Arch Linux 发行版——KDE Plasma 桌面、签名仓库 [linxira]、双内核兜底，开箱即用的科学计算环境。"
  : "Linxira OS: an Arch Linux distribution for scientific computing — KDE Plasma desktop, signed [linxira] repository, dual-kernel safety net.";
const description = Astro.props.description?.trim() || siteDefault;
---
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Linxira OS">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:locale" content={zh ? "zh_CN" : "en_US"}>
<meta name="twitter:card" content="summary_large_image">
{canonical && <link rel="canonical" href={canonical} />}
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<script is:inline>
  /* 首帧前应用主题，避免刷新闪白。默认深色；用户手动切换后记住选择。 */
  (function () {
    var saved = null;
    try { saved = localStorage.getItem('linxira-theme'); } catch (e) {}
    document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
    document.documentElement.classList.add('js');
  })();
</script>
<link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    /* 旧变量名 → token 的兼容别名，页面里存量的 var(--teal) 等继续可用 */
    --teal: var(--t-brand); --coral: var(--t-signal);
    --bg: var(--t-bg-deep); --bg-deep: var(--t-bg-deep); --bg-alt: var(--t-surface);
    --ink: var(--t-text); --ink-strong: var(--t-text);
    --muted: var(--t-text-muted); --faint: var(--t-text-muted); --soft: var(--t-text-secondary);
    --line: var(--t-border-subtle);
    --glass-a: color-mix(in oklab, var(--t-surface) 82%, transparent);
    --glass-b: color-mix(in oklab, var(--t-surface) 64%, transparent);
    --glass-c: color-mix(in oklab, var(--t-bg) 72%, transparent);
    --glass-border: var(--t-border-subtle);
    --glass-hi: color-mix(in oklab, var(--t-text) 8%, transparent);
    --glass-hi2: color-mix(in oklab, var(--t-text) 4%, transparent);
    --glass-sheen: color-mix(in oklab, var(--t-text) 6%, transparent);
    --glass-glow: color-mix(in oklab, var(--t-brand) 10%, transparent);
  }
  html { -webkit-text-size-adjust: 100%; }
  body {
    font-family: var(--t-font-sans);
    background: var(--t-bg);
    color: var(--t-text);
    line-height: 1.8;
    overflow-x: hidden;
    /* 不要写 -webkit-font-smoothing: antialiased：
       Windows/Chrome 上它会关掉亚像素渲染，小字号直接发虚。
       保持浏览器默认（auto）才是清晰的。 */
  }
  ::selection { background: color-mix(in oklab, var(--t-brand) 35%, transparent); }
  :focus-visible { outline: 2px solid var(--t-brand); outline-offset: 2px; border-radius: 4px; }

  /* ---------- 液态玻璃 / 卡片面（深色玻璃，浅色纯面 + ring） ---------- */
  .glass {
    position: relative;
    background: linear-gradient(135deg, var(--glass-a), var(--glass-b) 35%, var(--glass-c));
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    backdrop-filter: blur(12px) saturate(180%);
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glass-hi), inset 1px 0 0 var(--glass-hi2), 0 20px 60px -40px rgba(0,0,0,0.45);
  }
  .glass::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: linear-gradient(115deg, var(--glass-sheen) 0%, transparent 40%),
      radial-gradient(120% 70% at 18% 0%, var(--glass-glow), transparent 55%);
  }
  [data-theme="light"] .glass {
    background: var(--t-surface);
    border-color: var(--t-border-subtle);
    box-shadow: 0 0 0 1px var(--t-border-subtle), 0 18px 40px -34px rgba(11, 17, 19, .22);
    -webkit-backdrop-filter: none; backdrop-filter: none;
  }
  [data-theme="light"] .glass::before { display: none; }

  /* ---------- 滚动揭示 ---------- */
  /* 内容始终可见；入场动画会让"过渡没跑起来"时整块发灰。 */
  .reveal { opacity: 1; transform: none; transition: none; }
  .reveal.in { opacity: 1; transform: none; }
  .reveal-d1 { transition-delay: 0.08s; }
  .reveal-d2 { transition-delay: 0.16s; }
  .reveal-d3 { transition-delay: 0.24s; }

  /* ---------- 正文排版（容器型页面共用） ---------- */
  h1 { font-size: clamp(1.9rem, 4vw, 2.2rem); font-weight: 700; letter-spacing: -.025em; margin-bottom: 1rem; background: linear-gradient(100deg in oklab, var(--t-brand) 0%, var(--t-brand) 58%, var(--t-signal) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  h2 { font-size: 1.4rem; color: var(--t-text); letter-spacing: -.02em; margin: 2rem 0 0.8rem; padding-top: 1rem; border-top: 1px solid var(--t-border-subtle); }
  h3 { font-size: 1.15rem; color: var(--t-text); letter-spacing: -.015em; margin: 1.5rem 0 0.5rem; }
  p { color: var(--t-text-secondary); margin-bottom: 1rem; }
  strong { color: var(--t-text); }
  a { color: var(--t-brand); }
  ul { color: var(--t-text-secondary); margin: 0.5rem 0 1rem 1.5rem; }
  li { margin-bottom: 0.3rem; }
  code {
    background: var(--t-surface-2); padding: 0.15rem 0.4rem; border-radius: 4px;
    font-family: var(--t-font-mono); font-size: 0.85em; color: var(--t-brand);
  }
  pre code { background: none; padding: 0; color: inherit; }
  .container { max-width: 760px; margin: 0 auto; padding: 8rem 2rem 4rem; }
  .back { color: var(--t-brand); text-decoration: none; font-size: 0.9rem; display: inline-block; margin-bottom: 2rem; }
  .back:hover { text-decoration: underline; }
  .section-divider { width: 60px; height: 3px; margin: 0.4rem 0 1.5rem; background: linear-gradient(90deg, var(--t-brand), var(--t-signal)); border-radius: 2px; }

  @media (prefers-reduced-motion: no-preference) {
    .glass { transition: 160ms ease; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>
<script is:inline>
  // 滚动揭示（全站子页面共用）。head 内联执行时 body 尚不存在，
  // 必须等 DOMContentLoaded 再观察 .reveal，否则元素永远 opacity:0。
  (function () {
    if (document.body && document.body.dataset.revealReady) return;
    var init = function () {
      if (document.body.dataset.revealReady) return;
      document.body.dataset.revealReady = '1';
      var els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        els.forEach(function (el) { io.observe(el); });
      } else {
        els.forEach(function (el) { el.classList.add('in'); });
      }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
