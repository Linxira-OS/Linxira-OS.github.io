        <!-- DESeq2 Volcano -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent-red)" stroke-width="2"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg>
            <span>expression.differential.v1</span>
          </div>
          <div class="gallery-item-body"><svg id="volcano-host" viewBox="0 0 260 200" width="240" height="180"></svg></div>
        </div>

        <!-- GSEA -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <span>enrichment.gsea.v1</span>
          </div>
          <div class="gallery-item-body"><svg id="gsea-host" viewBox="0 0 260 200" width="240" height="180"></svg></div>
        </div>

        <!-- K-mer Frequency -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent-amber)" stroke-width="2"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
            <span>sequence.kmer.count.v1</span>
          </div>
          <div class="gallery-item-body"><svg id="kmer-host" viewBox="0 0 260 200" width="240" height="180"></svg></div>
        </div>

        <!-- Sequence Motif Logo -->
