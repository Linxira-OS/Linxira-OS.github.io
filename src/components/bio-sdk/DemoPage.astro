---
const { zh } = Astro.props;
---
    <!-- ===== DEMO RESULTS PAGE ===== -->
    <div class="page" id="page-demo">
      <h2 class="section-title">{zh ? "示例分析结果" : "Demo Analysis Results"}</h2>
      <p style="color:var(--text-dim);margin-bottom:1.5rem;font-size:0.875rem">{zh ? "以下展示 Linxira Bio SDK 各分析能力的典型输出结果。所有结果均为结构化 JSON 格式，可直接用于下游分析。" : "Typical outputs from Linxira Bio SDK capabilities. All results are structured JSON ready for downstream analysis."}</p>

      <!-- Result Gallery -->
      <div class="gallery">
        <!-- Dotplot -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--brand-teal)" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            <span>comparative.dotplot.v1</span>
          </div>
          <div class="gallery-item-body">
            <svg viewBox="0 0 260 260" width="240" height="240">
              <rect width="260" height="260" style="fill:var(--chart-bg)"/>
              <line x1="20" y1="20" x2="240" y2="20" style="stroke:var(--chart-grid)" stroke-width="0.5"/>
              <line x1="20" y1="240" x2="240" y2="240" style="stroke:var(--chart-grid)" stroke-width="0.5"/>
              <line x1="20" y1="20" x2="20" y2="240" style="stroke:var(--chart-grid)" stroke-width="0.5"/>
              <line x1="240" y1="20" x2="240" y2="240" style="stroke:var(--chart-grid)" stroke-width="0.5"/>
              <!-- Diagonal line -->
              <line x1="20" y1="20" x2="240" y2="240" style="stroke:var(--brand-dark)" stroke-width="0.5" stroke-dasharray="4,4"/>
              <!-- Dots -->
              <circle cx="50" cy="50" r="1.5" fill="#20B8B0" opacity="0.8"><animate attributeName="opacity" values="0.4;1;0.4" dur="2s" repeatCount="indefinite"/></circle>
              <circle cx="100" cy="95" r="1.5" fill="#20B8B0" opacity="0.8"/>
              <circle cx="150" cy="145" r="1.5" fill="#20B8B0" opacity="0.8"/>
              <circle cx="200" cy="195" r="1.5" fill="#20B8B0" opacity="0.8"/>
              <circle cx="80" cy="130" r="1.5" fill="#31679E" opacity="0.6"/>
              <circle cx="130" cy="80" r="1.5" fill="#31679E" opacity="0.6"/>
              <circle cx="170" cy="70" r="1.5" fill="#31679E" opacity="0.6"/>
              <circle cx="60" cy="180" r="1.5" fill="#31679E" opacity="0.6"/>
              <circle cx="190" cy="150" r="1.5" fill="#6B4EA0" opacity="0.5"/>
              <circle cx="120" cy="200" r="1.5" fill="#6B4EA0" opacity="0.5"/>
              <circle cx="210" cy="100" r="1.5" fill="#6B4EA0" opacity="0.5"/>
              <text x="130" y="252" text-anchor="middle" style="fill:var(--text-dim)" font-size="9">{zh ? "查询 (chr1)" : "Query (chr1)"}</text>
              <text x="8" y="134" text-anchor="middle" style="fill:var(--text-dim)" font-size="9" transform="rotate(-90,8,134)">{zh ? "参考 (chr1)" : "Reference (chr1)"}</text>
            </svg>
          </div>
        </div>

        <!-- Phylogenetic Tree -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent-green)" stroke-width="2"><path d="M12 20V10"/><path d="M12 10l-4 4"/><path d="M12 10l4 4"/></svg>
            <span>phylogeny.tree.visualize.v1</span>
          </div>
          <div class="gallery-item-body">
            <svg viewBox="0 0 260 200" width="240" height="180">
              <rect width="260" height="200" style="fill:var(--chart-bg)"/>
              <!-- Tree structure -->
              <line x1="20" y1="100" x2="40" y2="100" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="40" y1="100" x2="40" y2="60" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="40" y1="60" x2="40" y2="140" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="40" y1="60" x2="80" y2="40" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="40" y1="60" x2="80" y2="80" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="40" x2="120" y2="30" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="40" x2="120" y2="50" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="80" x2="120" y2="70" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="80" x2="120" y2="90" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="40" y1="140" x2="80" y2="120" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="40" y1="140" x2="80" y2="160" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="120" x2="120" y2="110" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="120" x2="120" y2="130" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="160" x2="120" y2="150" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="160" x2="120" y2="170" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="40" y1="100" x2="80" y2="100" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="100" x2="120" y2="100" stroke="#20B8B0" stroke-width="1.5"/>
              <text x="125" y="33" style="fill:var(--text)" font-size="7">Homo sapiens</text>
              <text x="125" y="53" style="fill:var(--text)" font-size="7">Pan troglodytes</text>
              <text x="125" y="73" style="fill:var(--text)" font-size="7">Gorilla gorilla</text>
              <text x="125" y="93" style="fill:var(--text)" font-size="7">Pongo abelii</text>
              <text x="125" y="103" style="fill:var(--text)" font-size="7">Macaca mulatta</text>
              <text x="125" y="113" style="fill:var(--text)" font-size="7">Mus musculus</text>
              <text x="125" y="133" style="fill:var(--text)" font-size="7">Rattus norvegicus</text>
              <text x="125" y="153" style="fill:var(--text)" font-size="7">Danio rerio</text>
              <text x="125" y="173" style="fill:var(--text)" font-size="7">Xenopus laevis</text>
            </svg>
          </div>
        </div>

        <!-- Expression Heatmap -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent-red)" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><line x1="8" y1="2" x2="8" y2="22"/><line x1="16" y1="2" x2="16" y2="22"/></svg>
            <span>expression.clustered-heatmap.v1</span>
          </div>
          <div class="gallery-item-body">
            <svg viewBox="0 0 260 180" width="240" height="160">
              <rect width="260" height="180" style="fill:var(--chart-bg)"/>
              <!-- Heatmap grid -->
              <rect x="30" y="10" width="24" height="24" style="fill:var(--brand-dark)" rx="1"/>
              <rect x="58" y="10" width="24" height="24" fill="#20B8B0" rx="1"/>
              <rect x="86" y="10" width="24" height="24" style="fill:var(--chart-bg);stroke:var(--chart-grid)" rx="1"/>
              <rect x="114" y="10" width="24" height="24" fill="#AE3939" rx="1"/>
              <rect x="142" y="10" width="24" height="24" fill="#207456" rx="1"/>
              <rect x="170" y="10" width="24" height="24" fill="#B06818" rx="1"/>
              <rect x="30" y="38" width="24" height="24" fill="#AE3939" rx="1"/>
              <rect x="58" y="38" width="24" height="24" style="fill:var(--chart-bg);stroke:var(--chart-grid)" rx="1"/>
              <rect x="86" y="38" width="24" height="24" fill="#20B8B0" rx="1"/>
              <rect x="114" y="38" width="24" height="24" fill="#B06818" rx="1"/>
              <rect x="142" y="38" width="24" height="24" style="fill:var(--brand-dark)" rx="1"/>
              <rect x="170" y="38" width="24" height="24" fill="#31679E" rx="1"/>
              <rect x="30" y="66" width="24" height="24" fill="#B06818" rx="1"/>
              <rect x="58" y="66" width="24" height="24" fill="#AE3939" rx="1"/>
              <rect x="86" y="66" width="24" height="24" style="fill:var(--brand-dark)" rx="1"/>
              <rect x="114" y="66" width="24" height="24" fill="#31679E" rx="1"/>
              <rect x="142" y="66" width="24" height="24" style="fill:var(--chart-bg);stroke:var(--chart-grid)" rx="1"/>
              <rect x="170" y="66" width="24" height="24" fill="#207456" rx="1"/>
              <rect x="30" y="94" width="24" height="24" fill="#31679E" rx="1"/>
              <rect x="58" y="94" width="24" height="24" fill="#207456" rx="1"/>
              <rect x="86" y="94" width="24" height="24" fill="#B06818" rx="1"/>
              <rect x="114" y="94" width="24" height="24" style="fill:var(--brand-dark)" rx="1"/>
              <rect x="142" y="94" width="24" height="24" fill="#AE3939" rx="1"/>
              <rect x="170" y="94" width="24" height="24" style="fill:var(--chart-bg);stroke:var(--chart-grid)" rx="1"/>
              <rect x="30" y="122" width="24" height="24" fill="#207456" rx="1"/>
              <rect x="58" y="122" width="24" height="24" fill="#31679E" rx="1"/>
              <rect x="86" y="122" width="24" height="24" fill="#AE3939" rx="1"/>
              <rect x="114" y="122" width="24" height="24" style="fill:var(--chart-bg);stroke:var(--chart-grid)" rx="1"/>
              <rect x="142" y="122" width="24" height="24" fill="#20B8B0" rx="1"/>
              <rect x="170" y="122" width="24" height="24" style="fill:var(--brand-dark)" rx="1"/>
              <!-- Labels -->
              <text x="42" y="160" style="fill:var(--text-dim)" font-size="7">G1</text>
              <text x="70" y="160" style="fill:var(--text-dim)" font-size="7">G2</text>
              <text x="98" y="160" style="fill:var(--text-dim)" font-size="7">G3</text>
              <text x="126" y="160" style="fill:var(--text-dim)" font-size="7">G4</text>
              <text x="154" y="160" style="fill:var(--text-dim)" font-size="7">G5</text>
              <text x="182" y="160" style="fill:var(--text-dim)" font-size="7">G6</text>
              <text x="6" y="26" style="fill:var(--text-dim)" font-size="7">G1</text>
              <text x="6" y="54" style="fill:var(--text-dim)" font-size="7">G2</text>
              <text x="6" y="82" style="fill:var(--text-dim)" font-size="7">G3</text>
              <text x="6" y="110" style="fill:var(--text-dim)" font-size="7">G4</text>
              <text x="6" y="138" style="fill:var(--text-dim)" font-size="7">G5</text>
            </svg>
          </div>
        </div>

        <!-- PCA Plot -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent-purple)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
            <span>expression.pca.v1</span>
          </div>
          <div class="gallery-item-body">
            <svg viewBox="0 0 260 200" width="240" height="180">
              <rect width="260" height="200" style="fill:var(--chart-bg)"/>
              <!-- Axes -->
              <line x1="40" y1="160" x2="240" y2="160" style="stroke:var(--chart-grid)" stroke-width="0.5"/>
              <line x1="130" y1="20" x2="130" y2="180" style="stroke:var(--chart-grid)" stroke-width="0.5"/>
              <text x="235" y="175" style="fill:var(--text-dim)" font-size="9">PC1</text>
              <text x="135" y="15" style="fill:var(--text-dim)" font-size="9">PC2</text>
              <!-- WT group -->
              <circle cx="90" cy="100" r="4" fill="#20B8B0" opacity="0.8"><animate attributeName="r" values="4;5;4" dur="2s" repeatCount="indefinite"/></circle>
              <circle cx="80" cy="110" r="4" fill="#20B8B0" opacity="0.8"/>
              <circle cx="85" cy="90" r="4" fill="#20B8B0" opacity="0.8"/>
              <circle cx="75" cy="95" r="4" fill="#20B8B0" opacity="0.8"/>
              <!-- KO group -->
              <circle cx="170" cy="70" r="4" fill="#AE3939" opacity="0.8"><animate attributeName="r" values="4;5;4" dur="2.4s" repeatCount="indefinite"/></circle>
              <circle cx="180" cy="60" r="4" fill="#AE3939" opacity="0.8"/>
              <circle cx="175" cy="80" r="4" fill="#AE3939" opacity="0.8"/>
              <circle cx="185" cy="75" r="4" fill="#AE3939" opacity="0.8"/>
              <!-- Ellipses -->
              <ellipse cx="83" cy="99" rx="12" ry="14" fill="none" stroke="#20B8B0" stroke-width="0.8" opacity="0.4"/>
              <ellipse cx="178" cy="71" rx="12" ry="14" fill="none" stroke="#AE3939" stroke-width="0.8" opacity="0.4"/>
              <!-- Legend -->
              <rect x="50" y="170" width="8" height="8" fill="#20B8B0" rx="1"/>
              <text x="62" y="179" style="fill:var(--text-dim)" font-size="8">WT</text>
              <rect x="90" y="170" width="8" height="8" fill="#AE3939" rx="1"/>
              <text x="102" y="179" style="fill:var(--text-dim)" font-size="8">KO</text>
            </svg>
          </div>
        </div>

        <!-- Variant Stats -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent-amber)" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            <span>variant.stats.v1</span>
          </div>
          <div class="gallery-item-body">
            <svg viewBox="0 0 260 200" width="240" height="180">
              <rect width="260" height="200" style="fill:var(--chart-bg)"/>
              <!-- Pie chart -->
              <circle cx="120" cy="90" r="60" fill="none" style="stroke:var(--chart-grid)" stroke-width="0.5"/>
              <path d="M120 90 L120 30 A60 60 0 0 1 175 55 Z" fill="#20B8B0" opacity="0.8">
                <animate attributeName="opacity" values="0.6;0.9;0.6" dur="3s" repeatCount="indefinite"/>
              </path>
              <path d="M120 90 L175 55 A60 60 0 0 1 170 145 Z" fill="#31679E" opacity="0.8"/>
              <path d="M120 90 L170 145 A60 60 0 0 1 70 145 Z" fill="#AE3939" opacity="0.8"/>
              <path d="M120 90 L70 145 A60 60 0 0 1 65 55 Z" fill="#B06818" opacity="0.8"/>
              <path d="M120 90 L65 55 A60 60 0 0 1 120 30 Z" fill="#6B4EA0" opacity="0.8"/>
              <!-- Legend -->
              <rect x="10" y="170" width="8" height="8" fill="#20B8B0" rx="1"/>
              <text x="22" y="179" style="fill:var(--text-dim)" font-size="7">SNP 45%</text>
              <rect x="65" y="170" width="8" height="8" fill="#31679E" rx="1"/>
              <text x="77" y="179" style="fill:var(--text-dim)" font-size="7">INS 20%</text>
              <rect x="130" y="170" width="8" height="8" fill="#AE3939" rx="1"/>
              <text x="142" y="179" style="fill:var(--text-dim)" font-size="7">DEL 18%</text>
              <rect x="190" y="170" width="8" height="8" fill="#B06818" rx="1"/>
              <text x="202" y="179" style="fill:var(--text-dim)" font-size="7">MNP 10%</text>
              <rect x="10" y="190" width="8" height="8" fill="#6B4EA0" rx="1"/>
              <text x="22" y="199" style="fill:var(--text-dim)" font-size="7">Other 7%</text>
            </svg>
          </div>
        </div>

        <!-- RNA Secondary Structure -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent-green)" stroke-width="2"><circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><line x1="12" y1="7" x2="5" y2="17"/><line x1="12" y1="7" x2="19" y2="17"/></svg>
            <span>rna.secondary-structure.v1</span>
          </div>
          <div class="gallery-item-body">
            <svg viewBox="0 0 260 160" width="240" height="140">
              <rect width="260" height="160" style="fill:var(--chart-bg)"/>
              <!-- RNA structure visualization -->
              <line x1="20" y1="80" x2="50" y2="80" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="50" y1="80" x2="50" y2="30" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="50" y1="30" x2="80" y2="30" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="30" x2="80" y2="80" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="80" y1="80" x2="110" y2="80" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="110" y1="80" x2="110" y2="30" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="110" y1="30" x2="140" y2="30" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="140" y1="30" x2="140" y2="80" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="140" y1="80" x2="170" y2="80" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="170" y1="80" x2="170" y2="130" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="170" y1="130" x2="200" y2="130" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="200" y1="130" x2="200" y2="80" stroke="#20B8B0" stroke-width="1.5"/>
              <line x1="200" y1="80" x2="240" y2="80" stroke="#20B8B0" stroke-width="1.5"/>
              <!-- Base pairs (dashed arcs) -->
              <path d="M85 30 Q100 10 115 30" fill="none" stroke="#AE3939" stroke-width="1" stroke-dasharray="3,2"/>
              <path d="M145 30 Q160 10 175 30" fill="none" stroke="#AE3939" stroke-width="1" stroke-dasharray="3,2"/>
              <path d="M55 80 Q70 55 85 80" fill="none" stroke="#31679E" stroke-width="1" stroke-dasharray="3,2"/>
              <path d="M115 80 Q130 55 145 80" fill="none" stroke="#31679E" stroke-width="1" stroke-dasharray="3,2"/>
              <!-- Nodes -->
              <circle cx="50" cy="80" r="3" fill="#20B8B0"/>
              <circle cx="80" cy="80" r="3" fill="#20B8B0"/>
              <circle cx="110" cy="80" r="3" fill="#20B8B0"/>
              <circle cx="140" cy="80" r="3" fill="#20B8B0"/>
              <circle cx="170" cy="80" r="3" fill="#20B8B0"/>
              <circle cx="200" cy="80" r="3" fill="#20B8B0"/>
              <text x="130" y="155" text-anchor="middle" style="fill:var(--text-dim)" font-size="9">MFE: -12.40 kcal/mol</text>
            </svg>
          </div>
        </div>

        <!-- FASTQ Quality Boxplot -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--brand-teal)" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
            <span>fastq.qc.v1</span>
          </div>
          <div class="gallery-item-body"><svg id="qc-host" viewBox="0 0 260 200" width="240" height="180"></svg></div>
        </div>

        <!-- KEGG Enrichment -->
        <div class="gallery-item animate-in" onclick="openDemo(this)">
          <div class="gallery-item-header">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent-purple)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
