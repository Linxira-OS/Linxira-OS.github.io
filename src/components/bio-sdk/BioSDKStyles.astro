---
<style is:global>
/* ===== Reset & Base ===== */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  /* 品牌色 */
  --brand-dark:#0E4A44;--brand-teal:#20B8B0;--brand-light:#E8F7F6;
  /* 深色背景：VSCode Modern Dark 深灰体系（网站默认） */
  --bg:#181818;--bg-panel:#1F1F1F;--bg-card:#242424;--bg-hover:#2A2D2E;
  --text:#CCCCCC;--text-dim:#9D9D9D;--text-bright:#FFFFFF;
  --border:rgba(255,255,255,0.12);--border-strong:rgba(255,255,255,0.22);
  --chart-bg:#181818;--chart-grid:rgba(255,255,255,0.08);
  --accent-green:#207456;--accent-amber:#B06818;
  --accent-red:#AE3939;--accent-blue:#31679E;--accent-purple:#6B4EA0;
  --radius:8px;--radius-sm:4px;--sidebar-w:240px;
  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --font-mono:'JetBrains Mono','Fira Code','Cascadia Code',monospace;
  --transition:0.2s cubic-bezier(0.4,0,0.2,1);
}
html{scroll-behavior:smooth}
html,body{height:100%}
body{
  font-family:var(--font);background:var(--bg);color:var(--text);
  display:flex;height:100vh;overflow:hidden;line-height:1.5;
  /* 顶部为主站固定 Navbar 预留高度 */
  padding-top:60px;
}
a{color:var(--brand-teal);text-decoration:none;transition:var(--transition)}
a:hover{color:#4DD4CC}
code,pre{font-family:var(--font-mono);font-size:0.875rem}
pre{
  background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);
  padding:1rem;overflow-x:auto;margin:0.75rem 0;
}
button{
  cursor:pointer;font-family:var(--font);border:none;outline:none;
  transition:var(--transition);
}
ol{color:var(--text-dim)}

/* ===== Sidebar ===== */
.sidebar{
  width:var(--sidebar-w);min-width:var(--sidebar-w);
  background:var(--bg-panel);border-right:1px solid var(--border);
  display:flex;flex-direction:column;padding:0;overflow-y:auto;
  user-select:none;
}
.sidebar-brand{
  padding:1.25rem 1rem 0.5rem;
  border-bottom:1px solid var(--border);
}
.sidebar-back{
  display:block;margin:0.35rem 0 0;padding:0.3rem 0.5rem;
  font-size:0.78rem;color:var(--text-dim);border-radius:var(--radius-sm);
  text-decoration:none;transition:var(--transition);
}
.sidebar-back:hover{color:var(--brand-teal);background:var(--bg-hover)}
.sidebar-brand .logo{
  display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem;
}
.sidebar-brand .logo svg{width:28px;height:28px;flex-shrink:0}
.sidebar-brand .logo-text{
  font-size:1.125rem;font-weight:700;color:var(--brand-dark);
  letter-spacing:0.02em;
}
.light .sidebar-brand .logo-text{color:var(--brand-dark)}
.dark .sidebar-brand .logo-text{color:var(--brand-teal)}
.sidebar-brand .subtitle{font-size:0.75rem;color:var(--text-dim)}
.sidebar-nav{padding:0.5rem 0;flex:1}
.nav-item{
  display:flex;align-items:center;gap:0.625rem;
  padding:0.5rem 1rem;margin:0.125rem 0.5rem;border-radius:var(--radius);
  font-size:0.875rem;color:var(--text-dim);cursor:pointer;
  transition:var(--transition);
}
.nav-item:hover{background:var(--bg-hover);color:var(--text)}
.nav-item.active{background:var(--brand-dark);color:var(--text-bright)}
.nav-item .nav-icon{width:18px;height:18px;flex-shrink:0;opacity:0.7}
.nav-item.active .nav-icon{opacity:1}
.nav-section{
  padding:1rem 1rem 0.25rem;font-size:0.6875rem;
  font-weight:600;color:var(--text-dim);text-transform:uppercase;
  letter-spacing:0.08em;
}
.lang-toggle{
  display:flex;margin:0.5rem;border:1px solid var(--border);
  border-radius:var(--radius);overflow:hidden;
}
.lang-btn{
  flex:1;padding:0.375rem;font-size:0.75rem;background:transparent;
  color:var(--text-dim);text-align:center;text-decoration:none;
}
.lang-btn.active{background:var(--brand-dark);color:var(--text-bright)}

/* ===== Main Content ===== */
.main{
  flex:1;display:flex;flex-direction:column;overflow:hidden;
  background:var(--bg);
}
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:0.625rem 1.5rem;border-bottom:1px solid var(--border);
  background:var(--bg-panel);min-height:48px;
}
.topbar-title{font-size:0.9375rem;font-weight:600}
.topbar-right{display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap}
.badge{
  display:inline-flex;align-items:center;gap:0.25rem;
  padding:0.2rem 0.5rem;border-radius:999px;font-size:0.6875rem;
  font-weight:500;
}
.badge-ready{background:var(--accent-green);color:#fff}
.badge-version{background:var(--bg-hover);color:var(--text-dim);border:1px solid var(--border)}
.content{
  flex:1;overflow-y:auto;padding:1.5rem;
}
.content::-webkit-scrollbar{width:6px}
.content::-webkit-scrollbar-track{background:transparent}
.content::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

/* ===== Tab Bar ===== */
.tab-bar{
  display:flex;gap:0;border-bottom:1px solid var(--border);
  margin-bottom:1.5rem;
}
.tab{
  padding:0.625rem 1.25rem;font-size:0.875rem;color:var(--text-dim);
  border-bottom:2px solid transparent;cursor:pointer;
  transition:var(--transition);
}
.tab:hover{color:var(--text)}
.tab.active{color:var(--brand-teal);border-bottom-color:var(--brand-teal)}

/* ===== Cards ===== */
.card{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--radius);padding:1.25rem;margin-bottom:1rem;
  transition:var(--transition);
}
.card:hover{border-color:var(--border-strong)}
.card-title{font-size:0.9375rem;font-weight:600;margin-bottom:0.5rem}
.card-desc{font-size:0.8125rem;color:var(--text-dim);line-height:1.6}

/* ===== Capability Grid ===== */
.cap-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
  gap:0.75rem;
}
.cap-card{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--radius);padding:1rem;cursor:pointer;
  transition:var(--transition);position:relative;overflow:hidden;
}
.cap-card:hover{
  border-color:var(--brand-teal);transform:translateY(-2px);
  box-shadow:0 4px 20px rgba(32,184,176,0.1);
}
.cap-card .cap-icon{font-size:1.5rem;margin-bottom:0.5rem}
.cap-card .cap-name{font-size:0.875rem;font-weight:600;margin-bottom:0.25rem}
.cap-card .cap-id{font-size:0.75rem;color:var(--brand-teal);font-family:var(--font-mono)}
.cap-card .cap-desc{font-size:0.75rem;color:var(--text-dim);margin-top:0.375rem}
.cap-card .cap-badge{
  position:absolute;top:0.75rem;right:0.75rem;
  font-size:0.625rem;padding:0.125rem 0.375rem;border-radius:999px;
  background:var(--accent-green);color:#fff;
}

/* ===== Steps ===== */
.steps{display:flex;gap:1rem;margin-bottom:2rem;flex-wrap:wrap}
.step{
  flex:1;min-width:180px;background:var(--bg-card);
  border:1px solid var(--border);border-radius:var(--radius);
  padding:1.25rem;text-align:center;position:relative;
}
.step-num{
  width:32px;height:32px;border-radius:50%;background:var(--brand-dark);
  color:var(--text-bright);display:inline-flex;align-items:center;
  justify-content:center;font-size:0.875rem;font-weight:700;margin-bottom:0.5rem;
}
.step-title{font-size:0.875rem;font-weight:600;margin-bottom:0.25rem}
.step-desc{font-size:0.75rem;color:var(--text-dim)}

/* ===== Code Block ===== */
.code-block{
  background:var(--bg);border:1px solid var(--border);
  border-radius:var(--radius);overflow:hidden;
}
.code-block .code-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:0.5rem 1rem;background:var(--bg-panel);border-bottom:1px solid var(--border);
  font-size:0.75rem;color:var(--text-dim);
}
.code-block .code-header .dot{display:flex;gap:6px}
.code-block .code-header .dot span{
  width:10px;height:10px;border-radius:50%;
}
.code-block .code-header .dot span:nth-child(1){background:#AE3939}
.code-block .code-header .dot span:nth-child(2){background:#B06818}
.code-block .code-header .dot span:nth-child(3){background:#207456}

/* ===== Animations ===== */
@keyframes fadeInUp{
  from{opacity:0;transform:translateY(16px)}
  to{opacity:1;transform:translateY(0)}
}
@keyframes fadeIn{
  from{opacity:0}to{opacity:1}
}
@keyframes pulse{
  0%,100%{opacity:1}
  50%{opacity:0.5}
}
@keyframes slideInLeft{
  from{opacity:0;transform:translateX(-20px)}
  to{opacity:1;transform:translateX(0)}
}
@keyframes shimmer{
  0%{background-position:-200% 0}
  100%{background-position:200% 0}
}
@keyframes drawLine{
  to{stroke-dashoffset:0}
}
@keyframes barGrow{
  from{transform:scaleY(0)}
  to{transform:scaleY(1)}
}
@keyframes dotPulse{
  0%,100%{r:4;opacity:1}
  50%{r:6;opacity:0.6}
}
@keyframes rotate{
  from{transform:rotate(0deg)}
  to{transform:rotate(360deg)}
}
.animate-in{animation:fadeInUp 0.5s ease-out both}
.animate-in:nth-child(1){animation-delay:0.05s}
.animate-in:nth-child(2){animation-delay:0.1s}
.animate-in:nth-child(3){animation-delay:0.15s}
.animate-in:nth-child(4){animation-delay:0.2s}
.animate-in:nth-child(5){animation-delay:0.25s}
.animate-in:nth-child(6){animation-delay:0.3s}
.fade-in{animation:fadeIn 0.4s ease-out}
.slide-in{animation:slideInLeft 0.4s ease-out}

/* ===== Hero ===== */
.hero{
  text-align:center;padding:3rem 1.5rem 2rem;
  background:linear-gradient(180deg,var(--bg-panel) 0%,var(--bg) 100%);
  border-radius:var(--radius);margin-bottom:2rem;
  position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;top:0;left:0;right:0;bottom:0;
  background:radial-gradient(ellipse at 50% 0%,rgba(32,184,176,0.08) 0%,transparent 60%);
}
.hero h1{font-size:2rem;font-weight:700;margin-bottom:0.5rem;position:relative}
.hero .hero-subtitle{font-size:1rem;color:var(--text-dim);margin-bottom:1.5rem;position:relative}
.hero .hero-actions{display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;position:relative}
.btn{
  display:inline-flex;align-items:center;gap:0.5rem;
  padding:0.625rem 1.25rem;border-radius:var(--radius);
  font-size:0.875rem;font-weight:500;transition:var(--transition);
}
.btn-primary{background:var(--brand-teal);color:var(--bg)}
.btn-primary:hover{background:#4DD4CC;transform:translateY(-1px)}
.btn-secondary{background:transparent;color:var(--text);border:1px solid var(--border)}
.btn-secondary:hover{border-color:var(--brand-teal);color:var(--brand-teal)}
.btn-ghost{background:transparent;color:var(--text-dim)}
.btn-ghost:hover{color:var(--text)}

/* ===== Section ===== */
.section-title{
  font-size:1.25rem;font-weight:600;margin-bottom:1rem;
  display:flex;align-items:center;gap:0.5rem;
}
.section-title::after{
  content:'';flex:1;height:1px;background:var(--border);
}

/* ===== Page toggle ===== */
.page{display:none}
.page.active{display:block;animation:fadeIn 0.3s ease-out}
.wb-page{display:none}
.wb-page.active{display:block;animation:fadeIn 0.3s ease-out}

/* ===== Footer ===== */
.footer{
  text-align:center;padding:2rem 1.5rem;border-top:1px solid var(--border);
  margin-top:3rem;font-size:0.75rem;color:var(--text-dim);
}

/* ===== Example Data Panels ===== */
.example-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
  gap:1rem;margin-bottom:1.5rem;
}
.example-panel{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--radius);overflow:hidden;
}
.example-panel-header{
  padding:0.625rem 1rem;background:var(--bg-panel);border-bottom:1px solid var(--border);
  font-size:0.8125rem;font-weight:600;display:flex;align-items:center;gap:0.5rem;
}
.example-panel-body{padding:1rem}
.example-panel-body pre{font-size:0.75rem;margin:0;max-height:200px;overflow-y:auto}

/* ===== SVG Chart Area ===== */
.chart-container{
  background:var(--bg);border:1px solid var(--border);
  border-radius:var(--radius);padding:1rem;margin-bottom:1rem;
  overflow-x:auto;
}
.chart-container svg{display:block;margin:0 auto}

/* ===== Result Table ===== */
.result-table{
  width:100%;border-collapse:collapse;font-size:0.8125rem;
}
.result-table th{
  text-align:left;padding:0.5rem 0.75rem;background:var(--bg-panel);
  border-bottom:2px solid var(--border);color:var(--text-dim);
  font-weight:600;font-size:0.75rem;
}
.result-table td{
  padding:0.5rem 0.75rem;border-bottom:1px solid var(--border);
}
.result-table tr:hover td{background:var(--bg-hover)}
.result-table .mono{font-family:var(--font-mono);font-size:0.75rem;color:var(--brand-teal)}

/* ===== Stat Cards Row ===== */
.stat-row{
  display:flex;gap:0.75rem;margin-bottom:1.25rem;flex-wrap:wrap;
}
.stat-card{
  flex:1;min-width:120px;background:var(--bg-card);
  border:1px solid var(--border);border-radius:var(--radius);
  padding:1rem;text-align:center;
}
.stat-card .stat-value{
  font-size:1.5rem;font-weight:700;color:var(--brand-teal);
}
.stat-card .stat-label{font-size:0.6875rem;color:var(--text-dim);margin-top:0.25rem}
.stat-card .stat-unit{font-size:0.625rem;color:var(--text-dim)}

/* ===== Gallery ===== */
.gallery{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:1rem;margin-bottom:1.5rem;
}
.gallery-item{
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--radius);overflow:hidden;transition:var(--transition);
}
.gallery-item:hover{border-color:var(--brand-teal);transform:translateY(-2px)}
.gallery-item-header{
  padding:0.5rem 1rem;background:var(--bg-panel);border-bottom:1px solid var(--border);
  font-size:0.75rem;font-weight:600;display:flex;align-items:center;gap:0.5rem;
}
.gallery-item-body{padding:0.75rem;display:flex;justify-content:center;align-items:center;min-height:200px;background:var(--bg)}

/* ===== Responsive ===== */
@media(max-width:768px){
  .sidebar{width:60px;min-width:60px}
  .sidebar-brand .logo-text,.sidebar-brand .subtitle,
  .nav-item span,.nav-section{display:none}
  .nav-item{justify-content:center;padding:0.5rem}
  .hero h1{font-size:1.5rem}
  .cap-grid{grid-template-columns:1fr}
  .steps{flex-direction:column}
  .example-grid{grid-template-columns:1fr}
  .stat-row{flex-direction:column}
  .gallery{grid-template-columns:1fr}
}

/* ===== Pipeline Flow（模拟流程动画） ===== */
.pipeline{display:flex;align-items:center;gap:0.4rem;margin-bottom:1.25rem;flex-wrap:wrap}
.pipe-step{display:flex;flex-direction:column;align-items:center;gap:0.4rem}
.pipe-node{
  width:46px;height:46px;border-radius:12px;background:var(--bg-card);
  border:1px solid var(--border);display:flex;align-items:center;justify-content:center;
  font-size:1.25rem;position:relative;transition:var(--transition);
}
.pipe-step:hover .pipe-node{border-color:var(--brand-teal)}
/* 节点状态由运行日志驱动：running 高亮、done 完成 */
.pipe-step.running .pipe-node{border-color:var(--brand-teal);box-shadow:0 0 0 4px rgba(32,184,176,0.16);background:var(--brand-dark)}
.pipe-step.done .pipe-node{border-color:rgba(32,184,176,0.55);background:rgba(32,184,176,0.10)}
.pipe-step.done .pipe-node::after{
  content:'✓';position:absolute;top:-6px;right:-6px;width:16px;height:16px;border-radius:50%;
  background:var(--accent-green);color:#fff;font-size:0.6rem;display:flex;align-items:center;justify-content:center;
}
.pipe-step.running .pipe-node::after{
  content:'';position:absolute;inset:-5px;border-radius:16px;
  border:2px solid var(--brand-teal);opacity:0;animation:pipePulse 1.6s ease-out infinite;
}
@keyframes pipePulse{0%{transform:scale(0.8);opacity:0.7}100%{transform:scale(1.15);opacity:0}}
@keyframes pipePulse{0%{transform:scale(0.8);opacity:0.7}100%{transform:scale(1.15);opacity:0}}
.pipe-name{font-size:0.72rem;color:var(--text-dim);white-space:nowrap}
.pipe-link{flex:1;min-width:22px;max-width:70px}
.pipe-link svg{display:block;width:100%;height:10px;overflow:visible}
.pipe-flow{stroke:var(--brand-teal);stroke-width:1.5;stroke-dasharray:6 6;animation:pipeFlow 1s linear infinite;opacity:0.75}
@keyframes pipeFlow{to{stroke-dashoffset:-12}}
.flow-dot{display:none}

/* ===== Simulated Run Log ===== */
.runlog-body{
  font-family:var(--font-mono);font-size:0.75rem;line-height:1.85;
  padding:0.75rem 1rem;max-height:220px;overflow-y:auto;
}
.runlog .rl-time{color:var(--text-dim)}
.runlog .rl-glyph{display:inline-block;width:1.1em;text-align:center;font-weight:700}
.runlog .rl-glyph.run{color:var(--brand-teal);animation:blink 1s step-end infinite}
.runlog .rl-glyph.ok{color:var(--accent-green)}
.runlog .rl-msg{color:var(--text)}
.runlog-restart{
  background:var(--bg-hover);color:var(--text-dim);border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:0.15rem 0.5rem;font-size:0.7rem;font-family:var(--font);
}
.runlog-restart:hover{color:var(--brand-teal);border-color:var(--brand-teal)}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.2}}
.rl-bar{height:3px;background:var(--bg-hover);position:relative}
.rl-bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--brand-teal),var(--brand-light));transition:width .45s ease}
@media (prefers-reduced-motion:reduce){
  .pipe-flow,.flow-dot,.pipe-step.running .pipe-node::after,.runlog .rl-glyph.run{animation:none}
  .rl-bar i{transition:none}
}

/* ===== 工作台模拟文件选择 ===== */
.sim-files{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:0.75rem;margin-bottom:0.5rem}
.sim-file{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:1rem;cursor:pointer;transition:var(--transition);position:relative;overflow:hidden}
.sim-file:hover{border-color:var(--brand-teal);transform:translateY(-2px)}
.sim-file.selected{border-color:var(--brand-teal);box-shadow:0 0 0 3px rgba(32,184,176,0.18)}
.sim-file .sf-ico{font-size:1.4rem;margin-bottom:0.5rem}
.sim-file .sf-name{font-size:0.8125rem;font-weight:600;font-family:var(--font-mono);word-break:break-all}
.sim-file .sf-meta{font-size:0.6875rem;color:var(--text-dim);margin-top:0.3rem}
.sim-file .sf-check{position:absolute;top:0.6rem;right:0.6rem;width:18px;height:18px;border-radius:50%;background:var(--brand-teal);color:var(--bg);font-size:0.7rem;display:none;align-items:center;justify-content:center;font-weight:700}
.sim-file.selected .sf-check{display:flex;animation:fadeInUp .3s ease-out}

/* ===== Demo Modal（示例流程播放器） ===== */
.demo-modal{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,0.65);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:1.5rem}
.demo-modal.open{display:flex;animation:fadeIn .25s ease-out}
.demo-modal-panel{background:var(--bg-panel);border:1px solid var(--border);border-radius:12px;width:min(860px,96vw);max-height:90vh;overflow-y:auto;box-shadow:0 24px 80px rgba(0,0,0,0.5);animation:fadeInUp .35s ease-out}
.demo-modal-head{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--border)}
.demo-modal-title{font-size:0.9375rem;font-weight:700;font-family:var(--font-mono);color:var(--brand-teal)}
.demo-close{background:var(--bg-hover);color:var(--text-dim);border:1px solid var(--border);border-radius:var(--radius-sm);width:28px;height:28px;font-size:0.9rem;line-height:1}
.demo-close:hover{color:var(--accent-red);border-color:var(--accent-red)}
.demo-body{padding:1.25rem}
.demo-flow{display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;flex-wrap:wrap}
.demo-flow-node{display:flex;align-items:center;gap:0.5rem;padding:0.45rem 0.9rem;border-radius:var(--radius);background:var(--bg-card);border:1px solid var(--border);font-size:0.8125rem}
.demo-flow-node .df-ico{font-size:1.05rem}
.demo-flow-node.done{border-color:var(--brand-teal)}
.demo-flow-node.running{border-color:var(--brand-teal);box-shadow:0 0 0 4px rgba(32,184,176,0.14)}
.demo-flow-node .df-label{color:var(--text-dim);font-size:0.7rem}
