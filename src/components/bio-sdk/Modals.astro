---
const {  } = Astro.props;
---
<!-- ===== Demo Modal（示例流程播放器） ===== -->
<div class="demo-modal" id="demo-modal" onclick="if(event.target===this)closeDemo()">
  <div class="demo-modal-panel">
    <div class="demo-modal-head">
      <span class="demo-modal-title" id="demo-modal-title"></span>
      <button class="demo-close" onclick="closeDemo()" aria-label="Close">✕</button>
    </div>
    <div class="demo-body" id="demo-modal-body"></div>
  </div>
</div>

<!-- ===== Report Preview Modal ===== -->
<div class="demo-modal" id="report-modal" onclick="if(event.target===this)closeReport()">
  <div class="demo-modal-panel">
    <div class="demo-modal-head">
      <span class="demo-modal-title" id="report-modal-title"></span>
      <button class="demo-close" onclick="closeReport()" aria-label="Close">✕</button>
    </div>
    <div class="demo-body" id="report-modal-body"></div>
  </div>
</div>
