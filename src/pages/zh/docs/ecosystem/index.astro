      </div>
      <h2>图形、摄影与 CAD <span style="font-size:0.9rem;color:#64748b;font-weight:400;">(10)</span></h2>
      <div class="app-grid">
        <div class="app-card">
          <h3>Krita</h3>
          <div class="pkg">krita</div>
