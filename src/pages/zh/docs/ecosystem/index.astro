          <div class="pkg">totem</div>
          <p>GNOME 默认视频播放器。</p>
          
        </div>
        <div class="app-card">
          <h3>GNOME Music</h3>
          <div class="pkg">gnome-music</div>
          <p>GNOME 音乐播放器。</p>
          
        </div>
      </div>
