    strong { color: #e2e8f0; }
    a { color: #20B8B0; }
    ul { color: #94a3b8; margin: 0.5rem 0 1rem 1.5rem; }
    li { margin-bottom: 0.3rem; }
    code { background: rgba(30,41,59,0.8); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.85rem; color: #20B8B0; }

    .doc-card { display: block; background: linear-gradient(135deg, rgba(30,41,59,0.6), rgba(14,20,23,0.8)); border: 1px solid rgba(51,65,85,0.5); border-radius: 12px; padding: 1.5rem; margin: 1rem 0; text-decoration: none; transition: border-color 0.3s; }
    .doc-card:hover { border-color: rgba(32,184,176,0.4); }
    .doc-card h3 { color: #20B8B0; margin-bottom: 0.3rem; font-size: 1.1rem; }
    .doc-card p { font-size: 0.9rem; margin: 0; color: #94a3b8; }

    .keyword { display: inline-block; font-size: 0.7rem; background: rgba(32,184,176,0.15); color: #20B8B0; padding: 0.15rem 0.5rem; border-radius: 4px; margin: 0.2rem; }

    footer { text-align: center; padding: 3rem 2rem; color: #475569; font-size: 0.85rem; border-top: 1px solid rgba(51,65,85,0.3); margin-left: 260px; }

    @media (max-width: 768px) { .sidebar { display: none; } .main { margin-left: 0; padding: 2rem; } footer { margin-left: 0; } }
  </style>
