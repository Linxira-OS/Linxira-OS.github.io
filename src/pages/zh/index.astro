  <script>
    // ---------- 深浅主题切换（宣传页浅色/文档页保持深色） ----------
    const themeBtn = document.getElementById('themeToggle');
    const applyTheme = (t) => {
      document.documentElement.dataset.theme = t;
      if (themeBtn) themeBtn.textContent = t === 'dark' ? '浅色' : '深色';
    };
    applyTheme(document.documentElement.dataset.theme || 'dark');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('linxira-theme', next);
        applyTheme(next);
      });
    }

    // ---------- 滚动揭示 ----------
    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('in'));
    }

    // ---------- 粒子网络背景（+鼠标引力交互） ----------
    const canvas = document.getElementById('particles');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      let W = 0, H = 0, particles = [];
      const COUNT = window.innerWidth < 768 ? 40 : 80;
      const LINK = 120;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mouse = { x: -9999, y: -9999 };

      function resize() {
        W = canvas.width = canvas.offsetWidth;
        H = canvas.height = canvas.offsetHeight;
      }
      function spawn() {
        particles = Array.from({ length: COUNT }, () => ({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          r: Math.random() * 1.6 + 0.8,
        }));
      }
      function draw() {
        ctx.clearRect(0, 0, W, H);
        for (const p of particles) {
          // 鼠标引力：靠近时轻微加速（科技互动感）
          const dx = mouse.x - p.x, dy = mouse.y - p.y;
          const md = Math.hypot(dx, dy);
          if (md < 160 && md > 0.001) {
            p.vx += (dx / md) * 0.02;
            p.vy += (dy / md) * 0.02;
          }
          p.vx *= 0.99; p.vy *= 0.99;
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > W) p.vx *= -1;
          if (p.y < 0 || p.y > H) p.vy *= -1;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(32,184,176,0.55)';
          ctx.fill();
        }
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const d = Math.hypot(dx, dy);
            if (d < LINK) {
              const a = 1 - d / LINK;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.strokeStyle = `rgba(32,184,176,${0.16 * a})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
        }
        if (!reduceMotion) requestAnimationFrame(draw);
      }
      resize(); spawn(); draw();
      window.addEventListener('resize', () => { resize(); spawn(); });
      canvas.addEventListener('mousemove', (e) => {
        const r = canvas.getBoundingClientRect();
        mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
      });
      canvas.addEventListener('mouseleave', () => { mouse.x = -9999; mouse.y = -9999; });
    }

    // ---------- 终端打字机演示（循环执行命令序列） ----------
    const termBody = document.getElementById('termBody');
    if (termBody && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const termScript = [
        { cmd: 'linxira-config headless on now', out: '已切换到无头模式：桌面已停止，内存全给计算 ✓' },
        { cmd: 'linxira-config ssh on', out: 'SSH 已开启：ssh user@192.168.1.42 ✓' },
        { cmd: 'linxira-update', out: '已是最新：上游补丁 0 个待装 ✓' },
        { cmd: 'linxira-config timeshift status', out: '快照：每日 3 份 · 启动 3 份 · 更新前自动快照 ✓' },
      ];
      const typeSpeed = 26, holdMs = 1100, gapMs = 350;
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      (async () => {
        while (true) {
          for (const s of termScript) {
            const line = document.createElement('div');
            line.className = 'term-line';
            line.innerHTML = '<span class="term-prompt">$</span> <span class="term-typing"></span>';
            termBody.appendChild(line);
            const t = line.querySelector('.term-typing');
            for (const ch of s.cmd) { t.textContent += ch; await sleep(typeSpeed); }
            await sleep(gapMs);
            const out = document.createElement('div');
            out.className = 'term-out';
            out.textContent = s.out;
            termBody.appendChild(out);
            termBody.scrollTop = termBody.scrollHeight;
            await sleep(holdMs);
          }
          termBody.innerHTML = '';
        }
      })();
    }

    // ---------- 数字滚动动画（count-up） ----------
    const statEls = document.querySelectorAll('.stat-num[data-count]');
    if (statEls.length && 'IntersectionObserver' in window) {
      const animate = (el) => {
        const target = parseInt(el.dataset.count, 10);
        const dur = 1200;
        const t0 = performance.now();
        const step = (now) => {
          const p = Math.min((now - t0) / dur, 1);
          el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const sio = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { animate(e.target); sio.unobserve(e.target); } });
      }, { threshold: 0.4 });
      statEls.forEach((el) => sio.observe(el));
    } else {
      statEls.forEach((el) => { el.textContent = el.dataset.count; });
    }

    // ---------- 产品卡片 3D 倾斜跟随 + 光晕定位（hero 主打卡 + 大区卡） ----------
    const cards = document.querySelectorAll('.pcard, .show-card');
    if (cards.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      cards.forEach((card) => {
        const onMove = (ev) => {
          const r = card.getBoundingClientRect();
          const px = (ev.clientX - r.left) / r.width;
          const py = (ev.clientY - r.top) / r.height;
          card.style.setProperty('--mx', `${px * 100}%`);
          card.style.setProperty('--my', `${py * 100}%`);
          const rx = (0.5 - py) * 10;
          const ry = (px - 0.5) * 10;
          card.style.transform = `translateY(-5px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        };
        const onLeave = () => { card.style.transform = ''; };
        card.addEventListener('mousemove', onMove);
        card.addEventListener('mouseleave', onLeave);
      });
    }
  </script>
</body>
</html>
