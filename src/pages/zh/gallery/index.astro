  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="图片放大">
    <button class="lb-close" id="lbClose" aria-label="关闭">✕</button>
    <button class="lb-prev" id="lbPrev" aria-label="上一张">‹</button>
    <div class="lb-body" id="lbBody"></div>
    <button class="lb-next" id="lbNext" aria-label="下一张">›</button>
    <div class="lb-cap" id="lbCap"></div>
  </div>

  <style>
    .subtitle { color: var(--muted); margin-bottom: 0.3rem; }
    .gal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-top: 1.5rem; }
    .gal-card { border-radius: 18px; overflow: hidden; cursor: zoom-in; transition: transform 0.3s, border-color 0.3s; margin: 0; }
    .gal-card:hover { transform: translateY(-4px); border-color: rgba(32,184,176,0.45); }
    .gal-card svg { display: block; width: 100%; height: auto; }
    .gal-card figcaption { padding: 0.9rem 1.1rem 1rem; display: flex; flex-direction: column; gap: 0.2rem; border-top: 1px solid rgba(255,255,255,0.06); }
    .gal-card figcaption b { color: var(--ink-strong); font-size: 0.98rem; }
    .gal-card figcaption span { color: var(--faint); font-size: 0.82rem; }
    .lightbox { position: fixed; inset: 0; background: rgba(4,8,12,0.92); z-index: 999; display: none; align-items: center; justify-content: center; flex-direction: column; backdrop-filter: blur(6px); }
    .lightbox.open { display: flex; }
    .lb-body { width: min(1100px, 92vw); }
    .lb-body svg { width: 100%; height: auto; border-radius: 14px; box-shadow: 0 30px 90px rgba(0,0,0,0.7); }
    .lb-cap { color: var(--soft); font-size: 0.92rem; margin-top: 1rem; text-align: center; max-width: 720px; }
    .lb-close, .lb-prev, .lb-next { position: absolute; background: rgba(20,27,38,0.8); border: 1px solid var(--line); color: var(--ink-strong); width: 44px; height: 44px; border-radius: 50%; font-size: 1.2rem; cursor: pointer; transition: all 0.2s; z-index: 2; }
    .lb-close:hover, .lb-prev:hover, .lb-next:hover { border-color: var(--teal); color: var(--teal); }
    .lb-close { top: 1.4rem; right: 1.4rem; }
    .lb-prev { left: 1.4rem; top: 50%; transform: translateY(-50%); }
    .lb-next { right: 1.4rem; top: 50%; transform: translateY(-50%); }
    @media (max-width: 768px) { .gal-grid { grid-template-columns: 1fr; } .lb-prev { left: 0.6rem; } .lb-next { right: 0.6rem; } }
  </style>

  <script>
    const gals = Array.from(document.querySelectorAll('.gal-card'));
    const lb = document.getElementById('lightbox');
    const lbBody = document.getElementById('lbBody');
    const lbCap = document.getElementById('lbCap');
    let cur = 0;
    const show = (i) => {
      cur = (i + gals.length) % gals.length;
      lbBody.innerHTML = '';
      lbBody.appendChild(gals[cur].querySelector('svg').cloneNode(true));
      lbCap.textContent = gals[cur].dataset.cap;
    };
    gals.forEach((g, i) => g.addEventListener('click', () => { show(i); lb.classList.add('open'); }));
    document.getElementById('lbClose').addEventListener('click', () => lb.classList.remove('open'));
    document.getElementById('lbPrev').addEventListener('click', () => show(cur - 1));
    document.getElementById('lbNext').addEventListener('click', () => show(cur + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.classList.remove('open'); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') lb.classList.remove('open');
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });
  </script>
</PageLayout>
