<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>Zeta</title>
	<script is:inline>
		const lang = navigator.language.startsWith('zh') ? 'zh' : 'en';
		window.location.replace('/zeta/' + lang + '/');
	</script>
</head>
<body>
	<p>Redirecting... <a href="/zeta/en/">English</a> | <a href="/zeta/zh/">中文</a></p>
</body>
</html>
