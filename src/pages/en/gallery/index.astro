        <rect x="414" y="128" width="16" height="152" rx="2" fill="#31679E" opacity="0.8"/>
        <line x1="252" y1="280" x2="560" y2="280" stroke="#374151"/>
        <rect x="600" y="58" width="310" height="120" rx="10" fill="#141b26" stroke="#1f2937"/>
        <circle cx="630" cy="108" r="5" fill="#20B8B0"/><text x="644" y="112" fill="#94a3b8" font-size="12">Read FASTQ data</text>
        <circle cx="630" cy="132" r="5" fill="#20B8B0"/><text x="644" y="136" fill="#94a3b8" font-size="12">QC statistics</text>
