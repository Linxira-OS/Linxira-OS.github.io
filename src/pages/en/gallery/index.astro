        <circle cx="480" cy="180" r="150" fill="#232f44"/>
        <path d="M480 60 a120 120 0 0 1 0 240 a120 120 0 0 1 0 -240" fill="none" stroke="#20B8B0" stroke-width="10" opacity="0.85"/>
        <circle cx="480" cy="180" r="46" fill="#141b26" stroke="#20B8B0" stroke-width="3"/>
