        <text x="48" y="158" fill="#94a3b8" font-size="13" font-family="monospace">● headless.service — compute-mode daemon</text>
        <text x="48" y="178" fill="#cbd5e1" font-size="13" font-family="monospace">     Active: active (running) since 08:02:14</text>
        <text x="48" y="198" fill="#cbd5e1" font-size="13" font-family="monospace">     Memory: desktop stopped · 11.2 GiB freed</text>
        <rect x="48" y="218" width="560" height="14" rx="7" fill="#1f2937"/>
        <rect x="48" y="218" width="470" height="14" rx="7" fill="#20B8B0"/>
        <text x="622" y="230" fill="#94a3b8" font-size="12" font-family="monospace">84% for compute</text>
        <text x="48" y="266" fill="#20B8B0" font-size="14" font-family="monospace">$ nvidia-smi</text>
        <text x="48" y="294" fill="#cbd5e1" font-size="13" font-family="monospace">RTX 5090 · 32 GB · 412 W · 61°C</text>
        <rect x="48" y="330" width="560" height="14" rx="7" fill="#1f2937"/>
        <rect x="48" y="330" width="486" height="14" rx="7" fill="#F36F5D"/>
        <text x="622" y="342" fill="#94a3b8" font-size="12" font-family="monospace">87% utilization</text>
        <text x="48" y="390" fill="#20B8B0" font-size="14" font-family="monospace">$ linxira-config headless off</text>
        <text x="48" y="418" fill="#94a3b8" font-size="13" font-family="monospace">→ Back to desktop mode · welcome back ✓</text>
      </svg>
      <figcaption><b>Headless Compute Mode</b><span>One command to switch: zero desktop overhead, all RAM &amp; GPU for compute</span></figcaption>
    </figure>

    <!-- 3 Bio SDK -->
