        <circle cx="120" cy="90" r="180" fill="#20B8B0" opacity="0.10"/>
        <circle cx="840" cy="420" r="220" fill="#F36F5D" opacity="0.08"/>
        <line x1="0" y1="46" x2="960" y2="46" stroke="#000" stroke-width="46" opacity="0.55"/>
        <circle cx="30" cy="23" r="7" fill="#20B8B0"/>
        <text x="48" y="27" fill="#cbd5e1" font-size="14">Launcher</text>
        <text x="860" y="27" fill="#cbd5e1" font-size="13" text-anchor="end">9:41 · Fri</text>
        <rect x="120" y="120" width="520" height="300" rx="10" fill="#111827" stroke="#374151"/>
        <rect x="120" y="120" width="520" height="34" rx="10" fill="#1b2434"/>
        <circle cx="148" cy="137" r="6" fill="#ff5f57"/><circle cx="168" cy="137" r="6" fill="#febc2e"/><circle cx="188" cy="137" r="6" fill="#28c840"/>
        <text x="140" y="185" fill="#20B8B0" font-size="14" font-family="monospace">$ linxira-config headless on now</text>
        <text x="140" y="210" fill="#64748b" font-size="13" font-family="monospace">→ Headless: desktop stopped, RAM freed ✓</text>
        <text x="140" y="240" fill="#20B8B0" font-size="14" font-family="monospace">$ linxira-update</text>
        <text x="140" y="265" fill="#64748b" font-size="13" font-family="monospace">→ Up to date: 0 patches pending ✓</text>
        <rect x="680" y="140" width="230" height="200" rx="10" fill="#111827" stroke="#374151"/>
        <text x="795" y="160" fill="#64748b" font-size="12" text-anchor="middle">File Manager</text>
        <rect x="696" y="182" width="198" height="18" rx="4" fill="#0d131c"/>
        <text x="704" y="195" fill="#64748b" font-size="11">~/research/RNA-seq</text>
        <rect x="696" y="208" width="198" height="16" rx="3" fill="#20B8B0" opacity="0.14"/>
        <text x="704" y="220" fill="#cbd5e1" font-size="11">sample_R1.fastq.gz</text>
        <line x1="0" y1="502" x2="960" y2="502" stroke="#000" stroke-width="38" opacity="0.55"/>
        <rect x="430" y="509" width="100" height="24" rx="6" fill="#20B8B0" opacity="0.25"/>
        <text x="480" y="526" fill="#a7f3d0" font-size="11" text-anchor="middle">Terminal · active</text>
      </svg>
      <figcaption><b>KDE Plasma Desktop</b><span>Ready out of the box: Bluetooth / Wi-Fi / printing / Chinese IME</span></figcaption>
    </figure>

    <!-- 2 Headless -->
    <figure class="gal-card glass reveal reveal-d1" data-cap="Headless compute mode · One command to switch: zero desktop overhead, all RAM &amp; GPU for compute">
      <svg viewBox="0 0 960 540">
        <rect width="960" height="540" fill="#050a0f"/>
        <text x="48" y="60" fill="#20B8B0" font-size="15" font-family="monospace">linxira — headless compute mode</text>
