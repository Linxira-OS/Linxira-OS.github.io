        <rect x="240" y="320" width="670" height="180" rx="10" fill="#141b26" stroke="#1f2937"/>
        <text x="260" y="348" fill="#cbd5e1" font-size="13" font-weight="600">Comparison · Species: Homo sapiens</text>
        <text x="276" y="379" fill="#64748b" font-size="11">Sample</text><text x="420" y="379" fill="#64748b" font-size="11">Reads</text><text x="560" y="379" fill="#64748b" font-size="11">Avg quality</text><text x="700" y="379" fill="#64748b" font-size="11">Status</text>
        <rect x="260" y="392" width="630" height="24" rx="4" fill="#111827"/>
        <text x="276" y="409" fill="#cbd5e1" font-size="11">sample_A</text><text x="420" y="409" fill="#cbd5e1" font-size="11">20,000</text><text x="560" y="409" fill="#cbd5e1" font-size="11">Q36.2</text><text x="700" y="409" fill="#a7f3d0" font-size="11">✓ Passed</text>
      </svg>
      <figcaption><b>Bio SDK Local Workbench</b><span>Data never leaves your machine: QC / alignment / enrichment, fully visualized</span></figcaption>
    </figure>

    <!-- 4 Ecosystem -->
    <figure class="gal-card glass reveal reveal-d1" data-cap="Signed [linxira] repository · 93 curated apps in 14 categories, pacman-tracked updates">
      <svg viewBox="0 0 960 540">
        <rect width="960" height="540" fill="#0a1119"/>
        <text x="48" y="50" fill="#20B8B0" font-size="15" font-weight="700">[linxira] signed repo · catalog v3</text>
        <rect x="48" y="70" width="864" height="1" fill="#1f2937"/>
        <text x="48" y="106" fill="#20B8B0" font-size="14" font-family="monospace">$ pacman -Ss bioinformatics</text>
        <rect x="48" y="128" width="700" height="40" rx="8" fill="#111827"/>
        <circle cx="76" cy="148" r="6" fill="#20B8B0"/>
        <text x="92" y="152" fill="#cbd5e1" font-size="13" font-family="monospace">bioconductor-biocparallel 1.40.0  [linxira]</text>
        <rect x="48" y="176" width="700" height="40" rx="8" fill="#111827"/>
        <circle cx="76" cy="196" r="6" fill="#20B8B0"/>
        <text x="92" y="200" fill="#cbd5e1" font-size="13" font-family="monospace">rstudio-desktop 2026.08   [linxira]</text>
        <rect x="48" y="224" width="700" height="40" rx="8" fill="#111827"/>
        <circle cx="76" cy="244" r="6" fill="#20B8B0"/>
        <text x="92" y="248" fill="#cbd5e1" font-size="13" font-family="monospace">python-numpy 2.2.1       [core]</text>
        <rect x="48" y="280" width="700" height="1" fill="#1f2937"/>
        <text x="48" y="316" fill="#94a3b8" font-size="13">Audited categories:</text>
        <text x="48" y="344" fill="#cbd5e1" font-size="13">Scientific Desktop · Development · Bioinformatics · Containers · AI Coding · Gaming</text>
        <text x="48" y="376" fill="#94a3b8" font-size="13">14 categories · 93 curated apps · license / source / availability reviewed</text>
        <rect x="48" y="410" width="260" height="52" rx="10" fill="#20B8B0" opacity="0.14"/>
        <text x="68" y="432" fill="#a7f3d0" font-size="13" font-weight="600">17 first-party tools</text>
        <text x="68" y="450" fill="#94a3b8" font-size="12">Welcome → Config Hub → Components</text>
        <rect x="330" y="410" width="260" height="52" rx="10" fill="#F36F5D" opacity="0.12"/>
        <text x="350" y="432" fill="#fecaca" font-size="13" font-weight="600">Signature checks</text>
        <text x="350" y="450" fill="#94a3b8" font-size="12">pacman enforces package signatures</text>
      </svg>
