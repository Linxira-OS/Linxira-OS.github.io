    .product-card:hover { transform: translateY(-4px); border-color: rgba(32,184,176,0.5); }
    .product-card .product-mark { font-size: 1.8rem; font-weight: 800; margin-bottom: 0.6rem; display: inline-block; }
    .product-card.zeta-card .product-mark { color: #E20613; }
    .product-card.bio-card .product-mark { color: #20B8B0; }
    .product-card h3 { color: #e2e8f0; font-size: 1.25rem; margin-bottom: 0.5rem; }
    .product-card p { color: #94a3b8; font-size: 0.9rem; line-height: 1.55; margin-bottom: 1rem; }
    .product-card .product-go { color: #20B8B0; font-size: 0.85rem; font-weight: 600; }
    .product-card.zeta-card .product-go { color: #E20613; }

    .blog-section { background: linear-gradient(180deg, #0a0f1a 0%, #0E1417 100%); padding: 5rem 0; }
    .blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
    .blog-card { background: linear-gradient(135deg, rgba(30,41,59,0.6), rgba(14,20,23,0.8)); border: 1px solid rgba(51,65,85,0.5); border-radius: 16px; padding: 1.5rem; text-decoration: none; transition: transform 0.3s, border-color 0.3s; }
    .blog-card:hover { transform: translateY(-4px); border-color: rgba(32,184,176,0.4); }
    .blog-date { font-size: 0.8rem; color: #64748b; margin-bottom: 0.5rem; }
    .blog-title { font-size: 1.2rem; font-weight: 600; color: #e2e8f0; margin-bottom: 0.5rem; }
    .blog-desc { color: #94a3b8; font-size: 0.9rem; line-height: 1.5; }
    .blog-tag { display: inline-block; font-size: 0.7rem; background: rgba(32,184,176,0.15); color: #20B8B0; padding: 0.2rem 0.6rem; border-radius: 4px; margin-top: 0.75rem; }

    .release-section { padding: 4rem 0; }
    .release-card { background: linear-gradient(135deg, rgba(30,41,59,0.8), rgba(14,20,23,0.9)); border: 1px solid rgba(51,65,85,0.5); border-radius: 16px; padding: 2.5rem; text-align: center; max-width: 800px; margin: 0 auto; }
    .release-card h3 { color: #e2e8f0; font-size: 1.4rem; margin-bottom: 0.8rem; }
