    .hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 8rem 2rem 5rem; overflow: hidden; }
    .hero::before { content: ''; position: absolute; top: -40%; left: -20%; width: 80vw; height: 80vw; background: radial-gradient(circle, rgba(32,184,176,0.12) 0%, transparent 70%); animation: drift 20s ease-in-out infinite alternate; pointer-events: none; }
    .hero::after { content: ''; position: absolute; bottom: -30%; right: -15%; width: 70vw; height: 70vw; background: radial-gradient(circle, rgba(243,111,93,0.10) 0%, transparent 70%); animation: drift 25s ease-in-out infinite alternate-reverse; pointer-events: none; }
    @keyframes drift { 0% { transform: translate(0,0) scale(1); } 100% { transform: translate(40px,-30px) scale(1.05); } }
    .grid-bg { position: absolute; inset: 0; background-image: linear-gradient(rgba(32,184,176,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(32,184,176,0.04) 1px, transparent 1px); background-size: 60px 60px; pointer-events: none; }
    .prism-deco { position: absolute; width: 0; height: 0; border-left: 80px solid transparent; border-right: 80px solid transparent; border-bottom: 140px solid rgba(32,184,176,0.06); top: 15%; left: 8%; transform: rotate(15deg); pointer-events: none; }
    .prism-deco-2 { position: absolute; width: 0; height: 0; border-left: 60px solid transparent; border-right: 60px solid transparent; border-bottom: 100px solid rgba(243,111,93,0.05); bottom: 20%; right: 10%; transform: rotate(-20deg); pointer-events: none; }
    .beam { position: absolute; height: 2px; background: linear-gradient(90deg, transparent, rgba(32,184,176,0.15), rgba(243,111,93,0.15), transparent); pointer-events: none; }
    .beam-1 { top: 30%; left: 0; width: 100%; transform: rotate(-5deg); }
    .beam-2 { top: 60%; left: 0; width: 100%; transform: rotate(3deg); }
    .beam-3 { top: 45%; left: 0; width: 100%; transform: rotate(-2deg); opacity: 0.5; }

    .hero-content { position: relative; z-index: 1; max-width: 1000px; }
    .hero-logo { width: 140px; height: 140px; margin-bottom: 2rem; filter: drop-shadow(0 0 40px rgba(32,184,176,0.3)); }
    .hero h1 { font-size: 3.5rem; font-weight: 700; background: linear-gradient(135deg, #20B8B0, #E8F7F6, #F36F5D); background-size: 200% 200%; animation: gradient-shift 6s ease infinite; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 0.5rem; }
    @keyframes gradient-shift { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
    .tagline { font-size: 1.3rem; color: #94a3b8; margin-bottom: 0.3rem; }
    .en-tagline { font-size: 1rem; color: #64748b; margin-bottom: 2rem; letter-spacing: 3px; text-transform: uppercase; }
    .hero-desc { max-width: 760px; margin: 0 auto 2.5rem; color: #cbd5e1; font-size: 1.02rem; }
    .hero-desc strong { color: #20B8B0; }
    .hero-ctas { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem; }
    .cta { display: inline-block; padding: 1rem 2.5rem; background: linear-gradient(135deg, #20B8B0, #F36F5D); color: white; font-weight: 600; border-radius: 10px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 20px rgba(32,184,176,0.3); }
    .cta:hover { transform: translateY(-2px); box-shadow: 0 6px 30px rgba(32,184,176,0.4); text-decoration: none; }
    .cta-ghost { display: inline-block; padding: 1rem 2rem; color: #e2e8f0; border: 1px solid rgba(51,65,85,0.8); border-radius: 10px; text-decoration: none; font-weight: 500; transition: all 0.2s; }
    .cta-ghost:hover { border-color: #20B8B0; color: #20B8B0; text-decoration: none; }

    .badges { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
    .zeta-feature { display: block; text-decoration: none; background: linear-gradient(135deg, rgba(30,41,59,0.8), rgba(14,20,23,0.9)); border: 1px solid rgba(51,65,85,0.5); border-radius: 16px; padding: 1.5rem; text-align: left; backdrop-filter: blur(10px); transition: transform 0.3s, border-color 0.3s; max-width: 620px; margin: -1rem auto 2.5rem; }
    .zeta-feature:hover { transform: translateY(-4px); border-color: rgba(226,6,19,0.5); }
    .zeta-feature h3 { color: #e2e8f0; margin-bottom: 0.5rem; font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem; }
    .zeta-feature h3 .zeta-mark { color: #E20613; font-weight: 800; }
    .zeta-feature p { color: #94a3b8; font-size: 0.88rem; line-height: 1.5; }
    .zeta-feature .zeta-go { color: #E20613; font-size: 0.82rem; margin-top: 0.6rem; display: inline-block; }
    .badge { font-size: 0.8rem; background: rgba(32,184,176,0.12); color: #20B8B0; padding: 0.35rem 1rem; border-radius: 999px; border: 1px solid rgba(32,184,176,0.25); }
    .badge-coral { background: rgba(243,111,93,0.12); color: #F36F5D; border-color: rgba(243,111,93,0.25); }

    .section-block { padding: 5rem 0; }
    .section-block-alt { background: linear-gradient(180deg, #0E1417 0%, #141a26 100%); }
    .section-block-alt2 { background: linear-gradient(180deg, #0a0f1a 0%, #0E1417 100%); }
    .section { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
    .section-header { text-align: center; margin-bottom: 3rem; }
    .section-title { font-size: 2.2rem; font-weight: 700; margin-bottom: 0.5rem; background: linear-gradient(135deg, #20B8B0, #F36F5D); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .section-subtitle { color: #64748b; font-size: 1rem; }
    .section-divider { width: 60px; height: 3px; margin: 1rem auto 0; background: linear-gradient(90deg, #20B8B0, #F36F5D); border-radius: 2px; }

    .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; }
    .feature { background: linear-gradient(135deg, rgba(30,41,59,0.8), rgba(14,20,23,0.9)); border: 1px solid rgba(51,65,85,0.5); border-radius: 16px; padding: 1.6rem; text-align: left; backdrop-filter: blur(10px); transition: transform 0.3s, border-color 0.3s; }
    .feature:hover { transform: translateY(-4px); border-color: rgba(32,184,176,0.4); }
    .feature .feature-icon { font-size: 1.6rem; margin-bottom: 0.7rem; display: block; }
    .feature h3 { color: #20B8B0; margin-bottom: 0.5rem; font-size: 1.08rem; }
    .feature p { color: #94a3b8; font-size: 0.88rem; line-height: 1.55; }

    .about-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
    .about-text h3 { color: #e2e8f0; font-size: 1.4rem; margin-bottom: 1rem; }
    .about-text p { color: #94a3b8; margin-bottom: 1rem; font-size: 0.95rem; }
    .about-text strong { color: #20B8B0; }
    .about-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .stat-card { background: linear-gradient(135deg, rgba(30,41,59,0.7), rgba(14,20,23,0.9)); border: 1px solid rgba(51,65,85,0.5); border-radius: 14px; padding: 1.4rem; text-align: center; }
    .stat-num { font-size: 2rem; font-weight: 700; background: linear-gradient(135deg, #20B8B0, #F36F5D); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stat-label { color: #94a3b8; font-size: 0.8rem; margin-top: 0.3rem; }

    .ecosystem-link { display: block; background: linear-gradient(135deg, rgba(30,41,59,0.8), rgba(14,20,23,0.9)); border: 1px solid rgba(51,65,85,0.5); border-radius: 16px; padding: 2rem; text-align: center; text-decoration: none; transition: transform 0.3s, border-color 0.3s; }
    .ecosystem-link:hover { transform: translateY(-4px); border-color: rgba(32,184,176,0.5); }
