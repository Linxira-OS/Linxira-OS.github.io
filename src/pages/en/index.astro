  <footer><p>Linxira OS is built directly on Arch Linux; an independent project with no affiliation to or endorsement by Arch Linux. Brand assets: <a href="/en/legal/brand-assets/" style="color:#64748b;">Brand Asset Policy</a>.</p></footer>

  <script>
    // ---------- 滚动揭示 ----------
    const revealEls = document.querySelectorAll('.reveal');
    if (revealEls.length) {
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('in'));
      }
    }

    // ---------- 粒子网络背景（+鼠标引力交互） ----------
    const canvas = document.getElementById('particles');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      let W = 0, H = 0, particles = [];
      const COUNT = window.innerWidth < 768 ? 40 : 80;
      const LINK = 120;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mouse = { x: -9999, y: -9999 };

      function resize() { W = canvas.width = canvas.offsetWidth; H = canvas.height = canvas.offsetHeight; }
      function spawn() {
        particles = Array.from({ length: COUNT }, () => ({
          x: Math.random() * W, y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4,
          r: Math.random() * 1.6 + 0.8,
        }));
      }
      function draw() {
        ctx.clearRect(0, 0, W, H);
        for (const p of particles) {
          const dx = mouse.x - p.x, dy = mouse.y - p.y;
          const md = Math.hypot(dx, dy);
          if (md < 160 && md > 0.001) { p.vx += (dx / md) * 0.02; p.vy += (dy / md) * 0.02; }
          p.vx *= 0.99; p.vy *= 0.99;
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > W) p.vx *= -1;
          if (p.y < 0 || p.y > H) p.vy *= -1;
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(32,184,176,0.55)'; ctx.fill();
        }
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const d = Math.hypot(dx, dy);
            if (d < LINK) {
              const a = 1 - d / LINK;
              ctx.beginPath(); ctx.moveTo(particles[i].x, particles[i].y); ctx.lineTo(particles[j].x, particles[j].y);
              ctx.strokeStyle = `rgba(32,184,176,${0.16 * a})`; ctx.lineWidth = 1; ctx.stroke();
            }
          }
        }
        if (!reduceMotion) requestAnimationFrame(draw);
      }
      resize(); spawn(); draw();
      window.addEventListener('resize', () => { resize(); spawn(); });
      canvas.addEventListener('mousemove', (e) => {
        const r = canvas.getBoundingClientRect();
        mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
      });
      canvas.addEventListener('mouseleave', () => { mouse.x = -9999; mouse.y = -9999; });
    }

    // ---------- Terminal typewriter demo (looping command sequence) ----------
    const termBody = document.getElementById('termBody');
    // dataset guards against duplicate loops on HMR/script re-runs
    if (termBody && !termBody.dataset.started && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      termBody.dataset.started = '1';
      const termScript = [
        { cmd: 'linxira-config headless on now', out: 'Switched to headless: desktop stopped, RAM freed for compute ✓' },
        { cmd: 'linxira-config ssh on', out: 'SSH enabled: ssh user@192.168.1.42 ✓' },
        { cmd: 'linxira-update', out: 'Up to date: 0 upstream patches pending ✓' },
        { cmd: 'linxira-config timeshift status', out: 'Snapshots: daily 3 · boot 3 · auto-snapshot before updates ✓' },
      ];
      const typeSpeed = 26, holdMs = 1300, gapMs = 350, fullShowMs = 4500;
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      (async () => {
        while (true) {
          termBody.innerHTML = ''; // clean start for every round
          for (const s of termScript) {
            const line = document.createElement('div');
            line.className = 'term-line';
            line.innerHTML = '<span class="term-prompt">$</span> <span class="term-typing"></span>';
            termBody.appendChild(line);
            const t = line.querySelector('.term-typing');
            for (const ch of s.cmd) { t.textContent += ch; await sleep(typeSpeed); }
            await sleep(gapMs);
            const out = document.createElement('div');
            out.className = 'term-out';
            out.textContent = s.out;
            termBody.appendChild(out);
            termBody.scrollTop = termBody.scrollHeight;
            await sleep(holdMs);
          }
          // full listing stays visible before the next round
          await sleep(fullShowMs);
        }
      })();
    }

    // ---------- 数字滚动动画（count-up） ----------
    const statEls = document.querySelectorAll('.stat-num[data-count]');
    if (statEls.length && 'IntersectionObserver' in window) {
      const animate = (el) => {
        const target = parseInt(el.dataset.count, 10);
        const dur = 1200;
        const t0 = performance.now();
        const step = (now) => {
          const p = Math.min((now - t0) / dur, 1);
          el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const sio = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { animate(e.target); sio.unobserve(e.target); } });
      }, { threshold: 0.4 });
      statEls.forEach((el) => sio.observe(el));
    } else {
      statEls.forEach((el) => { el.textContent = el.dataset.count; });
    }

    // ---------- 产品卡片 3D 倾斜跟随 + 光晕定位（hero 主打卡 + 大区卡） ----------
    const cards = document.querySelectorAll('.pcard, .show-card');
    if (cards.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      cards.forEach((card) => {
        const onMove = (ev) => {
          const r = card.getBoundingClientRect();
          const px = (ev.clientX - r.left) / r.width;
          const py = (ev.clientY - r.top) / r.height;
          card.style.setProperty('--mx', `${px * 100}%`);
          card.style.setProperty('--my', `${py * 100}%`);
          const rx = (0.5 - py) * 10;
          const ry = (px - 0.5) * 10;
          card.style.transform = `translateY(-5px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        };
        const onLeave = () => { card.style.transform = ''; };
        card.addEventListener('mousemove', onMove);
        card.addEventListener('mouseleave', onLeave);
      });
    }

    // ---------- Highlight slideshow (auto-play · arrows / dots / hover pause) ----------
    const slideshow = document.getElementById('slideshow');
    if (slideshow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const slides = Array.from(slideshow.querySelectorAll('.slide'));
      const dots = Array.from(slideshow.querySelectorAll('.slide-dots button'));
      const prev = slideshow.querySelector('.nav-prev');
      const next = slideshow.querySelector('.nav-next');
      let cur = 0, timer = null;
      const go = (n) => {
        cur = (n + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('active', i === cur));
        dots.forEach((d, i) => d.classList.toggle('active', i === cur));
      };
      const play = () => { if (!timer) timer = setInterval(() => go(cur + 1), 5200); };
      const pause = () => { if (timer) { clearInterval(timer); timer = null; } };
      dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
      prev.addEventListener('click', () => go(cur - 1));
      next.addEventListener('click', () => go(cur + 1));
      slideshow.addEventListener('mouseenter', pause);
      slideshow.addEventListener('mouseleave', play);
      play();
    }
  </script>
