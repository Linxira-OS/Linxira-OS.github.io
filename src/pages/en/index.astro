---
import Navbar from "../../components/Navbar.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Linxira OS — Arch Linux for Scientific Computing</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <meta name="theme-color" content="#0E1417" media="(prefers-color-scheme: dark)">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #0E1417; --bg-deep: #0a0f1a; --bg-alt: #141a26;
      --ink: #e5e7eb; --ink-strong: #f1f5f9;
      --muted: #94a3b8; --faint: #64748b; --soft: #cbd5e1;
      --line: rgba(51, 65, 85, 0.5);
      --teal: #20B8B0; --coral: #F36F5D;
      --grid-line: rgba(32,184,176,0.04);
      --glass-a: rgba(255,255,255,0.06); --glass-b: rgba(255,255,255,0.02); --glass-c: rgba(14,20,23,0.12);
      --glass-border: rgba(255,255,255,0.08);
      --glass-hi: rgba(255,255,255,0.18); --glass-hi2: rgba(255,255,255,0.06);
      --glass-sheen: rgba(255,255,255,0.10); --glass-glow: rgba(255,255,255,0.07);
      --glow-teal: rgba(32,184,176,0.12); --glow-coral: rgba(243,111,93,0.10);
      --term-bg: rgba(2,6,10,0.55); --term-bar: rgba(0,0,0,0.35);
    }
    body { font-family: 'Noto Sans', system-ui, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.6; overflow-x: hidden; }

    /* ==========================================================================
       液态玻璃（Apple Liquid Glass）基元 —— 区别于毛玻璃：
       高度透明，背景动效从中透出；顶部/左侧高光描边 + 对角光泽 + 内部辉光。
       ========================================================================== */
    .glass {
      position: relative;
      background: linear-gradient(135deg, var(--glass-a), var(--glass-b) 35%, var(--glass-c));
      -webkit-backdrop-filter: blur(12px) saturate(180%);
      backdrop-filter: blur(12px) saturate(180%);
      border: 1px solid var(--glass-border);
      box-shadow:
        inset 0 1px 0 var(--glass-hi),
        inset 1px 0 0 var(--glass-hi2),
        0 20px 60px rgba(0,0,0,0.45);
      transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
    }
    /* 对角光泽 + 顶部辉光（液态玻璃的 specular 高光） */
    .glass::before {
      content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
      background:
        linear-gradient(115deg, var(--glass-sheen) 0%, rgba(255,255,255,0.03) 26%, transparent 42%),
        radial-gradient(120% 70% at 18% 0%, var(--glass-glow), transparent 55%);
    }

    /* ---------- 滚动揭示动画 ---------- */
    .reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.in { opacity: 1; transform: none; }
    .reveal-d1 { transition-delay: 0.08s; }
    .reveal-d2 { transition-delay: 0.16s; }
    .reveal-d3 { transition-delay: 0.24s; }
    .reveal-d4 { transition-delay: 0.32s; }
    @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }

    @property --border-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
    @keyframes rotating-border { from { --border-angle: 0deg; } to { --border-angle: 360deg; } }
    #particles { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; opacity: 0.7; pointer-events: none; }

    .hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 8rem 2rem 5rem; overflow: hidden; }
    .hero::before { content: ''; position: absolute; top: -40%; left: -20%; width: 80vw; height: 80vw; background: radial-gradient(circle, var(--glow-teal) 0%, transparent 70%); animation: drift 20s ease-in-out infinite alternate; pointer-events: none; }
    .hero::after { content: ''; position: absolute; bottom: -30%; right: -15%; width: 70vw; height: 70vw; background: radial-gradient(circle, var(--glow-coral) 0%, transparent 70%); animation: drift 25s ease-in-out infinite alternate-reverse; pointer-events: none; }
    @keyframes drift { 0% { transform: translate(0,0) scale(1); } 100% { transform: translate(40px,-30px) scale(1.05); } }
    .grid-bg { position: absolute; inset: 0; background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 60px 60px; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 15%, #000 85%, transparent), linear-gradient(180deg, transparent 0, #000 15%, #000 85%, transparent); mask-image: linear-gradient(90deg, transparent 0, #000 15%, #000 85%, transparent), linear-gradient(180deg, transparent 0, #000 15%, #000 85%, transparent); -webkit-mask-composite: source-in, xor; mask-composite: intersect; pointer-events: none; }
    .prism-deco { position: absolute; width: 0; height: 0; border-left: 80px solid transparent; border-right: 80px solid transparent; border-bottom: 140px solid var(--grid-line); top: 15%; left: 8%; transform: rotate(15deg); pointer-events: none; }
    .prism-deco-2 { position: absolute; width: 0; height: 0; border-left: 60px solid transparent; border-right: 60px solid transparent; border-bottom: 100px solid var(--grid-line); bottom: 20%; right: 10%; transform: rotate(-20deg); pointer-events: none; }
    .beam { position: absolute; height: 2px; background: linear-gradient(90deg, transparent, rgba(32,184,176,0.15), rgba(243,111,93,0.15), transparent); pointer-events: none; }
    .beam-1 { top: 30%; left: 0; width: 100%; transform: rotate(-5deg); }
    .beam-2 { top: 60%; left: 0; width: 100%; transform: rotate(3deg); }
    .beam-3 { top: 45%; left: 0; width: 100%; transform: rotate(-2deg); opacity: 0.5; }

    .hero-content { position: relative; z-index: 1; max-width: 1000px; }
    .hero-logo { width: 140px; height: 140px; margin-bottom: 2rem; filter: drop-shadow(0 0 40px rgba(32,184,176,0.3)); }
    .hero h1 { font-size: 3.5rem; font-weight: 700; background: linear-gradient(135deg, var(--teal), var(--ink), var(--coral)); background-size: 200% 200%; animation: gradient-shift 6s ease infinite; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 0.5rem; }
    @keyframes gradient-shift { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
    .tagline { font-size: 1.3rem; color: var(--muted); margin-bottom: 0.3rem; }
    .en-tagline { font-size: 1rem; color: var(--faint); margin-bottom: 2rem; letter-spacing: 3px; text-transform: uppercase; }
    .hero-desc { max-width: 760px; margin: 0 auto 2.5rem; color: var(--soft); font-size: 1.02rem; }
    .hero-desc strong { color: #20B8B0; }
    .hero-ctas { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem; }
    .cta { display: inline-block; position: relative; padding: 1rem 2.5rem; background: linear-gradient(135deg, #20B8B0, #F36F5D); color: white; font-weight: 600; border-radius: 10px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 20px rgba(32,184,176,0.3); }
    /* rotating gradient border (DeepSeek-style: conic-gradient + mask exclude) */
    .cta::before {
      content: ''; position: absolute; inset: -2px; border-radius: inherit; padding: 2px; pointer-events: none;
      background: conic-gradient(from var(--border-angle, 0deg), rgba(32,184,176,0.20) 0%, rgba(32,184,176,0.75) 25%, rgba(243,111,93,0.20) 50%, rgba(32,184,176,0.75) 75%, rgba(32,184,176,0.20) 100%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0; transition: opacity .3s ease;
      animation: rotating-border 6s linear infinite;
    }
    .cta:hover::before { opacity: 1; }
    .cta:hover { transform: translateY(-2px); box-shadow: 0 6px 30px rgba(32,184,176,0.4); text-decoration: none; }
    .cta-ghost { display: inline-block; padding: 1rem 2rem; color: var(--ink-strong); border: 1px solid var(--line); border-radius: 10px; text-decoration: none; font-weight: 500; transition: all 0.2s; }
    .cta-ghost:hover { border-color: #20B8B0; color: #20B8B0; text-decoration: none; }

    /* ---------- 终端演示（One command, full control） ---------- */
    .terminal-section { position: relative; overflow: hidden; }
    .terminal-section::before { content: ''; position: absolute; top: 50%; left: 50%; width: 90vw; height: 90vw; transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(46,96,159,0.12) 0%, transparent 60%); pointer-events: none; }
    .terminal { max-width: 740px; margin: 0 auto; border-radius: 14px; overflow: hidden; text-align: left; }
    .term-bar { display: flex; align-items: center; gap: 0.45rem; padding: 0.7rem 1rem; background: var(--term-bar); border-bottom: 1px solid rgba(255,255,255,0.06); }
    .term-dot { width: 11px; height: 11px; border-radius: 50%; }
    .term-dot.red { background: #ff5f57; } .term-dot.yellow { background: #febc2e; } .term-dot.green { background: #28c840; }
    .term-title { margin-left: 0.5rem; font-size: 0.8rem; color: #64748b; font-family: ui-monospace, 'Cascadia Mono', monospace; }
    .term-body { padding: 1.1rem 1.2rem; min-height: 250px; font-family: ui-monospace, 'Cascadia Mono', monospace; font-size: 0.92rem; overflow-y: auto; background: var(--term-bg); }
    .term-line { color: #cbd5e1; margin-bottom: 0.35rem; white-space: pre-wrap; }
    .term-prompt { color: #20B8B0; font-weight: 700; }
    .term-out { color: #64748b; margin-bottom: 0.95rem; }
    .term-typing::after { content: '▍'; color: #20B8B0; animation: blink-ty 1s step-end infinite; }

    /* ---------- 产品平级双卡（Zeta + Bio SDK） ---------- */
    .product-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; max-width: 860px; margin: 0 auto 2.6rem; text-align: left; perspective: 1200px; }
    .pcard { display: flex; flex-direction: column; gap: 0.9rem; padding: 1.6rem 1.7rem; border-radius: 20px; text-decoration: none; overflow: hidden; transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s; transform-style: preserve-3d; will-change: transform; }
    .pcard::after { content: ''; position: absolute; inset: 0; border-radius: 20px; background: radial-gradient(600px circle at var(--mx,50%) var(--my,50%), rgba(32,184,176,0.12), transparent 45%); opacity: 0; transition: opacity 0.3s; pointer-events: none; }
    .pcard.zeta::after { background: radial-gradient(600px circle at var(--mx,50%) var(--my,50%), rgba(226,6,19,0.14), transparent 45%); }
    .pcard:hover { border-color: rgba(255,255,255,0.18); box-shadow: 0 22px 60px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.12); }
    .pcard:hover::after { opacity: 1; }
    .pcard .pmark { display: inline-flex; align-items: center; justify-content: center; width: 2.6rem; height: 2.6rem; border-radius: 10px; font-weight: 800; font-size: 1.1rem; }
    .pcard.zeta .pmark { color: #E20613; background: rgba(226,6,19,0.12); }
    .pcard.sdk .pmark { color: #20B8B0; background: rgba(32,184,176,0.14); }
    .pcard h3 { color: var(--ink-strong); font-size: 1.18rem; font-weight: 600; }
    .pcard p { color: var(--muted); font-size: 0.88rem; line-height: 1.55; flex: 1; }
    .pcard .pgo { font-size: 0.85rem; font-weight: 600; }
    .pcard.zeta .pgo { color: #E20613; }
    .pcard.sdk .pgo { color: #20B8B0; }

    .badge { font-size: 0.8rem; background: rgba(32,184,176,0.12); color: #20B8B0; padding: 0.35rem 1rem; border-radius: 999px; border: 1px solid rgba(32,184,176,0.25); }
    .badge-coral { background: rgba(243,111,93,0.12); color: #F36F5D; border-color: rgba(243,111,93,0.25); }

    /* ---------- Hero 主打卡（Get Started 下方 · 单张 Zeta） ---------- */
    .product-feature { max-width: 560px; margin: 0 auto 2.6rem; text-align: left; perspective: 1200px; }

    /* ---------- 自研产品大区（Zeta + Bio SDK 大展示卡 · 沉浸科技感） ---------- */
    .section-products { position: relative; overflow: hidden; }
    .section-products::before {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 56px 56px;
      -webkit-mask-image: radial-gradient(80% 85% at 50% 40%, #000, transparent);
      mask-image: radial-gradient(80% 85% at 50% 40%, #000, transparent);
      pointer-events: none;
    }
    .scanline { position: absolute; left: 0; right: 0; height: 240px; top: -240px; pointer-events: none;
      background: linear-gradient(180deg, transparent, rgba(32,184,176,0.07), transparent);
      animation: scan 8s linear infinite; mix-blend-mode: screen; }
    @keyframes scan { 0% { transform: translateY(0); } 100% { transform: translateY(calc(100vh + 240px)); } }
    .product-showcase { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; perspective: 1400px; }
    .show-card { position: relative; display: flex; flex-direction: column; gap: 1rem; padding: 2rem 2.1rem; border-radius: 26px; text-decoration: none; transform-style: preserve-3d; will-change: transform; overflow: hidden; }
    .show-top { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 0.2rem; }
    .show-mark { display: inline-flex; align-items: center; justify-content: center; width: 3.2rem; height: 3.2rem; border-radius: 14px; font-weight: 800; font-size: 1.3rem; }
    .show-tag { font-size: 0.78rem; letter-spacing: 1px; text-transform: uppercase; color: var(--soft); border: 1px solid rgba(255,255,255,0.14); padding: 0.28rem 0.85rem; border-radius: 999px; }
    .show-card.zeta .show-mark { color: #E20613; background: rgba(226,6,19,0.14); }
    .show-card.sdk .show-mark { color: #20B8B0; background: rgba(32,184,176,0.16); }
    .show-card h3 { font-size: 1.9rem; font-weight: 700; color: var(--ink-strong); }
    .show-sub { font-size: 0.86rem; color: var(--faint); letter-spacing: 1px; text-transform: uppercase; }
    .show-card .show-desc { color: var(--muted); font-size: 0.97rem; line-height: 1.6; flex: 1; }
    .show-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .show-chips span { font-size: 0.78rem; color: var(--soft); background: rgba(32,184,176,0.10); border: 1px solid rgba(32,184,176,0.22); padding: 0.3rem 0.85rem; border-radius: 999px; }
    .show-card.zeta .show-chips span { background: rgba(226,6,19,0.10); border-color: rgba(226,6,19,0.24); }
    .show-cta { font-weight: 600; font-size: 0.95rem; margin-top: 0.4rem; }
    .show-card.zeta .show-cta { color: #E20613; }
    .show-card.sdk .show-cta { color: #20B8B0; }
    .show-card::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(620px circle at var(--mx,50%) var(--my,50%), rgba(32,184,176,0.12), transparent 45%); opacity: 0; transition: opacity 0.3s; pointer-events: none; }
    .show-card.zeta::after { background: radial-gradient(620px circle at var(--mx,50%) var(--my,50%), rgba(226,6,19,0.14), transparent 45%); }
    .show-card:hover::after { opacity: 1; }
    .show-card:hover { border-color: rgba(255,255,255,0.24); }

    .section-block { padding: 5rem 0; }
    .section-block-alt { background: linear-gradient(180deg, var(--bg) 0%, var(--bg-alt) 100%); }
    .section-block-alt2 { background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg) 100%); }
    .section { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
    .section-header { text-align: center; margin-bottom: 3rem; }
    .section-title { font-size: 2.2rem; font-weight: 700; margin-bottom: 0.5rem; background: linear-gradient(135deg, #20B8B0, #F36F5D); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .section-subtitle { color: var(--faint); font-size: 1rem; }
    .section-divider { width: 60px; height: 3px; margin: 1rem auto 0; background: linear-gradient(90deg, #20B8B0, #F36F5D); border-radius: 2px; }

    .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; }
    .feature { background: linear-gradient(135deg, rgba(30,41,59,0.8), rgba(14,20,23,0.9)); border: 1px solid rgba(51,65,85,0.5); border-radius: 16px; padding: 1.6rem; text-align: left; backdrop-filter: blur(10px); transition: transform 0.3s, border-color 0.3s; }
    .feature:hover { transform: translateY(-4px); border-color: rgba(32,184,176,0.4); }
    .feature .feature-icon { font-size: 1.6rem; margin-bottom: 0.7rem; display: block; }
    .feature h3 { color: #20B8B0; margin-bottom: 0.5rem; font-size: 1.08rem; }
    .feature p { color: var(--muted); font-size: 0.88rem; line-height: 1.55; }

    .about-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
    .about-text h3 { color: var(--ink-strong); font-size: 1.4rem; margin-bottom: 1rem; }
    .about-text p { color: var(--muted); margin-bottom: 1rem; font-size: 0.95rem; }
    .about-text strong { color: #20B8B0; }
    .about-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .stat-card { background: linear-gradient(135deg, rgba(30,41,59,0.7), rgba(14,20,23,0.9)); border: 1px solid rgba(51,65,85,0.5); border-radius: 14px; padding: 1.4rem; text-align: center; }
    .stat-num { font-size: 2rem; font-weight: 700; background: linear-gradient(135deg, #20B8B0, #F36F5D); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stat-label { color: var(--muted); font-size: 0.8rem; margin-top: 0.3rem; }

    .ecosystem-link { display: block; background: linear-gradient(135deg, rgba(30,41,59,0.8), rgba(14,20,23,0.9)); border: 1px solid rgba(51,65,85,0.5); border-radius: 16px; padding: 2rem; text-align: center; text-decoration: none; transition: transform 0.3s, border-color 0.3s; }
    .ecosystem-link:hover { transform: translateY(-4px); border-color: rgba(32,184,176,0.5); }
    .ecosystem-link h3 { color: #20B8B0; font-size: 1.3rem; margin-bottom: 0.6rem; }
    .ecosystem-link p { color: var(--muted); font-size: 0.92rem; margin-bottom: 0.8rem; }
    .ecosystem-tags { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
    .eco-tag { font-size: 0.78rem; background: rgba(32,184,176,0.1); color: #20B8B0; border: 1px solid rgba(32,184,176,0.2); padding: 0.25rem 0.8rem; border-radius: 999px; }
    .blog-section { background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg) 100%); padding: 5rem 0; }
    .blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
    .blog-card { background: linear-gradient(135deg, rgba(30,41,59,0.6), rgba(14,20,23,0.8)); border: 1px solid rgba(51,65,85,0.5); border-radius: 16px; padding: 1.5rem; text-decoration: none; transition: transform 0.3s, border-color 0.3s; }
    .blog-card:hover { transform: translateY(-4px); border-color: rgba(32,184,176,0.4); }
    .blog-date { font-size: 0.8rem; color: var(--faint); margin-bottom: 0.5rem; }
    .blog-title { font-size: 1.2rem; font-weight: 600; color: var(--ink-strong); margin-bottom: 0.5rem; }
    .blog-desc { color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
    .blog-tag { display: inline-block; font-size: 0.7rem; background: rgba(32,184,176,0.15); color: #20B8B0; padding: 0.2rem 0.6rem; border-radius: 4px; margin-top: 0.75rem; }

    .release-section { padding: 4rem 0; }
    .release-card { background: linear-gradient(135deg, rgba(30,41,59,0.8), rgba(14,20,23,0.9)); border: 1px solid rgba(51,65,85,0.5); border-radius: 16px; padding: 2.5rem; text-align: center; max-width: 800px; margin: 0 auto; }
    .release-card h3 { color: var(--ink-strong); font-size: 1.4rem; margin-bottom: 0.8rem; }
    .release-card p { color: var(--muted); margin-bottom: 1.2rem; font-size: 0.95rem; }
    .release-status-line { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 1.2rem; }
    .release-item { font-size: 0.82rem; color: var(--muted); display: flex; align-items: center; gap: 0.4rem; }

    footer { text-align: center; padding: 3rem 2rem; color: var(--faint); font-size: 0.85rem; border-top: 1px solid var(--line); background: var(--bg-deep); }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2.5rem; }
      .about-grid { grid-template-columns: 1fr; }
      .about-stats { grid-template-columns: repeat(3, 1fr); }
      .blog-grid { grid-template-columns: 1fr; }
      .features { grid-template-columns: 1fr; }
      .nav-links { gap: 1rem; }
      .product-showcase { grid-template-columns: 1fr; }
    }

    /* ---------- Update ticker (auto-scroll) ---------- */
    .ticker-wrap { overflow: hidden; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: rgba(2,6,10,0.4); }
    .ticker { display: flex; width: max-content; animation: ticker-scroll 40s linear infinite; }
    .ticker-wrap:hover .ticker { animation-play-state: paused; }
    .ticker-item { display: flex; align-items: center; gap: 0.55rem; padding: 0.8rem 2.4rem; white-space: nowrap; font-size: 0.88rem; color: var(--soft); }
    .ticker-item b { color: #20B8B0; font-weight: 600; }
    .ticker-item .tdot { width: 6px; height: 6px; border-radius: 50%; background: #20B8B0; box-shadow: 0 0 10px rgba(32,184,176,0.8); flex: none; }
    @keyframes ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* ---------- Highlight slideshow (auto-play) ---------- */
    .slideshow { position: relative; max-width: 900px; margin: 0 auto; border-radius: 22px; user-select: none; }
    .slide { position: absolute; inset: 0; opacity: 0; transform: scale(0.982); transition: opacity 0.9s ease, transform 0.9s ease; pointer-events: none; }
    .slide.active { position: relative; opacity: 1; transform: none; pointer-events: auto; }
    .slide-frame { border-radius: 20px; overflow: hidden; box-shadow: 0 30px 90px rgba(0,0,0,0.5); border: 1px solid var(--glass-border); }
    .slide-frame svg { display: block; width: 100%; height: auto; }
    .slide-caption { position: absolute; left: 1.5rem; bottom: 1.3rem; z-index: 2; display: flex; flex-direction: column; gap: 0.15rem; }
    .slide-caption .c-t { font-size: 1.2rem; font-weight: 700; color: #fff; text-shadow: 0 2px 14px rgba(0,0,0,0.65); }
    .slide-caption .c-s { font-size: 0.85rem; color: rgba(255,255,255,0.88); text-shadow: 0 1px 8px rgba(0,0,0,0.65); }
    .nav-btn { position: absolute; top: 50%; transform: translateY(-50%); z-index: 3; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: rgba(10,15,26,0.55); color: var(--ink-strong); cursor: pointer; font-size: 1.05rem; line-height: 1; transition: all 0.2s; }
    .nav-btn:hover { border-color: #20B8B0; color: #20B8B0; background: rgba(10,15,26,0.8); }
    .nav-prev { left: 1.1rem; } .nav-next { right: 1.1rem; }
    .slide-dots { position: absolute; bottom: 1.1rem; right: 1.5rem; z-index: 3; display: flex; gap: 0.45rem; }
    .slide-dots button { width: 9px; height: 9px; border-radius: 999px; border: none; background: rgba(255,255,255,0.4); cursor: pointer; padding: 0; transition: all 0.3s; }
    .slide-dots button.active { width: 26px; background: #20B8B0; }

    /* ---------- Ecosystem dual marquee ---------- */
    .eco-marquee { position: relative; overflow: hidden; margin-top: 1.7rem; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
    .eco-marquee + .eco-marquee { margin-top: 0.7rem; }
    .eco-track { display: flex; width: max-content; gap: 0.7rem; animation: eco-scroll 44s linear infinite; }
    .eco-track.rev { animation-direction: reverse; animation-duration: 54s; }
    .eco-marquee:hover .eco-track { animation-play-state: paused; }
    .eco-track span { flex: none; font-size: 0.82rem; color: var(--soft); background: rgba(32,184,176,0.08); border: 1px solid rgba(32,184,176,0.2); padding: 0.45rem 1.15rem; border-radius: 999px; white-space: nowrap; }
    .eco-track.rev span { background: rgba(243,111,93,0.07); border-color: rgba(243,111,93,0.2); }
    @keyframes eco-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    @media (prefers-reduced-motion: reduce) {
      .ticker, .eco-track { animation: none; width: 100%; flex-wrap: wrap; }
      .ticker-item { white-space: normal; }
      .slide { position: relative; opacity: 1; transform: none; pointer-events: auto; }
      .slide + .slide { display: none; }
    }
  </style>
