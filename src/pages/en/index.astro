      <h3 class="subsection-title">Asset Usage Terms</h3>
      <div class="license">
        <div class="license-grid">
          <div class="license-item"><span class="license-icon">📜</span><div class="license-text"><strong>Policy:</strong> Reserved Linxira brand assets</div></div>
          <div class="license-item"><span class="license-icon">✅</span><div class="license-text"><strong>Allowed:</strong> Unmodified Linxira OS distribution</div></div>
          <div class="license-item"><span class="license-icon">✅</span><div class="license-text"><strong>Allowed:</strong> Media coverage, reviews</div></div>
          <div class="license-item"><span class="license-icon">❌</span><div class="license-text"><strong>Prohibited:</strong> Implying official affiliation for non-official projects</div></div>
