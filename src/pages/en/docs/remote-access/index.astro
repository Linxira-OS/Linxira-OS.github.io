    h3 { font-size: 1.15rem; color: #e2e8f0; margin: 1.5rem 0 0.5rem; }
    p { color: #94a3b8; margin-bottom: 1rem; }
    strong { color: #e2e8f0; }
    a { color: #20B8B0; }
    ul, ol { color: #94a3b8; margin: 0.5rem 0 1rem 1.5rem; }
    li { margin-bottom: 0.3rem; }
    code { background: rgba(30,41,59,0.8); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.85rem; color: #20B8B0; }
    pre { background: #111827; border-left: 3px solid #20B8B0; padding: 1rem 1.2rem; overflow-x: auto; margin-bottom: 1.2rem; }
    pre code { background: none; padding: 0; color: #67e8f9; font-size: 0.88rem; }
    .note { background: rgba(32,184,176,0.08); border: 1px solid rgba(32,184,176,0.3); border-radius: 8px; padding: 0.8rem 1.2rem; margin: 1.2rem 0; color: #a7f3d0; }
    .warn { background: rgba(243,111,93,0.08); border: 1px solid rgba(243,111,93,0.35); border-radius: 8px; padding: 0.8rem 1.2rem; margin: 1.2rem 0; color: #fecaca; }
    .step { display: flex; gap: 1rem; margin: 1.5rem 0; }
    .step-num { flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #20B8B0, #F36F5D); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; }
    .step-body { flex: 1; }
    .step-body p:last-child { margin-bottom: 0; }
    table { width: 100%; border-collapse: collapse; margin: 1rem 0 1.5rem; font-size: 0.9rem; }
    th { background: rgba(30,41,59,0.6); color: #e2e8f0; text-align: left; padding: 0.6rem 1rem; border: 1px solid rgba(51,65,85,0.5); }
    td { color: #94a3b8; padding: 0.6rem 1rem; border: 1px solid rgba(51,65,85,0.5); }
    footer { text-align: center; padding: 3rem 2rem; color: #475569; font-size: 0.85rem; border-top: 1px solid rgba(51,65,85,0.3); margin-left: 260px; }
    @media (max-width: 768px) { .sidebar { display: none; } .main { margin-left: 0; padding: 2rem; } footer { margin-left: 0; } }
