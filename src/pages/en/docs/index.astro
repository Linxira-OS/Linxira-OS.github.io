---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../../components/DocsLayout.astro";

const entries = await getCollection("docs");
const mine = entries.filter((e) => e.id === "en" || e.id.startsWith("en/"));
const entry = mine.find((e) => {
  const rest = e.id === "en" ? "" : e.id.slice(2 + 1);
  return rest.replace(/\.(md|mdx)$/i, "").replace(/(^|\/)index$/, "") === "";
});
if (!entry) throw new Error("ids: " + mine.map((e) => e.id).join(" | "));
const { Content } = await render(entry);
---
<DocsLayout lang="en" active="docs" title={`${entry.data.title} — Linxira OS`}>
  <Content />
</DocsLayout>
