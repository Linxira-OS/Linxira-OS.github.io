---
import PageLayout from "../../../components/PageLayout.astro";
import { getAllPosts } from "../../../data/allPosts";
const blogPosts = await getAllPosts();
---
<PageLayout lang="en" active="blog" title="Blog — Linxira OS">
    <h1>Blog</h1>
    <p class="subtitle">Announcements, releases, and technical articles</p>

    {blogPosts.map((p) => (
      <a href={`/en/blog/${p.slug}/`} class="post-card">
        <div class="post-date">{p.date}</div>
        <div class="post-title">{p.en.title}</div>
        <div class="post-desc">{p.en.desc}</div>
        <span class={p.tag === "technical" ? "post-tag tech" : "post-tag"}>{p.tag === "announcement" ? "Announcement" : "Technical"}</span>
      </a>
    ))}
<style>
    .subtitle { color: var(--t-text-muted); margin-bottom: 3rem; font-size: 1.1rem; }
    .post-card { display: block; background: linear-gradient(135deg, var(--t-surface-2), rgba(14,20,23,0.9)); border: 1px solid var(--t-border-subtle); border-radius: 16px; padding: 2rem; text-decoration: none; transition: transform 0.3s, border-color 0.3s; margin-bottom: 1.5rem; }
    .post-card:hover { transform: translateY(-4px); border-color: color-mix(in oklab, var(--t-brand) 40%, transparent); }
    .post-date { font-size: 0.8rem; color: var(--t-text-muted); margin-bottom: 0.5rem; }
    .post-title { font-size: 1.3rem; font-weight: 600; color: var(--t-text); margin-bottom: 0.5rem; }
    .post-desc { color: var(--t-text-muted); font-size: 0.9rem; line-height: 1.5; }
    .post-tag { display: inline-block; font-size: 0.7rem; background: color-mix(in oklab, var(--t-brand) 15%, transparent); color: var(--t-brand); padding: 0.2rem 0.6rem; border-radius: 4px; margin-top: 0.75rem; }
    .post-tag.tech { background: rgba(139,92,246,0.15); color: var(--t-signal); }
  </style>
</PageLayout>
