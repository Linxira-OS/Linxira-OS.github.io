---
import PageLayout from "../../../components/PageLayout.astro";

export function getStaticPaths() {
  const modules = import.meta.glob("../../../posts/*.en.md", { eager: true });
  return Object.entries(modules)
    .filter(([path]) => path.endsWith(".en.md"))
    .map(([path, mod]) => ({
      params: { slug: path.split("/").pop()!.replace(/\.en\.md$/, "") },
      props: { mod: mod as any },
    }));
}
const { mod } = Astro.props;
const { Content } = mod;
const dateStr = new Date(mod.frontmatter.date).toISOString().slice(0, 10);
---
<PageLayout lang="en" active="blog" title={`${mod.frontmatter.title} — Blog`}>
    <a href="/en/blog/" class="back">← Back to Blog</a>
    <div class="meta">{dateStr} · {mod.frontmatter.tag === 'announcement' ? 'Announcement' : 'Technical'} · <a href="/bio-sdk/">Product page →</a></div>
    <article class="post-body">
      <Content />
    </article>
<style is:global>
    .meta { color: var(--t-text-muted); font-size: 0.85rem; margin-bottom: 2rem; }
    .meta a { color: var(--t-brand); text-decoration: none; }
    .post-body h1 { font-size: 1.7rem; color: var(--t-text); margin-bottom: 1.2rem; }
    .post-body h2 { font-size: 1.4rem; color: var(--t-text); margin: 2rem 0 0.8rem; padding-top: 1rem; border-top: 1px solid var(--t-border-subtle); }
    .post-body h3 { font-size: 1.15rem; color: var(--t-text); margin: 1.5rem 0 0.5rem; }
    .post-body strong { color: var(--t-text); }
    .post-body a { color: var(--t-brand); }
    .post-body li { margin-bottom: 0.3rem; }
    .post-body blockquote { border-left: 3px solid color-mix(in oklab, var(--t-brand) 50%, transparent); margin: 1rem 0; padding: 0.3rem 0 0.3rem 0.9rem; color: var(--t-text-muted); font-size: 0.9rem; }
    .post-body blockquote p { margin: 0.2rem 0; }
    .post-body table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
    .post-body th { text-align: left; padding: 0.6rem; border-bottom: 2px solid var(--t-border-subtle); color: var(--t-text); font-size: 0.9rem; }
    .post-body td { padding: 0.6rem; border-bottom: 1px solid var(--t-border-subtle); color: var(--t-text-muted); font-size: 0.85rem; }
    .post-body pre { background: var(--t-bg-deep); border: 1px solid var(--t-border-subtle); border-radius: 10px; padding: 1rem 1.2rem; overflow-x: auto; margin: 1rem 0; }
    .post-body pre code { background: none; color: var(--t-text-secondary); padding: 0; }
    .post-body hr { border: none; border-top: 1px solid var(--t-border-subtle); margin: 2rem 0; }
    .post-body em { color: var(--t-text-muted); }
  </style>
</PageLayout>
