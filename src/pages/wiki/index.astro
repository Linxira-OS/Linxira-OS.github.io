---
// 站内稳定入口 /wiki/ → 由 linxira-wiki 仓部署的 MkDocs 站点。
// 直接链过去会暴露 linxira-wiki/ 这个实现细节;放在 /wiki/ 下,
// 以后换部署目标也只改这一处。
const target = "https://linxira-os.github.io/linxira-wiki/";
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Linxira 手册</title>
<meta name="description" content="Linxira OS 用户手册与项目总览。">
<link rel="canonical" href={target}>
<meta http-equiv="refresh" content={`0; url=${target}`}>
<style>
  body { margin:0; min-height:100vh; display:grid; place-items:center;
         background:#0E1417; color:#e5e7eb; font-family:'Noto Sans',system-ui,sans-serif; }
  a { color:#20B8B0; }
  p { line-height:1.7; text-align:center; }
</style>
</head>
<body>
  <p>
    正在前往 <a href={target}>Linxira 手册</a>…<br>
    <span style="color:#94a3b8;font-size:.9rem">Redirecting to the Linxira handbook.</span>
  </p>
</body>
</html>
