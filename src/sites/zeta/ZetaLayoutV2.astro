---
import Navbar from "../../components/Navbar.astro";
interface Props {
	lang: "zh" | "en";
	title: string;
	description: string;
	active: "home" | "features" | "ecosystem";
}
const { lang, title, description, active } = Astro.props;
const zh = lang === "zh";
const copy = zh
	? {
			navHome: "首页", navFeatures: "特性", navEcosystem: "生态",
			themeBtn: "深浅切换",
			footCopy: "© 2026 Zeta · Linxira-OS",
			footOrg: "Linxira OS", footGitHub: "GitHub",
	  }
	: {
			navHome: "Home", navFeatures: "Features", navEcosystem: "Ecosystem",
			themeBtn: "Theme",
			footCopy: "© 2026 Zeta · Linxira-OS",
			footOrg: "Linxira OS", footGitHub: "GitHub",
	  };
const base = zh ? "/zeta/v2/zh" : "/zeta/v2/en";
---
<!DOCTYPE html>
<html lang={lang} data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description}>
	<meta property="og:site_name" content="Zeta">
	<meta property="og:type" content="website">
	<meta property="og:title" content={title}>
	<meta property="og:description" content={description}>
	<meta property="og:url" content={"https://linxira-os.github.io/zeta/v2/" + lang + "/"}>
	<meta name="theme-color" content="#0A0A12" media="(prefers-color-scheme: dark)">
	<meta name="theme-color" content="#F6F4FD" media="(prefers-color-scheme: light)">
	<link rel="icon" type="image/svg+xml" href="/assets/zeta-logo.svg">
	<script is:inline>
		const saved = localStorage.getItem('zeta-theme');
		const prefers = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
		document.documentElement.dataset.theme = saved ?? prefers;
		document.documentElement.classList.add('js');
	</script>
	<style is:global>
		/* ============ Violet Ink 配色系统 ============
		   品牌紫 #8B5CF6 为轴,终端磷光青 #22D3EE 为辅,
		   琥珀 #FBBF24 仅做点睛。明暗两套同源。 */
		:root {
			--brand: #8B5CF6;
			--brand-2: #A78BFA;
			--brand-deep: #6D28D9;
			--accent: #22D3EE;
			--warm: #FBBF24;
			--bg: #0A0A12;
			--bg-2: #0E0D1A;
			--ink: #EEECFA;
			--muted: #A5A0BC;
			--faint: #6F6A85;
			--line: rgba(139, 92, 246, 0.16);
			--line-2: rgba(139, 92, 246, 0.38);
			--panel: rgba(139, 92, 246, 0.05);
			--panel-2: rgba(139, 92, 246, 0.09);
			--panel-solid: #12111F;
			--glow: rgba(139, 92, 246, 0.22);
			--font: "Helvetica Neue", Helvetica, "Inter", "Noto Sans", system-ui,
				"PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
			--mono: "SF Mono", "Cascadia Mono", "JetBrains Mono", ui-monospace, monospace;
			--radius: 12px;
		}
		[data-theme="light"] {
			--bg: #F6F4FD;
			--bg-2: #EFECFB;
			--ink: #17142A;
			--muted: #575170;
			--faint: #8B86A3;
			--line: rgba(109, 40, 217, 0.16);
			--line-2: rgba(109, 40, 217, 0.38);
			--panel: rgba(255, 255, 255, 0.72);
			--panel-2: rgba(255, 255, 255, 0.95);
			--panel-solid: #ffffff;
			--glow: rgba(139, 92, 246, 0.14);
		}
		* { margin: 0; padding: 0; box-sizing: border-box; }
		html { scroll-behavior: smooth; }
		body {
			font-family: var(--font);
			background: var(--bg);
			color: var(--ink);
			line-height: 1.55;
			font-size: 16px;
			transition: background .2s, color .2s;
		}
		::selection { background: var(--brand); color: #fff; }

		.v2-wrap { position: relative; z-index: 1; }
		.v2-bg {
			position: fixed; inset: 0; pointer-events: none; z-index: 0;
			background:
				radial-gradient(52vw 52vw at 82% -8%, rgba(139,92,246,0.13), transparent 62%),
				radial-gradient(40vw 40vw at -12% 38%, rgba(34,211,238,0.07), transparent 60%);
		}
		[data-theme="light"] .v2-bg {
			background:
				radial-gradient(52vw 52vw at 82% -8%, rgba(139,92,246,0.10), transparent 62%),
				radial-gradient(40vw 40vw at -12% 38%, rgba(34,211,238,0.08), transparent 60%);
		}
		.container { max-width: 1200px; margin: 0 auto; padding: 0 5vw; }

		/* ============ 子站导航:顶部粘性条(替代旧右侧栏) ============ */
		.v2nav-anchor { position: sticky; top: var(--zeta-nav-h, 4.5rem); z-index: 60; }
		.v2nav {
			border-bottom: 1px solid var(--line);
			background: color-mix(in srgb, var(--bg) 78%, transparent);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
		}
		.v2nav-inner {
			max-width: 1200px; margin: 0 auto; padding: 0 5vw;
			display: flex; align-items: center; gap: 1.4rem; height: 3.4rem;
		}
		.v2-brand {
			display: inline-flex; align-items: center; gap: .55rem;
			font-weight: 800; letter-spacing: .1em; font-size: .95rem;
			color: var(--ink); text-decoration: none;
		}
		.v2-brand img { height: 1.45rem; width: auto; }
		.v2-brand .zeta-word { background: linear-gradient(120deg, var(--brand-2), var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
		.v2-links { display: flex; gap: .35rem; margin-left: .4rem; }
		.v2-links a {
			color: var(--muted); text-decoration: none; font-size: .84rem;
			padding: .38rem .8rem; border-radius: 999px;
			transition: color .15s, background .15s;
		}
		.v2-links a:hover { color: var(--ink); background: var(--panel-2); }
		.v2-links a.active { color: #fff; background: linear-gradient(120deg, var(--brand), var(--brand-deep)); }
		[data-theme="light"] .v2-links a.active { color: #fff; }
		.v2-right { margin-left: auto; display: flex; align-items: center; gap: .6rem; }
		.v2-right .gh {
			color: var(--muted); display: inline-flex; padding: .4rem; border-radius: 8px;
			transition: color .15s, background .15s;
		}
		.v2-right .gh:hover { color: var(--ink); background: var(--panel-2); }
		.theme-toggle {
			background: none; border: 1px solid var(--line); color: var(--muted);
			font-family: var(--font); font-size: .72rem; padding: .34rem .75rem;
			cursor: pointer; letter-spacing: .08em; border-radius: 999px;
			transition: color .15s, border-color .15s;
		}
		.theme-toggle:hover { color: var(--brand-2); border-color: var(--line-2); }

		/* ============ Hero ============ */
		.hero { padding: 5.5rem 0 4.5rem; position: relative; }
		.hero-grid { display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(0, .94fr); gap: 3.2rem; align-items: center; }
		.kicker {
			display: inline-flex; align-items: center; gap: .6rem;
			color: var(--brand-2); font-weight: 700; letter-spacing: .22em;
			font-size: .72rem; text-transform: uppercase; margin-bottom: 1.6rem;
		}
		.kicker::before { content: ''; width: 2rem; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--brand), var(--accent)); }
		.hero h1 {
			font-size: clamp(2.5rem, 6.4vw, 4.6rem);
			font-weight: 800; letter-spacing: -.03em; line-height: 1.06;
			margin-bottom: 1.5rem; text-wrap: balance;
		}
		.hero h1 .accent {
			background: linear-gradient(120deg, var(--brand-2), var(--accent));
			-webkit-background-clip: text; background-clip: text; color: transparent;
		}
		.hero .lede { max-width: 56ch; font-size: clamp(1rem, 1.6vw, 1.14rem); color: var(--muted); margin-bottom: 2.2rem; }
		.hero .lede strong { color: var(--ink); font-weight: 600; }

		.cta-row { display: flex; gap: .9rem; flex-wrap: wrap; }
		.cta {
			display: inline-flex; align-items: center; gap: .5rem;
			padding: .85rem 1.7rem; text-decoration: none;
			font-weight: 600; font-size: .92rem; letter-spacing: .03em;
			border-radius: var(--radius); border: 1px solid var(--line-2); color: var(--ink);
			transition: transform .16s, box-shadow .16s, border-color .16s, color .16s;
		}
		.cta.primary {
			background: linear-gradient(120deg, var(--brand), var(--brand-deep));
			border-color: transparent; color: #fff;
			box-shadow: 0 6px 26px var(--glow);
		}
		.cta.primary:hover { transform: translateY(-2px); box-shadow: 0 10px 32px var(--glow); }
		.cta.ghost:hover { border-color: var(--brand-2); color: var(--brand-2); transform: translateY(-2px); }

		/* ============ 终端工作台 mock(纯 CSS) ============ */
		.term {
			font-family: var(--mono); font-size: .74rem; line-height: 1.6;
			background: color-mix(in srgb, var(--panel-solid) 92%, transparent);
			border: 1px solid var(--line-2); border-radius: 14px;
			box-shadow: 0 24px 70px rgba(0,0,0,.45), 0 0 0 1px rgba(139,92,246,.06), 0 0 90px var(--glow);
			overflow: hidden; color: var(--ink);
		}
		[data-theme="light"] .term { box-shadow: 0 24px 70px rgba(70,40,160,.18), 0 0 90px var(--glow); }
		.term-bar { display: flex; align-items: center; gap: .45rem; padding: .55rem .9rem; border-bottom: 1px solid var(--line); background: var(--panel); }
		.term-bar .dot { width: .62rem; height: .62rem; border-radius: 50%; }
		.term-bar .dot:nth-child(1) { background: #ff5f57; } .term-bar .dot:nth-child(2) { background: #febc2e; } .term-bar .dot:nth-child(3) { background: #28c840; }
		.term-bar .title { margin: 0 auto; color: var(--faint); font-size: .68rem; letter-spacing: .06em; }
		.term-menu { display: flex; gap: 1rem; padding: .3rem .9rem; border-bottom: 1px solid var(--line); color: var(--muted); font-size: .66rem; }
		.term-menu .on { color: var(--brand-2); box-shadow: 0 1px 0 var(--brand-2); }
		.term-tabs { display: flex; gap: .4rem; padding: .4rem .9rem 0; font-size: .66rem; }
		.term-tabs .tt { padding: .18rem .7rem; border: 1px solid var(--line); border-bottom: none; border-radius: 7px 7px 0 0; color: var(--faint); }
		.term-tabs .tt.on { color: var(--ink); background: var(--panel-2); border-color: var(--line-2); position: relative; }
		.term-tabs .tt.on::after { content: ''; position: absolute; left: .55rem; top: 50%; transform: translateY(-50%); width: .32rem; height: .32rem; border-radius: 50%; background: var(--accent); }
		.term-tabs .plus { color: var(--brand-2); padding: .18rem .5rem; }
		.term-panes { display: grid; grid-template-columns: 1.25fr 1fr; gap: 1px; background: var(--line); border-top: 1px solid var(--line); }
		.term-panes .col { display: grid; gap: 1px; background: var(--line); }
		.pane { background: var(--panel-solid); padding: .5rem .8rem .7rem; min-height: 0; }
		.pane-h { display: flex; justify-content: space-between; align-items: center; color: var(--faint); font-size: .62rem; padding-bottom: .3rem; border-bottom: 1px dashed var(--line); margin-bottom: .45rem; }
		.pane-h .ph-t { color: var(--brand-2); }
		.pane-h.on .ph-t { color: var(--accent); }
		.pane-h .ctl { letter-spacing: .18em; }
		.pane .out { color: var(--muted); }
		.pane .out b { color: var(--ink); font-weight: 600; }
		.pane .out .ok { color: #4ADE80; }
		.pane .out .prompt { color: var(--brand-2); }
		.pane .out .cur { display: inline-block; width: .5em; height: 1em; background: var(--accent); vertical-align: text-bottom; animation: blink 1.1s step-end infinite; }
		.pane .widget { display: flex; align-items: baseline; gap: .5rem; margin: .18rem 0; }
		.pane .widget .big { font-size: 1.25rem; font-weight: 700; color: var(--ink); }
		.pane .widget .lbl { color: var(--faint); font-size: .62rem; }
		.pane .clip { display: flex; gap: .45rem; color: var(--muted); padding: .12rem 0; }
		.pane .clip .n { color: var(--warm); }
		.term-status { display: flex; gap: 1.2rem; padding: .35rem .9rem; border-top: 1px solid var(--line); color: var(--faint); font-size: .62rem; background: var(--panel); }
		.term-status .st-ok { color: #4ADE80; }
		@keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }

		/* ============ 区块骨架 ============ */
		section.block { padding: 4.6rem 0; border-bottom: 1px solid var(--line); }
		.section-head { display: grid; grid-template-columns: 4.2rem 1fr; column-gap: 1.2rem; margin-bottom: 2.6rem; align-items: baseline; }
		.section-head > :not(.num) { grid-column: 2; }
		.section-head .num {
			font-family: var(--mono); font-weight: 800; font-size: .85rem; letter-spacing: .12em;
			color: var(--brand-2);
		}
		.section-head h2 { font-size: clamp(1.55rem, 3.2vw, 2.3rem); font-weight: 750; letter-spacing: -.02em; }
		.section-head .sub { color: var(--faint); font-size: .92rem; margin-top: .45rem; max-width: 62ch; }

		/* ============ 卡片:bento 网格 ============ */
		.grid-table { display: grid; grid-template-columns: repeat(auto-fit, minmax(272px, 1fr)); gap: .9rem; }
		.grid-item {
			background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
			padding: 1.45rem 1.5rem; position: relative; overflow: hidden;
			transition: transform .18s, border-color .18s, box-shadow .18s;
		}
		.grid-item:hover { transform: translateY(-3px); border-color: var(--line-2); box-shadow: 0 14px 34px rgba(0,0,0,.28), 0 0 0 1px var(--glow); }
		[data-theme="light"] .grid-item:hover { box-shadow: 0 14px 34px rgba(70,40,160,.12); }
		.grid-item .idx {
			display: inline-flex; align-items: center; justify-content: center;
			width: 1.7rem; height: 1.7rem; border-radius: 8px; margin-bottom: .8rem;
			background: linear-gradient(135deg, rgba(139,92,246,.22), rgba(34,211,238,.14));
			border: 1px solid var(--line);
			color: var(--brand-2); font-weight: 800; font-size: .72rem;
		}
		.grid-item h3 { font-size: 1rem; margin-bottom: .5rem; font-weight: 650; }
		.grid-item p { color: var(--muted); font-size: .86rem; line-height: 1.6; }

		/* 套件卡:命令即主角 */
		.suite { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: .9rem; }
		.suite-card {
			background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
			padding: 1.4rem 1.5rem; text-decoration: none; color: var(--ink); display: block;
			position: relative; overflow: hidden;
			transition: transform .18s, border-color .18s, box-shadow .18s;
		}
		.suite-card:hover { transform: translateY(-3px); border-color: var(--line-2); box-shadow: 0 14px 34px rgba(0,0,0,.28), 0 0 0 1px var(--glow); }
		[data-theme="light"] .suite-card:hover { box-shadow: 0 14px 34px rgba(70,40,160,.12); }
		.suite-card.hero-card { background: linear-gradient(150deg, rgba(139,92,246,.16), rgba(34,211,238,.05) 65%), var(--panel); border-color: var(--line-2); }
		.suite-card .cmd {
			font-family: var(--mono); font-size: .98rem; font-weight: 700; color: var(--brand-2);
		}
		.suite-card .alias { font-family: var(--mono); font-size: .72rem; color: var(--faint); margin-left: .5rem; }
		.suite-card .pkg { position: absolute; top: 1.3rem; right: 1.3rem; font-size: .64rem; letter-spacing: .06em; color: var(--faint); border: 1px solid var(--line); border-radius: 999px; padding: .18rem .6rem; }
		.suite-card p { color: var(--muted); font-size: .86rem; margin-top: .7rem; line-height: 1.6; }
		.suite-card .foot { margin-top: .9rem; font-size: .74rem; color: var(--faint); }
		.suite-card .foot b { color: var(--accent); font-weight: 600; }

		.tag-row { display: flex; flex-wrap: wrap; gap: .55rem; }
		.tag {
			font-size: .78rem; letter-spacing: .03em; padding: .42rem .9rem;
			border: 1px solid var(--line); border-radius: 999px; color: var(--muted); background: var(--panel);
			transition: transform .16s, border-color .16s, color .16s;
		}
		.tag:hover { transform: translateY(-2px); border-color: var(--line-2); color: var(--brand-2); }
		.tag.hot { border-color: rgba(139,92,246,.5); color: var(--brand-2); background: var(--panel-2); }
		.keycap { font-family: var(--mono); font-size: .75rem; border: 1px solid var(--line); border-radius: 6px; padding: .12rem .5rem; color: var(--ink); background: var(--panel-2); }

		/* ============ 运行模式 ============ */
		.modes { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: .9rem; }
		.mode { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; transition: transform .18s, border-color .18s; }
		.mode:hover { transform: translateY(-3px); border-color: var(--line-2); }
		.mode .mname { font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: .55rem; }
		.mode .mname .dot { width: .55rem; height: .55rem; border-radius: 50%; background: linear-gradient(135deg, var(--brand), var(--accent)); }
		.mode .mname .dot.alt { background: linear-gradient(135deg, var(--accent), var(--warm)); }
		.mode p { color: var(--muted); font-size: .86rem; margin-top: .6rem; line-height: 1.6; }
		.mode code { font-family: var(--mono); font-size: .8rem; color: var(--brand-2); background: var(--panel-2); padding: .08rem .4rem; border-radius: 6px; }

		/* ============ 上游来源卡 ============ */
		.sources { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: .9rem; }
		.source {
			background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
			padding: 1.5rem; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; justify-content: space-between;
			min-height: 168px; transition: transform .18s, border-color .18s, box-shadow .18s;
		}
		.source:hover { transform: translateY(-3px); border-color: var(--line-2); box-shadow: 0 14px 34px rgba(0,0,0,.28); }
		[data-theme="light"] .source:hover { box-shadow: 0 14px 34px rgba(70,40,160,.12); }
		.source .sname { font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: .5rem; }
		.source .sname .badge { font-size: .62rem; font-weight: 700; letter-spacing: .1em; padding: .18rem .55rem; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
		.source .sname .badge.main { color: var(--brand-2); border-color: rgba(139,92,246,.5); }
		.source .sname .badge.adv { color: var(--accent); border-color: rgba(34,211,238,.4); }
		.source .sdesc { color: var(--muted); font-size: .84rem; margin-top: .55rem; line-height: 1.55; }
		.source .arrow { color: var(--brand-2); font-weight: 700; transition: transform .22s ease; margin-top: .8rem; }
		.source:hover .arrow { transform: translateX(6px); }

		/* ============ 安装 ============ */
		.install { max-width: 760px; }
		.tabs { display: flex; gap: .3rem; position: relative; margin-bottom: 0; }
		.tab-ind { position: absolute; bottom: 0; left: 0; height: 2px; background: linear-gradient(90deg, var(--brand), var(--accent)); border-radius: 2px; transition: left .28s cubic-bezier(.22,.61,.36,1), width .28s cubic-bezier(.22,.61,.36,1); }
		.tab {
			background: none; border: none; border-bottom: 2px solid transparent;
			color: var(--muted); font-family: var(--font); font-size: .78rem;
			letter-spacing: .08em; padding: .55rem 1.1rem; cursor: pointer;
			transition: color .18s;
		}
		.tab.active { color: var(--brand-2); }
		.tab:not(.active):hover { color: var(--ink); }
		.code {
			background: var(--panel-solid); border: 1px solid var(--line); border-radius: var(--radius);
			padding: 1.05rem 1.3rem; font-family: var(--mono); font-size: .88rem;
			display: flex; justify-content: space-between; align-items: center; gap: 1rem;
			contain: inline-size;
		}
		.code .cmd { white-space: nowrap; overflow-x: auto; }
		.code .prompt { color: var(--brand-2); font-weight: 700; margin-right: .6rem; }
		.code .type::after { content: '▍'; margin-left: .12rem; color: var(--accent); animation: blink 1.1s step-end infinite; }
		[data-pane]:not([hidden]) { animation: paneIn .25s ease; }
		@keyframes paneIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
		.copy-btn { background: none; border: 1px solid var(--line); border-radius: 8px; color: var(--muted); font-family: var(--font); font-size: .7rem; letter-spacing: .08em; padding: .38rem .7rem; cursor: pointer; flex-shrink: 0; transition: color .18s, border-color .18s; }
		.copy-btn:hover { color: var(--brand-2); border-color: var(--line-2); }
		.copy-btn.ok { color: #4ADE80; border-color: rgba(74,222,128,.5); }
		.install-note { margin-top: 1.1rem; max-width: 68ch; color: var(--faint); font-size: .8rem; line-height: 1.8; }
		.install-note code { font-family: var(--mono); font-size: .76rem; color: var(--brand-2); background: var(--panel-2); padding: .08rem .35rem; border-radius: 6px; overflow-wrap: anywhere; }
		.install-note a { color: var(--brand-2); text-decoration: none; border-bottom: 1px solid var(--line); }
		.install-note a:hover { border-bottom-color: var(--brand-2); }

		/* ============ 截图 ============ */
		.shot-strip { overflow: hidden; width: 100%; max-width: 100%; contain: inline-size; }
		.shot-track { display: flex; gap: 0; width: max-content; animation: zeta-marquee 28s linear infinite; }
		.shot-strip:hover .shot-track { animation-play-state: paused; }
		.shot-group { display: flex; gap: 1rem; padding-right: 1rem; }
		.shot { flex: 0 0 auto; width: min(360px, 80vw); margin: 0; padding: 0; border: 1px solid var(--line-2); border-radius: 12px; overflow: hidden; background: var(--panel-solid); appearance: none; cursor: pointer; transition: border-color .15s ease, transform .15s ease; }
		.shot:hover { border-color: var(--brand); transform: translateY(-2px); }
		.shot.wide { width: min(860px, 92vw); }
		.shot img { display: block; width: 100%; height: auto; }
		.lightbox { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 5vh 5vw; background: rgba(4, 3, 10, .88); cursor: zoom-out; }
		.lightbox[hidden] { display: none; }
		.lightbox img { max-width: 100%; max-height: 100%; border-radius: 10px; box-shadow: 0 12px 48px rgba(0,0,0,.6); animation: lbIn .28s cubic-bezier(.22,.61,.36,1); }
		@keyframes lbIn { from { opacity: 0; transform: scale(.94); } to { opacity: 1; transform: none; } }
		@keyframes zeta-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

		/* ============ 入场动效 ============ */
		.zeta-progress { position: fixed; top: 0; left: 0; width: 100%; height: 2px; z-index: 1100; background: linear-gradient(90deg, var(--brand), var(--accent)); transform-origin: 0 50%; transform: scaleX(0); pointer-events: none; }
		html.js .hero .hero-copy > *, html.js .page-hero > * { opacity: 0; transform: translateY(16px); animation: rise .65s cubic-bezier(.22,.61,.36,1) both; }
		html.js .hero .hero-copy > *:nth-child(1) { animation-delay: .05s; }
		html.js .hero .hero-copy > *:nth-child(2) { animation-delay: .14s; }
		html.js .hero .hero-copy > *:nth-child(3) { animation-delay: .23s; }
		html.js .hero .hero-copy > *:nth-child(4) { animation-delay: .32s; }
		html.js .hero-copy .cta-row { animation-delay: .4s; }
		html.js .term { opacity: 0; transform: translateY(22px) scale(.985); animation: termIn .8s .25s cubic-bezier(.22,.61,.36,1) both; }
		@keyframes termIn { from { opacity: 0; transform: translateY(22px) scale(.985); } to { opacity: 1; transform: none; } }
		html.js .hero, html.js .page-hero, html.js section.block { opacity: 0; transform: translateY(18px); transition: opacity .65s ease, transform .65s ease; }
		html.js .hero.in, html.js .page-hero.in, html.js section.block.in { opacity: 1; transform: none; }
		html.js .block.in .section-head, html.js .block.in .grid-item, html.js .block.in .suite-card,
		html.js .block.in .mode, html.js .block.in .source, html.js .block.in .tag-row, html.js .block.in .install { animation: rise .55s cubic-bezier(.22,.61,.36,1) both; }
		@keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
		@media (prefers-reduced-motion: reduce) {
			html.js .hero, html.js .page-hero, html.js section.block { opacity: 1; transform: none; transition: none; }
			html.js .hero .hero-copy > *, html.js .page-hero > *, html.js .term { animation: none; opacity: 1; transform: none; }
			html.js .block.in .section-head, html.js .block.in .grid-item, html.js .block.in .suite-card,
			html.js .block.in .mode, html.js .block.in .source, html.js .block.in .tag-row, html.js .block.in .install { animation: none; }
			.shot-track { animation: none; }
			.code .type::after { animation: none; }
		}

		.page-hero { padding: 5rem 0 3.4rem; border-bottom: 1px solid var(--line); position: relative; }
		.page-hero .kicker { margin-bottom: 1.4rem; }
		.page-hero h1 { font-size: clamp(2.1rem, 5.4vw, 3.5rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.08; margin-bottom: 1.1rem; }
		.page-hero .lede { max-width: 62ch; color: var(--muted); font-size: 1.04rem; }

		footer { padding: 2.8rem 5vw; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--line); }
		footer .copy { color: var(--faint); font-size: .78rem; }
		footer .foot-links a { color: var(--faint); text-decoration: none; font-size: .78rem; margin-left: 1.2rem; }
		footer .foot-links a:hover { color: var(--brand-2); }

		html[lang="zh"] .hero h1 { letter-spacing: 0; line-height: 1.16; font-size: clamp(2.2rem, 5.2vw, 3.9rem); }
		html[lang="zh"] .page-hero h1 { letter-spacing: 0; }
		html[lang="zh"] .section-head h2 { letter-spacing: 0; }

		@media (max-width: 980px) {
			.hero-grid { grid-template-columns: 1fr; gap: 2.4rem; }
			.hero { padding: 4rem 0 3.4rem; }
		}
		@media (max-width: 720px) {
			.v2nav-inner { gap: .8rem; height: auto; flex-wrap: wrap; padding: .55rem 5vw; }
			.v2-links { order: 3; width: 100%; margin: 0; gap: .2rem; }
			.v2-links a { padding: .32rem .7rem; font-size: .78rem; }
			section.block { padding: 3.2rem 0; }
			.section-head { grid-template-columns: 1fr; gap: .4rem; margin-bottom: 1.8rem; }
			.code { flex-direction: column; align-items: flex-start; }
			.cta { flex: 1 1 calc(50% - .35rem); justify-content: center; padding: .85rem 1rem; }
			.term-menu { gap: .7rem; }
			.term-panes { grid-template-columns: 1fr; }
			.term-panes .col.hidden-sm { display: none; }
			footer { flex-direction: column; align-items: flex-start; gap: .6rem; padding: 2.2rem 5vw; }
		}
	</style>
</head>
<body>
	<div class="zeta-progress" id="zetaProgress" aria-hidden="true"></div>
	<div class="v2-bg" aria-hidden="true"></div>

	<Navbar lang={lang} active="products" />

	<div class="v2-wrap">
		<div class="v2nav-anchor">
			<div class="v2nav">
				<div class="v2nav-inner">
					<a class="v2-brand" href={base + "/"}><img src="/assets/zeta-logo.svg" alt="Zeta" /><span class="zeta-word">ZETA</span></a>
					<nav class="v2-links">
						<a href={base + "/"} class:list={{ active: active === "home" }}>{copy.navHome}</a>
						<a href={base + "/features/"} class:list={{ active: active === "features" }}>{copy.navFeatures}</a>
						<a href={base + "/ecosystem/"} class:list={{ active: active === "ecosystem" }}>{copy.navEcosystem}</a>
					</nav>
					<div class="v2-right">
						<a class="gh" href="https://github.com/Linxira-OS/linxira-zeta" target="_blank" rel="noopener" aria-label="GitHub">
							<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.545 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.92 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
						</a>
						<button class="theme-toggle" id="themeToggle" type="button">{copy.themeBtn}</button>
					</div>
				</div>
			</div>
		</div>

		<main>
			<slot />
		</main>
	</div>

	<footer>
		<span class="copy">{copy.footCopy}</span>
		<div class="foot-links">
			<a href={`/${lang}/`}>{copy.footOrg}</a>
			<a href="https://github.com/Linxira-OS/linxira-zeta" target="_blank" rel="noopener">{copy.footGitHub}</a>
		</div>
	</footer>

	<script is:inline>
		const html = document.documentElement;
		html.classList.add('js');
		const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		// 主站导航为 fixed 定位,把实际高度写入 CSS 变量,供子站粘性导航偏移
		const setNavH = () => {
			const nav = document.querySelector('.site-nav');
			if (!nav) return;
			html.style.setProperty('--zeta-nav-h', nav.getBoundingClientRect().height + 'px');
		};
		setNavH();
		window.addEventListener('resize', setNavH);
		window.addEventListener('load', setNavH);

		const zetaBar = document.getElementById('zetaProgress');
		const updateProgress = () => {
			if (!zetaBar) return;
			const max = html.scrollHeight - html.clientHeight;
			zetaBar.style.transform = 'scaleX(' + (max > 0 ? html.scrollTop / max : 0) + ')';
		};
		document.addEventListener('scroll', updateProgress, { passive: true });
		updateProgress();

		const blocks = document.querySelectorAll('.hero, .page-hero, section.block');
		if ('IntersectionObserver' in window && !prefersReduced) {
			const io = new IntersectionObserver(entries => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					const el = e.target;
					el.querySelectorAll('.section-head, .grid-item, .suite-card, .mode, .source, .tag-row, .install')
						.forEach((k, i) => (k.style.animationDelay = (i * 50) + 'ms'));
					el.classList.add('in');
					io.unobserve(el);
				}
			}, { threshold: 0.1 });
			blocks.forEach(el => io.observe(el));
		} else {
			blocks.forEach(el => el.classList.add('in'));
		}

		document.getElementById('themeToggle')?.addEventListener('click', () => {
			const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
			html.dataset.theme = next;
			localStorage.setItem('zeta-theme', next);
		});

		const tabs = document.querySelectorAll('.tab');
		const ind = document.getElementById('tabInd');
		const moveInd = tab => {
			if (!ind || !tab) return;
			ind.style.left = tab.offsetLeft + 'px';
			ind.style.width = tab.offsetWidth + 'px';
		};
		const typeInto = pane => {
			const target = pane?.querySelector('.type[data-typing]');
			if (!target) return;
			const text = target.dataset.typing;
			target.textContent = '';
			let i = 0;
			const tick = () => {
				if (i <= text.length) { target.textContent = text.slice(0, i++); setTimeout(tick, 24); }
			};
			tick();
		};
		const activate = tab => {
			tabs.forEach(t => t.classList.remove('active'));
			tab.classList.add('active');
			document.querySelectorAll('[data-pane]').forEach(p => (p.hidden = true));
			const pane = document.querySelector(`[data-pane="${tab.dataset.tab}"]`);
			pane.hidden = false;
			typeInto(pane);
			moveInd(tab);
		};
		tabs.forEach(tab => tab.addEventListener('click', () => activate(tab)));
		moveInd(tabs[0]);
		document.querySelectorAll('[data-pane]').forEach(p => { if (!p.hidden) typeInto(p); });

		document.querySelectorAll('.copy-btn').forEach(btn => {
			const orig = btn.textContent;
			let timer;
			btn.addEventListener('click', async () => {
				try { await navigator.clipboard.writeText(btn.dataset.copy); } catch {}
				btn.classList.add('ok');
				btn.textContent = btn.dataset.done;
				clearTimeout(timer);
				timer = setTimeout(() => { btn.classList.remove('ok'); btn.textContent = orig; }, 1400);
			});
		});

		const lb = document.getElementById('lightbox');
		const lbImg = document.getElementById('lightboxImg');
		if (lb && lbImg) {
			document.querySelectorAll('.shot').forEach(btn => {
				btn.addEventListener('click', () => {
					const img = btn.querySelector('img');
					if (!img) return;
					lbImg.src = img.src;
					lb.hidden = false;
				});
			});
			lb.addEventListener('click', () => { lb.hidden = true; lbImg.src = ''; });
			lbImg.addEventListener('click', e => e.stopPropagation());
		}
	</script>
</body>
</html>
