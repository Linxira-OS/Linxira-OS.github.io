---
/**
 * BioSDKLayout.astro — Linxira Bio SDK 布局骨架
 * ----------------------------------------------------------
 * 多文件结构（每个页面独立组件，避免单文件过长）：
 *   - 全局样式：components/bio-sdk/BioSDKStyles.astro
 *   - 侧边栏：components/bio-sdk/BioSDKSidebar.astro
 *   - 各页面：HomePage / DemoPage / WorkbenchPage / AIPage /
 *             StructurePage / EnvironmentPage / DocsPage / LicensesPage
 *   - 弹窗：components/bio-sdk/Modals.astro
 *   - 客户端 JS：public/bio-sdk/app.js（独立文件，非内联）
 * 语言由 URL 决定：/bio-sdk/zh/ 与 /bio-sdk/en/
 */
import Navbar from "../../components/Navbar.astro";
import BioSDKStyles from "./components/BioSDKStyles.astro";
import BioSDKSidebar from "./components/BioSDKSidebar.astro";
import BioSDKHome from "./components/HomePage.astro";
import BioSDKDemo from "./components/DemoPage.astro";
import BioSDKWorkbench from "./components/WorkbenchPage.astro";
import BioSDKAI from "./components/AIPage.astro";
import BioSDKStructure from "./components/StructurePage.astro";
import BioSDKEnv from "./components/EnvironmentPage.astro";
import BioSDKDocs from "./components/DocsPage.astro";
import BioSDKLicenses from "./components/LicensesPage.astro";
import BioSDKModals from "./components/Modals.astro";
import { bioSdk } from "../../data/bio-sdk";
import "../../styles/linxira-theme.css";

interface Props {
	lang: "zh" | "en";
}
const { lang } = Astro.props;
const zh = lang === 'zh';
const pageTitle = zh
  ? 'Linxira Bio SDK — 本地优先生物信息学分析平台'
  : 'Linxira Bio SDK — Local-first bioinformatics platform';
const pageDescription = zh
  ? '本地优先生物信息学分析平台：数据、工具链与流程全部在本地运行，支持 Python / R / Java 托管运行时。'
  : 'A local-first bioinformatics workbench: data, toolchains and pipelines all run on-device, with managed Python / R / Java runtimes.';
const base = `/bio-sdk/${lang}`;
const otherLang = zh ? "en" : "zh";
const langHref = Astro.url.pathname.replace(/^\/((?:zeta|bio-sdk)\/)?(?:zh|en)(\/|$)/, `/$1${otherLang}$2`);
---

<!DOCTYPE html>
<html lang={zh ? "zh-CN" : "en-US"}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{pageTitle}</title>
<meta name="description" content={pageDescription}>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='2' y='2' width='8' height='30' rx='2' fill='%2320B8B0'/><rect x='2' y='24' width='26' height='8' rx='2' fill='%2320B8B0'/><rect x='22' y='2' width='8' height='8' rx='2' fill='%23F36F5D'/></svg>">
<script is:inline>
	window.BIOSDK_LANG = location.pathname.startsWith('/bio-sdk/zh') ? 'zh' : 'en';
	/* 与主站共用主题：html[data-theme] 驱动 token，body 的 light/dark 类同步给它自己的样式 */
	(function () {
		var saved = null;
		try { saved = localStorage.getItem('linxira-theme'); } catch (e) {}
		var theme = saved === 'light' ? 'light' : 'dark';
		document.documentElement.dataset.theme = theme;
		document.addEventListener('DOMContentLoaded', function () {
			document.body.classList.remove('light', 'dark');
			document.body.classList.add(theme);
		});
	})();
</script>
<BioSDKStyles />
</head>
<body class="dark">
<Navbar lang={lang} active="products" themeToggle />

<BioSDKSidebar zh={zh} />

<!-- ===== Main Content ===== -->
<main class="main">
  <div class="topbar">
    <span class="topbar-title">Linxira Bio SDK</span>
    <div class="topbar-right">
      <span class="badge badge-ready">AGPL-3.0</span>
      <span class="badge badge-version">v{bioSdk.version}</span>
      <a class="badge badge-version" href="https://github.com/Linxira-OS/linxira-bio-sdk" target="_blank" style="text-decoration:none">GitHub</a>
    </div>
  </div>

  <div class="content">
    <BioSDKHome zh={zh} lang={lang} />
    <BioSDKDemo zh={zh} />
    <BioSDKWorkbench zh={zh} />
    <BioSDKAI zh={zh} />
    <BioSDKStructure zh={zh} />
    <BioSDKEnv zh={zh} />
    <BioSDKDocs zh={zh} />
    <BioSDKLicenses zh={zh} />

    <!-- Footer -->
    <div class="footer">
      <p>Linxira Bio SDK &copy; 2026 Linxira-OS. Licensed under AGPL-3.0-or-later.</p>
      <p style="margin-top:0.5rem">
        <a href="https://github.com/Linxira-OS/linxira-bio-sdk">GitHub</a> ·
        <a href="https://github.com/Linxira-OS/linxira-bio-sdk/wiki">Wiki</a> ·
        <a href={`/${lang}/`}>Linxira-OS</a>
      </p>
    </div>
  </div>
</main>

<BioSDKModals />

<script is:inline src="/bio-sdk/app.js"></script>
</body>
</html>
