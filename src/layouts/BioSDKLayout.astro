---
/**
 * BioSDKLayout.astro — Linxira Bio SDK 布局骨架
 * ----------------------------------------------------------
 * 多文件结构（每个页面独立组件，避免单文件过长）：
 *   - 全局样式：components/bio-sdk/BioSDKStyles.astro
 *   - 侧边栏：components/bio-sdk/BioSDKSidebar.astro
 *   - 各页面：HomePage / DemoPage / WorkbenchPage / AIPage /
 *             StructurePage / EnvironmentPage / DocsPage / LicensesPage
 *   - 弹窗：components/bio-sdk/Modals.astro
 *   - 客户端 JS：public/bio-sdk/app.js（独立文件，非内联）
 * 语言由 URL 决定：/bio-sdk/zh/ 与 /bio-sdk/en/
 */
import Navbar from "../components/Navbar.astro";
import BioSDKStyles from "../components/bio-sdk/BioSDKStyles.astro";
import BioSDKSidebar from "../components/bio-sdk/BioSDKSidebar.astro";
import BioSDKHome from "../components/bio-sdk/HomePage.astro";
import BioSDKDemo from "../components/bio-sdk/DemoPage.astro";
import BioSDKWorkbench from "../components/bio-sdk/WorkbenchPage.astro";
import BioSDKAI from "../components/bio-sdk/AIPage.astro";
import BioSDKStructure from "../components/bio-sdk/StructurePage.astro";
import BioSDKEnv from "../components/bio-sdk/EnvironmentPage.astro";
import BioSDKDocs from "../components/bio-sdk/DocsPage.astro";
import BioSDKLicenses from "../components/bio-sdk/LicensesPage.astro";
import BioSDKModals from "../components/bio-sdk/Modals.astro";

interface Props {
	lang: "zh" | "en";
}
const { lang } = Astro.props;
const zh = lang === "zh";
const base = `/bio-sdk/${lang}`;
const otherLang = zh ? "en" : "zh";
const langHref = Astro.url.pathname.replace(/^\/((?:zeta|bio-sdk)\/)?(?:zh|en)(\/|$)/, `/$1${otherLang}$2`);
---

<!DOCTYPE html>
<html lang={zh ? "zh-CN" : "en-US"}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Linxira Bio SDK — 本地优先生物信息学分析平台</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><path fill='%2320B8B0' d='M4 0h12v24h20v8H4z'/><path d='M8 8v24h20' fill='none' stroke='%230E1417' stroke-width='2'/><path d='M6 12h4M6 18h2M6 24h4' fill='none' stroke='%23E8F7F6' stroke-width='2'/></svg>">
<script is:inline>
	window.BIOSDK_LANG = location.pathname.startsWith('/bio-sdk/zh') ? 'zh' : 'en';
</script>
<BioSDKStyles />
</head>
<body class="dark">
<Navbar lang={lang} active="products" themeToggle />

<BioSDKSidebar zh={zh} />

<!-- ===== Main Content ===== -->
<main class="main">
  <div class="topbar">
    <span class="topbar-title">Linxira Bio SDK</span>
    <div class="topbar-right">
      <span class="badge badge-ready">AGPL-3.0</span>
      <span class="badge badge-version">v0.1.0</span>
      <a class="badge badge-version" href="https://github.com/Linxira-OS/linxira-bio-sdk" target="_blank" style="text-decoration:none">GitHub</a>
    </div>
  </div>

  <div class="content">
    <BioSDKHome zh={zh} lang={lang} />
    <BioSDKDemo zh={zh} />
    <BioSDKWorkbench zh={zh} />
    <BioSDKAI zh={zh} />
    <BioSDKStructure zh={zh} />
    <BioSDKEnv zh={zh} />
    <BioSDKDocs zh={zh} />
    <BioSDKLicenses zh={zh} />

    <!-- Footer -->
    <div class="footer">
      <p>Linxira Bio SDK &copy; 2026 Linxira-OS. Licensed under AGPL-3.0-or-later.</p>
      <p style="margin-top:0.5rem">
        <a href="https://github.com/Linxira-OS/linxira-bio-sdk">GitHub</a> ·
        <a href="https://github.com/Linxira-OS/linxira-bio-sdk/wiki">Wiki</a> ·
        <a href={`/${lang}/`}>Linxira-OS</a>
      </p>
    </div>
  </div>
</main>

<BioSDKModals />

<script is:inline src="/bio-sdk/app.js"></script>
</body>
</html>
