---
import Navbar from "../components/Navbar.astro";
interface Props {
	lang: "zh" | "en";
	title: string;
	description: string;
	active: "home" | "features" | "ecosystem";
}
const { lang, title, description, active } = Astro.props;
const zh = lang === "zh";
const copy = zh
	? {
			navHome: "首页", navFeatures: "特性", navEcosystem: "生态",
			themeBtn: "深浅切换",
			footOrg: "Linxira OS", footGitHub: "GitHub",
			footCopy: "© 2026 Zeta · Linxira-OS",
	  }
	: {
			navHome: "Home", navFeatures: "Features", navEcosystem: "Ecosystem",
			themeBtn: "Theme",
			footOrg: "Linxira OS", footGitHub: "GitHub",
			footCopy: "© 2026 Zeta · Linxira-OS",
	  };
const base = zh ? "/zeta/zh" : "/zeta/en";
// 与主站 Navbar 一致的中英切换：保留当前 zeta 子页面路径
const otherLang = zh ? "en" : "zh";
const langHref = Astro.url.pathname.replace(/^\/((?:zeta|bio-sdk)\/)?(?:zh|en)(\/|$)/, `/$1${otherLang}$2`);
---
<!DOCTYPE html>
<html lang={lang} data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description}>
	<meta property="og:site_name" content="Zeta">
	<meta property="og:type" content="website">
	<meta property="og:title" content={title}>
	<meta property="og:description" content={description}>
	<meta property="og:url" content={"https://linxira-os.github.io/zeta/" + lang + "/"}>
	<meta name="theme-color" content="#0E1417" media="(prefers-color-scheme: dark)">
	<meta name="theme-color" content="#E8F7F6" media="(prefers-color-scheme: light)">
	<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2320B8B0'/%3E%3Ctext x='16' y='24' font-family='Helvetica,Arial,sans-serif' font-size='22' font-weight='700' fill='%230E1417' text-anchor='middle'%3EZ%3C/text%3E%3C/svg%3E">
	<script is:inline>
		const saved = localStorage.getItem('zeta-theme');
		const prefers = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
		document.documentElement.dataset.theme = saved ?? prefers;
		document.documentElement.classList.add('js');
	</script>
	<style is:global>
		:root {
			--teal: #20B8B0;
			--coral: #F36F5D;
			--bg: #0E1417;
			--ink: #E8F7F6;
			--muted: #94a3b8;
			--faint: #64748b;
			--line: rgba(51, 65, 85, 0.5);
			--panel: rgba(30, 41, 59, 0.6);
			--panel-solid: #131b2e;
			--font: "Helvetica Neue", Helvetica, "Inter", "Noto Sans", system-ui,
				"PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
			--mono: "SF Mono", "Cascadia Mono", "JetBrains Mono", ui-monospace, monospace;
		}
		[data-theme="light"] {
			--bg: #E8F7F6;
			--ink: #0E1417;
			--muted: #475569;
			--faint: #64748b;
			--line: rgba(14, 20, 23, 0.18);
			--panel: rgba(255, 255, 255, 0.7);
			--panel-solid: #ffffff;
		}
		* { margin: 0; padding: 0; box-sizing: border-box; }
		html { scroll-behavior: smooth; }
		body {
			font-family: var(--font);
			background: var(--bg);
			color: var(--ink);
			line-height: 1.5;
			font-size: 16px;
			transition: background .2s, color .2s;
		}
		::selection { background: var(--teal); color: var(--bg); }

		.gridlines {
			position: fixed; inset: 0; pointer-events: none; z-index: 0;
			background-image:
				linear-gradient(var(--line) 1px, transparent 1px),
				linear-gradient(90deg, var(--line) 1px, transparent 1px);
			background-size: 60px 60px; opacity: .35;
		}
		.container { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 5vw; }

		/* 子页面导航：banner 改造为右侧工具栏（桌面为右侧栏，窄屏还原为顶部横条） */
		.zeta-body {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 13rem;
			gap: 2.5rem;
			align-items: start;
			max-width: 1360px;
			margin: 0 auto;
			padding: 0 5vw;
		}
		.zeta-body .container { max-width: none; padding: 0; min-width: 0; }

		.zeta-rail {
			position: sticky; top: calc(var(--zeta-nav-h, 4.5rem) + 1rem); z-index: 10;
			display: flex; flex-direction: column; gap: .2rem;
			padding: 1.1rem 1rem;
			border: 1px solid var(--line);
			background: var(--panel);
			backdrop-filter: blur(12px);
		}
		.zeta-brand {
			display: inline-flex; align-items: center; gap: .5rem;
			font-weight: 800; letter-spacing: .08em; text-decoration: none; color: var(--ink);
		}
		.zeta-brand .zmark {
			display: inline-flex; width: 1.6rem; height: 1.6rem; align-items: center; justify-content: center;
			background: var(--teal); color: var(--bg); font-size: 1rem; font-weight: 800;
		}
		.zeta-rail .zeta-brand { padding-bottom: .9rem; margin-bottom: .7rem; border-bottom: 1px solid var(--line); }
		.zeta-rail .zeta-links { display: flex; flex-direction: column; gap: .1rem; }
		.zeta-rail .zeta-links a {
			color: var(--muted); text-decoration: none; font-size: .78rem;
			letter-spacing: .08em; text-transform: uppercase;
			padding: .5rem .55rem; border-left: 2px solid transparent;
			transition: color .15s, border-color .15s, background .15s;
		}
		.zeta-rail .zeta-links a:hover { color: var(--teal); background: var(--panel-solid); border-left-color: var(--teal); }
		.zeta-rail .zeta-links a.active { color: var(--teal); border-left-color: var(--teal); }
		.zeta-rail .zeta-actions {
			display: flex; flex-direction: column; gap: .5rem;
			margin-top: .9rem; padding-top: .9rem; border-top: 1px solid var(--line);
		}
		.theme-toggle, .zeta-rail .lang-toggle {
			background: none; border: 1px solid var(--line); color: var(--ink);
			font-family: var(--font); font-size: .75rem; padding: .4rem .8rem;
			cursor: pointer; letter-spacing: .1em; text-transform: uppercase; text-decoration: none;
		}
		.theme-toggle:hover, .zeta-rail .lang-toggle:hover { border-color: var(--teal); color: var(--teal); }
		.zeta-rail .theme-toggle, .zeta-rail .lang-toggle { width: 100%; text-align: center; }

		.hero { padding: 6.5rem 0 4rem; border-bottom: 1px solid var(--line); position: relative; overflow: hidden; }
		.hero::before {
			content: ''; position: absolute; top: -45%; left: -15%; width: 65vw; height: 65vw;
			background: radial-gradient(circle, rgba(32,184,176,0.10) 0%, transparent 70%); pointer-events: none;
			animation: breathe 9s ease-in-out infinite alternate;
		}
		.hero::after {
			content: ''; position: absolute; bottom: -35%; right: -12%; width: 55vw; height: 55vw;
			background: radial-gradient(circle, rgba(243,111,93,0.08) 0%, transparent 70%); pointer-events: none;
			animation: breathe 11s ease-in-out infinite alternate-reverse;
		}
		@keyframes breathe {
			0% { opacity: .6; transform: scale(1); }
			100% { opacity: 1; transform: scale(1.08); }
		}
		.hero-inner { position: relative; z-index: 1; }
		.kicker {
			display: inline-flex; align-items: center; gap: .6rem;
			color: var(--teal); font-weight: 700; letter-spacing: .24em;
			font-size: .72rem; text-transform: uppercase; margin-bottom: 2rem;
		}
		.kicker::before { content: ''; width: 2.4rem; height: 2px; background: var(--teal); }
		.hero h1 {
			font-size: clamp(2.8rem, 8vw, 6rem);
			font-weight: 800; letter-spacing: -.03em; line-height: 1.02;
			margin-bottom: 2rem; max-width: 18ch;
		}
		.hero h1 .accent {
			background: linear-gradient(120deg, var(--teal), var(--coral));
			-webkit-background-clip: text; background-clip: text; color: transparent;
		}
		.hero .lede { max-width: 58ch; font-size: clamp(1.05rem, 1.8vw, 1.22rem); color: var(--muted); margin-bottom: 2.6rem; font-weight: 300; }
		.hero .lede strong { color: var(--ink); font-weight: 600; }

		.cta-row { display: flex; gap: 1rem; flex-wrap: wrap; }
		.cta {
			display: inline-block; padding: 1rem 2.2rem; text-decoration: none;
			font-weight: 600; font-size: .95rem; letter-spacing: .04em;
			border: 1px solid var(--line); color: var(--ink);
			transition: background .15s, color .15s, border-color .15s;
		}
		.cta.primary { background: linear-gradient(120deg, var(--teal), var(--coral)); border-color: transparent; color: #fff; }
		.cta.primary:hover { filter: brightness(1.08); }
		.cta.ghost:hover { border-color: var(--teal); color: var(--teal); }

		section.block { padding: 5.5rem 0; border-bottom: 1px solid var(--line); }
		.section-head { display: grid; grid-template-columns: 5rem 1fr; gap: 1.5rem; margin-bottom: 3.2rem; align-items: baseline; }
		.section-head .num { color: var(--coral); font-weight: 800; font-size: .95rem; letter-spacing: .1em; }
		.section-head h2 { font-size: clamp(1.7rem, 3.5vw, 2.6rem); font-weight: 700; letter-spacing: -.02em; }
		.section-head .sub { color: var(--faint); font-size: .92rem; margin-top: .4rem; max-width: 60ch; }

		.grid-table { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
		.grid-item { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.6rem; transition: background .15s; }
		.grid-item:hover { background: var(--panel); }
		.grid-item .idx { color: var(--teal); font-weight: 700; font-size: .72rem; letter-spacing: .18em; }
		.grid-item h3 { font-size: 1.02rem; margin: .8rem 0 .5rem; font-weight: 600; display: flex; align-items: center; gap: .45rem; }
		.grid-item h3 .k { color: var(--coral); font-weight: 800; }
		.grid-item p { color: var(--muted); font-size: .87rem; line-height: 1.55; }

		.tag-row { display: flex; flex-wrap: wrap; gap: .5rem; }
		.tag {
			font-size: .75rem; letter-spacing: .04em; padding: .4rem .8rem;
			border: 1px solid var(--line); color: var(--muted); background: var(--panel);
		}
		.tag.hot { border-color: var(--teal); color: var(--teal); }
		.keycap { font-family: var(--mono); font-size: .75rem; border: 1px solid var(--line); padding: .15rem .5rem; color: var(--ink); background: var(--panel); }

		.modes { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
		.mode { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.7rem; }
		.mode .mname { font-weight: 700; font-size: 1.05rem; display: flex; align-items: center; gap: .5rem; }
		.mode .mname .dot { width: .55rem; height: .55rem; background: var(--teal); display: inline-block; flex-shrink: 0; }
		.mode .mname .dot.alt { background: var(--coral); }
		.mode p { color: var(--muted); font-size: .86rem; margin-top: .6rem; line-height: 1.55; }
		.mode code { font-family: var(--mono); font-size: .8rem; color: var(--teal); background: var(--panel); padding: .1rem .35rem; }

		.sources { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
		.source { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.7rem; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; justify-content: space-between; min-height: 170px; transition: background .15s; }
		.source:hover { background: var(--panel); }
		.source .sname { font-weight: 700; font-size: 1.02rem; display: flex; align-items: center; gap: .5rem; }
		.source .sname .badge { font-size: .62rem; font-weight: 700; letter-spacing: .12em; padding: .2rem .5rem; border: 1px solid var(--line); }
		.source .sname .badge.main { color: var(--teal); border-color: var(--teal); }
		.source .sname .badge.adv { color: var(--coral); border-color: var(--coral); }
		.source .sdesc { color: var(--muted); font-size: .84rem; margin-top: .5rem; line-height: 1.5; }
		.source .arrow { color: var(--coral); font-size: 1.3rem; font-weight: 700; transition: transform .25s ease; }
		.source:hover .arrow { transform: translateX(6px); }

		html.js .hero, html.js .page-hero, html.js section.block {
			opacity: 0; transform: translateY(20px);
			transition: opacity .7s ease, transform .7s ease;
		}
		html.js .hero.in, html.js .page-hero.in, html.js section.block.in { opacity: 1; transform: none; }
		@keyframes rise {
			from { opacity: 0; transform: translateY(16px); }
			to { opacity: 1; transform: none; }
		}
		html.js .block.in .section-head,
		html.js .block.in .tag-row,
		html.js .block.in .grid-item,
		html.js .block.in .mode,
		html.js .block.in .source {
			animation: rise .55s cubic-bezier(.22,.61,.36,1) both;
		}
		@media (prefers-reduced-motion: reduce) {
			html.js .hero, html.js .page-hero, html.js section.block { opacity: 1; transform: none; transition: none; }
			html.js .block.in .section-head, html.js .block.in .tag-row,
			html.js .block.in .grid-item, html.js .block.in .mode, html.js .block.in .source { animation: none; }
			.hero::before, .hero::after { animation: none; }
			.code .type::after { animation: none; }
			.tab-ind { transition: none; }
		}

		.page-hero { padding: 5rem 0 3.5rem; border-bottom: 1px solid var(--line); position: relative; overflow: hidden; }
		.page-hero::before {
			content: ''; position: absolute; top: -80%; left: 25%; width: 70vw; height: 70vw;
			background: radial-gradient(circle, rgba(32,184,176,0.08) 0%, transparent 70%); pointer-events: none;
		}
		.page-hero > * { position: relative; z-index: 1; }
		.page-hero .kicker { margin-bottom: 1.5rem; }
		.page-hero h1 { font-size: clamp(2.2rem, 6vw, 4rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.05; margin-bottom: 1.2rem; }
		.page-hero .lede { max-width: 60ch; color: var(--muted); font-size: 1.05rem; font-weight: 300; }

		.install { margin-top: 3rem; max-width: 720px; }
		.tabs { display: flex; gap: .25rem; border-bottom: 1px solid var(--line); margin-bottom: 0; position: relative; }
		.tab-ind {
			position: absolute; bottom: -1px; left: 0; height: 2px;
			background: linear-gradient(90deg, var(--teal), var(--coral));
			transition: left .28s cubic-bezier(.22,.61,.36,1), width .28s cubic-bezier(.22,.61,.36,1);
		}
		.tab {
			background: none; border: 1px solid var(--line); border-bottom: none;
			color: var(--muted); font-family: var(--font); font-size: .75rem;
			letter-spacing: .1em; text-transform: uppercase; padding: .6rem 1.2rem;
			cursor: pointer; margin-bottom: -1px;
			transition: color .2s, background .2s, border-color .2s;
		}
		.tab.active { background: var(--panel-solid); color: var(--teal); border-color: var(--line); }
		.tab:not(.active):hover { color: var(--ink); }
		.code {
			background: var(--panel-solid); border: 1px solid var(--line); border-top: none;
			padding: 1.1rem 1.4rem; font-family: var(--mono); font-size: .88rem;
			display: flex; justify-content: space-between; align-items: center; gap: 1rem;
		}
		.code .cmd { white-space: nowrap; overflow-x: auto; }
		.code .prompt { color: var(--teal); font-weight: 700; margin-right: .6rem; }
		.code .type::after { content: '▍'; margin-left: .15rem; color: var(--teal); animation: blink 1.1s step-end infinite; }
		@keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
		[data-pane]:not([hidden]) { animation: paneIn .25s ease; }
		@keyframes paneIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
		.copy-btn { background: none; border: 1px solid var(--line); color: var(--muted); font-family: var(--font); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; padding: .4rem .7rem; cursor: pointer; flex-shrink: 0; transition: color .2s, border-color .2s; }
		.copy-btn:hover { color: var(--teal); border-color: var(--teal); }
		.copy-btn.ok { color: var(--teal); border-color: var(--teal); }
		.install-note { margin-top: 1.1rem; max-width: 66ch; color: var(--faint); font-size: .8rem; line-height: 1.8; }
		.install-note code { font-family: var(--mono); font-size: .76rem; color: var(--teal); background: var(--panel); padding: .1rem .35rem; }
		.install-note a { color: var(--teal); text-decoration: none; border-bottom: 1px solid var(--line); }
		.install-note a:hover { border-bottom-color: var(--teal); }

		footer { padding: 3rem 5vw; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
		footer .copy { color: var(--faint); font-size: .78rem; }
		footer .foot-links a { color: var(--faint); text-decoration: none; font-size: .78rem; margin-left: 1.2rem; }
		footer .foot-links a:hover { color: var(--teal); }

		html[lang="zh"] .hero h1 { letter-spacing: 0; line-height: 1.12; }
		html[lang="zh"] .hero .lede { font-weight: 400; }
		html[lang="zh"] .page-hero h1 { letter-spacing: 0; }
		html[lang="zh"] .section-head h2 { letter-spacing: 0; }

		@media (max-width: 1023px) {
			.zeta-body { display: flex; flex-direction: column-reverse; gap: 0; max-width: none; padding: var(--zeta-nav-h, 4.5rem) 0 0; }
			.zeta-body .container { max-width: 1200px; margin: 0 auto; padding: 0 5vw; }
			.zeta-rail {
				position: sticky; top: var(--zeta-nav-h, 4.5rem); z-index: 20;
				flex-direction: row; align-items: center; justify-content: space-between;
				gap: 1rem; padding: .7rem 5vw;
				border: none; border-bottom: 1px solid var(--line);
				background: color-mix(in srgb, var(--bg) 90%, transparent);
			}
			.zeta-rail .zeta-brand { padding: 0; margin: 0; border: none; }
			.zeta-rail .zeta-links { flex-direction: row; gap: 1rem; }
			.zeta-rail .zeta-links a { padding: 0; border-left: none; }
			.zeta-rail .zeta-links a:hover { background: none; }
			.zeta-rail .zeta-links a.active { border-left: none; border-bottom: 2px solid var(--teal); padding-bottom: .2rem; }
			.zeta-rail .zeta-actions { flex-direction: row; margin: 0; padding: 0; border: none; }
			.zeta-rail .theme-toggle, .zeta-rail .lang-toggle { width: auto; }
		}

		@media (max-width: 720px) {
			.zeta-rail { flex-wrap: wrap; gap: .6rem; }
			.zeta-rail .zeta-links { gap: 1rem; flex-wrap: wrap; }
			.zeta-rail .zeta-links a { font-size: .7rem; }
			.hero { padding-top: 4.5rem; }
			.section-head { grid-template-columns: 1fr; gap: .4rem; }
			.code { flex-direction: column; align-items: flex-start; }
			.tab { padding: .5rem .8rem; font-size: .68rem; }
		}
	</style>
</head>
<body>
	<div class="gridlines" aria-hidden="true"></div>

	<Navbar lang={lang} active="products" />

	<div class="zeta-body">
		<main class="container">
			<slot />
		</main>
		<aside class="zeta-rail" aria-label="Zeta 子页面导航">
			<a class="zeta-brand" href={base + "/"}><span class="zmark">Z</span><span class="zeta-word">ZETA</span></a>
			<nav class="zeta-links">
				<a href={base + "/"} class:list={{ active: active === "home" }}>{copy.navHome}</a>
				<a href={base + "/features/"} class:list={{ active: active === "features" }}>{copy.navFeatures}</a>
				<a href={base + "/ecosystem/"} class:list={{ active: active === "ecosystem" }}>{copy.navEcosystem}</a>
			</nav>
			<div class="zeta-actions">
				<button class="theme-toggle" id="themeToggle" type="button">{copy.themeBtn}</button>
				<a class="lang-toggle" href={langHref}>{zh ? "EN" : "中文"}</a>
			</div>
		</aside>
	</div>

	<footer>
		<span class="copy">{copy.footCopy}</span>
		<div class="foot-links">
			<a href={`/${lang}/`}>{copy.footOrg}</a>
			<a href="https://github.com/Linxira-OS/linxira-zeta" target="_blank" rel="noopener">{copy.footGitHub}</a>
		</div>
	</footer>

	<script is:inline>
		const html = document.documentElement;
		html.classList.add('js');
		const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		// 主站导航为 fixed 定位，把实际高度写入 CSS 变量，供右侧工具栏/横条偏移
		const setNavH = () => {
			const nav = document.querySelector('.site-nav');
			if (!nav) return;
			html.style.setProperty('--zeta-nav-h', nav.getBoundingClientRect().height + 'px');
		};
		setNavH();
		window.addEventListener('resize', setNavH);
		window.addEventListener('load', setNavH);

		// reveal on scroll
		const blocks = document.querySelectorAll('.hero, .page-hero, section.block');
		if ('IntersectionObserver' in window && !prefersReduced) {
			const io = new IntersectionObserver(entries => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					const el = e.target;
					el.querySelectorAll('.section-head, .tag-row, .grid-item, .mode, .source')
						.forEach((k, i) => (k.style.animationDelay = (i * 55) + 'ms'));
					el.classList.add('in');
					io.unobserve(el);
				}
			}, { threshold: 0.12 });
			blocks.forEach(el => io.observe(el));
		} else {
			blocks.forEach(el => el.classList.add('in'));
		}

		// theme toggle
		document.getElementById('themeToggle')?.addEventListener('click', () => {
			const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
			html.dataset.theme = next;
			localStorage.setItem('zeta-theme', next);
		});

		// install tabs
		const tabs = document.querySelectorAll('.tab');
		const ind = document.getElementById('tabInd');
		const moveInd = tab => {
			if (!ind || !tab) return;
			ind.style.left = tab.offsetLeft + 'px';
			ind.style.width = tab.offsetWidth + 'px';
		};
		const activate = tab => {
			tabs.forEach(t => t.classList.remove('active'));
			tab.classList.add('active');
			document.querySelectorAll('[data-pane]').forEach(p => (p.hidden = true));
			const pane = document.querySelector(`[data-pane="${tab.dataset.tab}"]`);
			pane.hidden = false;
			typeInto(pane);
			moveInd(tab);
		};
		tabs.forEach(tab => tab.addEventListener('click', () => activate(tab)));
		moveInd(tabs[0]);

		// typewriter
		const typeInto = pane => {
			const target = pane?.querySelector('.type[data-typing]');
			if (!target) return;
			const text = target.dataset.typing;
			target.textContent = '';
			let i = 0;
			const tick = () => {
				if (i <= text.length) { target.textContent = text.slice(0, i++); setTimeout(tick, 26); }
			};
			tick();
		};
		document.querySelectorAll('[data-pane]').forEach(p => { if (!p.hidden) typeInto(p); });

		// copy buttons
		document.querySelectorAll('.copy-btn').forEach(btn => {
			const orig = btn.textContent;
			let timer;
			btn.addEventListener('click', async () => {
				try { await navigator.clipboard.writeText(btn.dataset.copy); } catch {}
				btn.classList.add('ok');
				btn.textContent = btn.dataset.done;
				clearTimeout(timer);
				timer = setTimeout(() => { btn.classList.remove('ok'); btn.textContent = orig; }, 1400);
			});
		});
	</script>
</body>
</html>
